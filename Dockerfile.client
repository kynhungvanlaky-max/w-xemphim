# Dockerfile for CinemaFlow Blazor Web Client (.NET 10)
# Build Context: Root directory of repository

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Step 1: Restore dependencies with layer caching
COPY ["src/Shared/WebXemPhim.Shared/WebXemPhim.Shared.csproj", "src/Shared/WebXemPhim.Shared/"]
COPY ["src/Client/WebXemPhim.Client/WebXemPhim.Client.csproj", "src/Client/WebXemPhim.Client/"]
RUN dotnet restore "src/Client/WebXemPhim.Client/WebXemPhim.Client.csproj"

# Step 2: Build and publish Client in Release mode
COPY src/Shared/ src/Shared/
COPY src/Client/WebXemPhim.Client/ src/Client/WebXemPhim.Client/

WORKDIR "/src/src/Client/WebXemPhim.Client"
RUN dotnet publish "WebXemPhim.Client.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Step 3: Runtime image
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /app/keys
COPY --from=build /app/publish .

ENV ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_ENVIRONMENT=Production \
    DOTNET_RUNNING_IN_CONTAINER=true \
    Security__DataProtectionKeyPath=/app/keys \
    Security__BehindReverseProxy=true \
    Security__KnownProxyNetworks__0=10.0.0.0/8 \
    Security__KnownProxyNetworks__1=172.16.0.0/12 \
    Security__KnownProxyNetworks__2=192.168.0.0/16 \
    Security__KnownProxyNetworks__3=127.0.0.0/8 \
    AllowedHosts=w-phim-client.onrender.com;localhost;127.0.0.1;[::1] \
    ApiBaseUrl=https://w-phim-api.onrender.com \
    PORT=10000

EXPOSE 10000

ENTRYPOINT ["sh", "-c", "exec dotnet WebXemPhim.Client.dll --urls http://0.0.0.0:${PORT}"]
