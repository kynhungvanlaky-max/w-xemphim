# ==============================================================================
# WebXemPhim - Production Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env or inject these variables into your production environment
# (Docker Compose, Kubernetes Secrets, Azure App Service, Systemd, etc.).
#
# IMPORTANT SECURITY REQUIREMENTS:
# 1. All secrets MUST be random, strong, and at least 32 characters in length.
# 2. Never commit actual secret values or .env files containing production secrets to git.
# 3. In Production, startup validation will fail if any required secret is missing,
#    shorter than 32 characters, or equal to development placeholder keys.
#
# ROTATING KEYS (also required after the "appsettings.Development.json" values were
# committed by mistake in an earlier revision of this repository):
#   Generate a new random value, e.g.
#     pwsh -c "[Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))"
#   then update the matching environment variable and restart the API. PayOS/VNPay
#   dashboards must be updated with the same value, otherwise live webhooks stop working.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Production PostgreSQL connection string.
# Equivalent ASP.NET Core key: ConnectionStrings__Default
DATABASE_CONNECTION_STRING="Host=prod-db.example.internal;Port=5432;Database=cinemaflow;Username=cinemaflow_user;Password=ChangeThisToStrongSecurePassword_2026!;SSL Mode=Require"

# Database engine. Supported values: PostgreSql (default), MySql.
# Equivalent ASP.NET Core key: Database__Provider
DB_PROVIDER=PostgreSql

# ------------------------------------------------------------------------------
# 2. Media Stream URL Signing (HMAC-SHA256)
# ------------------------------------------------------------------------------
# Secret key used to generate tamper-proof time-limited and IP-bound stream URLs.
# MUST be at least 32 characters long.
# Equivalent ASP.NET Core key: Security__StreamSigningKey
STREAM_SIGNING_KEY="ReplaceWithStrongRandomSecretKeyOfAtLeast32BytesLength_2026!"

# Optional Stream TTL in minutes (default: 30)
# Security__StreamTtlMinutes=30

# Public base URL of the API, used to build the signed playback URL that the BROWSER opens.
# Inside a container network the request host is the internal service name (server:8080),
# which a browser cannot resolve — the player would then fail to load the video.
# Set this to the address the visitor's browser uses, e.g. https://api.cinemaflow.vn
# Equivalent ASP.NET Core key: Security__PublicApiBaseUrl
# PUBLIC_API_BASE_URL="https://api.cinemaflow.vn"

# ------------------------------------------------------------------------------
# 3. Payment Webhook Verification (HMAC-SHA512)
# ------------------------------------------------------------------------------
# Master secret key for verifying inbound payment webhook payloads.
# MUST be at least 32 characters long.
# Equivalent ASP.NET Core key: Payment__WebhookSecret
PAYMENT_WEBHOOK_SECRET="ReplaceWithStrongRandomWebhookSecretOfAtLeast32Bytes_2026!"

# Gateway-specific webhook secrets (optional if using master webhook secret,
# but required if gateway-specific verification is enabled):
#
# PayOS webhook signature verification secret
# Equivalent ASP.NET Core key: Payment__Gateways__PayOS__WebhookSecret
PAYOS_WEBHOOK_SECRET="ReplaceWithStrongPayOSWebhookSecretAtLeast32Chars_2026!"

# VNPay hash secret for return URL & IPN validation
# Equivalent ASP.NET Core key: Payment__Gateways__VNPay__HashSecret
VNPAY_HASH_SECRET="ReplaceWithStrongVNPayHashSecretAtLeast32Chars_2026!"

# ------------------------------------------------------------------------------
# 4. Host Security & Data Protection (Production Guardrails)
# ------------------------------------------------------------------------------
# Allowed Hosts allowlist (semicolon-separated). Wildcard '*' is strictly forbidden in Production.
# AllowedHosts="cinemaflow.vn;api.cinemaflow.vn"

# Data Protection keys absolute directory path (MUST NOT be inside wwwroot or web root).
# Security__DataProtectionKeyPath="/var/cinemaflow/dataprotection-keys"

# Allowed CORS origins for Blazor Client (must be explicit HTTPS URLs).
# Security__AllowedOrigins__0="https://cinemaflow.vn"

# Reverse proxy trust (affects the resolved client IP and therefore the rate limit buckets).
# SECURITY: only loopback is trusted by default. Do NOT trust a whole private subnet unless
# every host in it is under your control. Configure the exact proxy address or the narrowest
# possible CIDR that contains your reverse proxy.
# Known proxies: exact IP addresses of the proxy that sets X-Forwarded-For.
# Security__KnownProxies__0="10.0.0.5"
# Known proxy networks: CIDR ranges of the proxy network (e.g. 10.20.0.0/16).
# Security__KnownProxyNetworks__0="10.20.0.0/16"

# Demo seeding creates a well-known admin account. Keep this disabled on any host that is
# reachable from the internet.
# Equivalent ASP.NET Core key: Database__SeedDemoData
SEED_DEMO_DATA=false

# Payment webhook replay window in seconds (default: 300; clamped to 30..3600).
# Webhooks without a timestamp remain accepted for backward compatibility.
# Security note: keep this short and synchronize clocks with NTP.
# Payment__WebhookTimestampToleranceSeconds=300

# ------------------------------------------------------------------------------
# 5. Thư viện ảnh nền tập (quản trị viên tự tải lên)
# ------------------------------------------------------------------------------
# Nơi lưu ảnh nền tập do quản trị viên tải lên. Đường dẫn tương đối được tính từ
# thư mục gốc ứng dụng; mặc định "data/episodes" trỏ vào volume server_data (/app/data)
# nên ảnh không mất khi build lại container.
# Storage__EpisodeThumbnailPath="data/episodes"