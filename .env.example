# ==============================================================================
# CinemaFlow (WebXemPhim) - Docker Environment Configuration
# Copy this file to '.env' to override default configuration
# ==============================================================================

# Application Environment (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development

# Host Ports
SERVER_PORT=5085
CLIENT_PORT=5229
MYSQL_PORT=3306

# Database Configuration
# Options for DB_PROVIDER: Sqlite | MySql
DB_PROVIDER=Sqlite
DB_CONNECTION_STRING=Data Source=/app/data/webxemphim.db
SEED_DEMO_DATA=true

# For MySQL Production Setup (run: docker compose --profile mysql up -d)
# DB_PROVIDER=MySql
# DB_CONNECTION_STRING=Server=mysql;Port=3306;Database=webxemphim;User=cinemaflow;Password=cinemaflow_password_2026;
# MYSQL_ROOT_PASSWORD=cinemaflow_root_secret_2026
# MYSQL_DATABASE=webxemphim
# MYSQL_USER=cinemaflow
# MYSQL_PASSWORD=cinemaflow_password_2026

# Security & Cryptographic Keys
STREAM_SIGNING_KEY=CinemaFlow_Secure_Stream_HMAC_Secret_Key_2026_AtLeast32Bytes!
STREAM_TTL_MINUTES=120
PAYMENT_WEBHOOK_SECRET=CinemaFlow_Secure_Payment_Webhook_HMAC_SHA512_Secret_Key_2026_AtLeast32Bytes!
