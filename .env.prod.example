# ==============================================================================
# CinemaFlow Production Environment Configuration
# ==============================================================================

# Tên miền website (VD: phim.example.com hoặc cinemaflow.vn hoặc localhost / IP)
DOMAIN=yourdomain.com

# Email nhận thông báo chứng chỉ Let's Encrypt SSL
ACME_EMAIL=admin@yourdomain.com

# Thông tin cơ sở dữ liệu PostgreSQL 17
POSTGRES_USER=webxemphim
POSTGRES_PASSWORD=ThayBangMatKhauBaoMatPostgres_2026!
POSTGRES_DB=webxemphim

# Khóa bí mật ký số HMAC luồng phát video (bắt buộc tối thiểu 32 ký tự, không dùng chuỗi mặc định)
STREAM_SIGNING_KEY=CinemaFlow_Production_Stream_Secret_Key_2026_AtLeast32Bytes!

# Khóa bí mật xác thực webhook thanh toán VIP (bắt buộc tối thiểu 32 ký tự, không dùng chuỗi mặc định)
PAYMENT_WEBHOOK_SECRET=CinemaFlow_Production_Payment_Webhook_Secret_Key_2026_AtLeast32Bytes!

# GitHub Container Registry Repository (dùng chữ thường)
IMAGE_REPO=kynhungvanlaky-max/w-xemphim
IMAGE_TAG=latest

# URL công khai của API (Mặc định Caddy reverse proxy về chung 1 domain)
PUBLIC_API_BASE_URL=https://yourdomain.com
