# ==============================================================================
# CinemaFlow Production Environment Configuration
# ==============================================================================
# Copy this file to .env and replace every value before deploying.
# Generate strong secrets with, for example:
#   openssl rand -hex 32
# Never commit the real .env file.
# ==============================================================================

# Tên miền website (VD: phim.example.com). Bắt buộc, không dùng giá trị mặc định.
DOMAIN=yourdomain.com

# Email nhận thông báo chứng chỉ Let's Encrypt SSL
ACME_EMAIL=admin@yourdomain.com

# Danh sách host được phép (phân tách bằng dấu chấm phẩy). Bắt buộc.
# Tuyệt đối không dùng "*" trong Production.
ALLOWED_HOSTS=yourdomain.com;www.yourdomain.com;localhost;127.0.0.1;[::1]

# Thông tin cơ sở dữ liệu PostgreSQL 17. Mật khẩu bắt buộc và phải đủ mạnh.
POSTGRES_USER=webxemphim
POSTGRES_PASSWORD=ThayBangMatKhauManhNgauNhien_2026!
POSTGRES_DB=webxemphim

# Khóa bí mật ký số HMAC luồng phát video (bắt buộc tối thiểu 32 ký tự).
# Không dùng chuỗi mẫu công khai; hãy tạo bằng `openssl rand -hex 32`.
STREAM_SIGNING_KEY=

# Khóa bí mật xác thực webhook thanh toán VIP (bắt buộc tối thiểu 32 ký tự).
PAYMENT_WEBHOOK_SECRET=

# Khóa riêng của từng cổng thanh toán (để trống nếu không sử dụng).
PAYOS_WEBHOOK_SECRET=
VNPAY_HASH_SECRET=

# URL công khai của API (bắt buộc, dùng HTTPS).
PUBLIC_API_BASE_URL=https://yourdomain.com

# Tài khoản quản trị khởi tạo một lần cho database trống.
# Xóa hai biến này sau lần triển khai đầu tiên thành công.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Cloudflare R2 / S3 lưu trữ phim (để trống để dùng lưu trữ cục bộ).
CLOUD_STORAGE_PROVIDER=CloudflareR2
CLOUD_STORAGE_ACCOUNT_ID=
CLOUD_STORAGE_ACCESS_KEY_ID=
CLOUD_STORAGE_SECRET_ACCESS_KEY=
CLOUD_STORAGE_BUCKET_NAME=webxemphim-movies
CLOUD_STORAGE_SERVICE_URL=
CLOUD_STORAGE_PUBLIC_BASE_URL=

# GitHub Container Registry Repository (dùng chữ thường)
IMAGE_REPO=kynhungvanlaky-max/w-xemphim
IMAGE_TAG=latest
