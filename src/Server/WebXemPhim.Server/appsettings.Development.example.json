{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=webxemphim;Username=webxemphim;Password=webxemphim"
  },
  "Database": {
    "Provider": "PostgreSql",
    "SeedDemoData": true
  },
  "Security": {
    "AllowedOrigins": [
      "http://localhost:5229",
      "http://127.0.0.1:5229"
    ],
    "AllowDemoPayments": true,
    "StreamSigningKey": "",
    "StreamTtlMinutes": 10,
    "StreamTokenClockSkewSeconds": 30,
    "RateLimits": {
      "ApiPerMinute": 300,
      "AuthPerMinute": 15,
      "StreamPlaybackPerMinute": 600,
      "StreamSignPerMinute": 30
    }
  },
  "StreamSecurity": {
    "DefaultMaxStreams": 1,
    "MaxConcurrentStreams": {
      "Free": 1,
      "Vip": 2,
      "Premium": 4,
      "Admin": 5
    }
  },
  "Payment": {
    "WebhookSecret": "",
    "Gateways": {
      "PayOS": {
        "WebhookSecret": ""
      },
      "VNPay": {
        "HashSecret": ""
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
