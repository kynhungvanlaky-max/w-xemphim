{
  "ConnectionStrings": {
    "Default": "postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
  },
  "Database": {
    "Provider": "PostgreSql",
    "SeedDemoData": false
  },
  "Supabase": {
    "Url": "https://[PROJECT_REF].supabase.co",
    "PublishableKey": "sb_publishable_...",
    "SecretKey": "sb_secret_...",
    "JwksUrl": "https://[PROJECT_REF].supabase.co/auth/v1/.well-known/jwks.json"
  },
  "Security": {
    "AllowedOrigins": [
      "http://localhost:5229",
      "http://127.0.0.1:5229"
    ],
    "AllowDemoPayments": true,
    "StreamSigningKey": "",
    "StreamTtlMinutes": 10,
    "StreamTokenClockSkewSeconds": 30,
    "RateLimits": {
      "ApiPerMinute": 300,
      "AuthPerMinute": 15,
      "StreamPlaybackPerMinute": 600,
      "StreamSignPerMinute": 30
    }
  },
  "StreamSecurity": {
    "DefaultMaxStreams": 1,
    "MaxConcurrentStreams": {
      "Free": 1,
      "Vip": 2,
      "Premium": 4,
      "Admin": 5
    }
  },
  "Payment": {
    "WebhookSecret": "",
    "Gateways": {
      "PayOS": {
        "WebhookSecret": ""
      },
      "VNPay": {
        "HashSecret": ""
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
