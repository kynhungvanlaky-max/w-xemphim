{
  "ConnectionStrings": {
    "Default": "Data Source=webxemphim.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "SeedDemoData": true
  },
  "Security": {
    "AllowedOrigins": [
      "http://localhost:5229"
    ],
    "AllowDemoPayments": true,
    "StreamSigningKey": "CinemaFlow_Secure_Stream_HMAC_Secret_Key_2026_AtLeast32Bytes!",
    "StreamTtlMinutes": 120
  },
  "Payment": {
    "WebhookSecret": "CinemaFlow_Secure_Payment_Webhook_HMAC_SHA512_Secret_Key_2026_AtLeast32Bytes!",
    "Gateways": {
      "PayOS": {
        "WebhookSecret": "CinemaFlow_PayOS_Webhook_Secret_Key_2026_AtLeast32Bytes!"
      },
      "VNPay": {
        "HashSecret": "CinemaFlow_VNPay_Hash_Secret_Key_2026_AtLeast32Bytes!"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
