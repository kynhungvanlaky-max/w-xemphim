@inject IHttpContextAccessor HttpContextAccessor
@using WebXemPhim.Shared.Security
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0c10" />
    <meta name="description" content="CinemaFlow - khám phá và xem phim trực tuyến với trải nghiệm điện ảnh hiện đại." />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <base href="/" />
    <ResourcePreloader />
    <title>CinemaFlow - Điện ảnh theo cách của bạn</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600;1,700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="css/cinema-theme.css" />
    <link rel="stylesheet" href="WebXemPhim.Client.styles.css" />
    <link rel="stylesheet" href="css/redesign-2026.css" />
    <link rel="stylesheet" href="css/home-expanded.css" />
    <link rel="stylesheet" href="css/library-membership.css" />
    <link rel="stylesheet" href="css/watch-workspace.css" />
    <link rel="stylesheet" href="css/admin-workspace.css" />
    <link rel="stylesheet" href="css/popup-polish.css" />
    <link rel="stylesheet" href="css/account-overview.css" />
    <link rel="stylesheet" href="css/discovery-filters.css" />
    <link rel="stylesheet" href="css/genres-page.css" />
    <link rel="stylesheet" href="css/profile-settings.css" />
    <link rel="stylesheet" href="css/light-theme.css" />
    <link rel="stylesheet" href="css/mobile-ui-fixes.css" />
    <link rel="stylesheet" href="css/typography-polish.css" />
    <script src="js/theme-manager.js"></script>
    <ImportMap AdditionalAttributes="@(new Dictionary<string, object> { ["nonce"] = HttpContextAccessor.HttpContext?.Items[WebSecurityExtensions.NonceKey]?.ToString() ?? "" })" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="alternate icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="js/hls.min.js"></script>
    <script src="js/cinema-player.js"></script>
    <script src="js/admin-tools.js"></script>
    <script src="js/cinema-navbar.js"></script>
</body>
</html>
