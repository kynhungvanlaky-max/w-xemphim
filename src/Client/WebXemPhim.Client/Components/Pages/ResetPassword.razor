@page "/reset-password"
@inject IAccountApiClient Api
@using WebXemPhim.Shared.Requests
@using WebXemPhim.Client.Components.Common
@using WebXemPhim.Client.Components.Icons

<PageTitle>Đặt lại mật khẩu - CinemaFlow</PageTitle>

<main class="auth-shell auth-recovery-shell">
    <section class="auth-intro">
        <CinemaLogo Size="CinemaLogo.CinemaLogoSize.Large" ShowTagline="true" />
        <p class="auth-kicker">Mật khẩu mới</p>
        <h1>Thiết lập mật khẩu an toàn.</h1>
        <p>Bảo vệ tài khoản CinemaFlow của bạn bằng mật khẩu mạnh kết hợp chữ hoa, chữ thường và chữ số.</p>

        <div class="auth-feature-list" style="margin-top: 2rem; display: flex; flex-direction: column; gap: 1rem; color: rgba(255,255,255,0.7); font-size: 0.88rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <CinemaIcon Name="CinemaIconName.Key" Size="18" Class="text-danger" />
                <span>Mật khẩu tối thiểu 8 ký tự</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <CinemaIcon Name="CinemaIconName.Check" Size="18" Class="text-danger" />
                <span>Không nên trùng lặp với mật khẩu tài khoản khác</span>
            </div>
        </div>
    </section>

    <section class="auth-panel" aria-labelledby="reset-title">
        <div class="auth-panel-header">
            <a class="auth-back-link" href="/login">
                <CinemaIcon Name="CinemaIconName.ArrowLeft" Size="16" />
                <span>Trở lại đăng nhập</span>
            </a>
            <h2 id="reset-title">Tạo mật khẩu mới</h2>
            <p>Nhập mật khẩu mới cho tài khoản CinemaFlow của bạn bên dưới.</p>
        </div>

        @if (done)
        {
            <div class="auth-success-card" role="status">
                <div class="auth-success-icon">
                    <CinemaIcon Name="CinemaIconName.Check" Size="32" />
                </div>
                <h3>Đổi mật khẩu thành công!</h3>
                <p>Mật khẩu của bạn đã được cập nhật an toàn. Bây giờ bạn có thể đăng nhập bằng mật khẩu mới.</p>
                <div class="auth-success-actions">
                    <a href="/login" class="button primary wide">
                        <CinemaIcon Name="CinemaIconName.Login" Size="16" />
                        <span>Đăng nhập ngay</span>
                    </a>
                </div>
            </div>
        }
        else
        {
            <EditForm Model="model" OnValidSubmit="Submit">
                <DataAnnotationsValidator />

                <div class="form-field">
                    <label for="new-password">Mật khẩu mới</label>
                    <InputText id="new-password" 
                               type="password" 
                               autocomplete="new-password" 
                               @bind-Value="model.NewPassword" 
                               placeholder="Ít nhất 8 ký tự"
                               autofocus />
                    <ValidationMessage For="() => model.NewPassword" />
                </div>

                <div class="form-field">
                    <label for="new-password-confirm">Xác nhận mật khẩu mới</label>
                    <InputText id="new-password-confirm" 
                               type="password" 
                               autocomplete="new-password" 
                               @bind-Value="model.ConfirmPassword" 
                               placeholder="Nhập lại mật khẩu mới" />
                    <ValidationMessage For="() => model.ConfirmPassword" />
                </div>

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="form-alert error" role="alert">
                        <CinemaIcon Name="CinemaIconName.AlertCircle" Size="16" />
                        <span>@error</span>
                    </div>
                }

                <button class="button primary wide btn-auth-submit" type="submit" disabled="@submitting">
                    <CinemaIcon Name="CinemaIconName.Key" Size="18" />
                    <span>@(submitting ? "Đang cập nhật..." : "Lưu mật khẩu mới")</span>
                </button>
            </EditForm>
        }
    </section>
</main>

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    private readonly ResetPasswordRequest model = new();
    private bool submitting;
    private bool done;
    private string? error;

    protected override void OnParametersSet()
    {
        model.Token = Token ?? string.Empty;
        model.Email = Email ?? string.Empty;
    }

    private async Task Submit()
    {
        if (submitting) return;
        submitting = true;
        error = null;
        try
        {
            var response = await Api.ResetPasswordAsync(model);
            done = response?.Success == true;
            if (!done)
            {
                error = response?.Message ?? "Liên kết đặt lại không hợp lệ hoặc đã hết hạn.";
            }
        }
        catch
        {
            error = "Có lỗi kết nối máy chủ. Vui lòng thử lại.";
        }
        finally
        {
            submitting = false;
        }
    }
}
