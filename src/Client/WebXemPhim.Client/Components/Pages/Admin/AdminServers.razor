@page "/admin/servers"
@page "/admin/stream-servers"
@layout WebXemPhim.Client.Components.Layout.AdminLayout
@using WebXemPhim.Shared.Models
@using WebXemPhim.Shared.Enums
@using WebXemPhim.Client.Components.Icons
@using WebXemPhim.Client.Components.Common
@using WebXemPhim.Client.Services
@inject IAdminApiClient AdminApi
@inject NavigationManager Nav
@inject ILogger<AdminServers> Logger

<CinemaPageTitle>Quản lý Máy chủ &amp; Luồng phát - CinemaFlow Admin</CinemaPageTitle>

<!-- Top Operational Bar -->
<header class="admin-topbar">
    <div class="topbar-title-group">
        <div style="display: flex; align-items: center; gap: 0.85rem; margin-bottom: 0.25rem;">
            <h1 class="topbar-title">Điều khiển Máy chủ &amp; Phân luồng phát</h1>
            <div class="live-status-pill @(isLoading ? "is-offline" : "")">
                <span class="live-dot-pulse"></span>
                <span>@(isLoading ? "Đang đồng bộ…" : $"{policies.Count(p => p.IsActive)}/{policies.Count} cụm hoạt động")</span>
            </div>
        </div>
        <p class="topbar-subtitle">Cấu hình điều phối lưu lượng mạng (Traffic Shaping), bộ đệm xả nhanh, phân luồng VIP độc quyền và trạng thái bảo trì</p>
    </div>

    <div class="topbar-actions">
        <button type="button" class="btn-secondary-ghost" @onclick="() => showResetConfirm = true" disabled="@isLoading" title="Khôi phục toàn bộ chính sách về cấu hình mặc định">
            <CinemaIcon Name="CinemaIconName.Refresh" Size="15" />
            <span>Khôi phục mặc định</span>
        </button>

        <button type="button" class="btn-secondary-ghost" @onclick="LoadPoliciesAsync" disabled="@isLoading" title="Làm mới trạng thái">
            <CinemaIcon Name="CinemaIconName.Refresh" Size="15" />
            <span>Làm mới</span>
        </button>

        <NavLink href="/admin/episodes" class="btn-primary-action" title="Quản lý chi tiết từng tập phim và các luồng phát">
            <CinemaIcon Name="CinemaIconName.List" Size="15" />
            <span>Quản lý tập phim</span>
        </NavLink>
    </div>
</header>

@if (!string.IsNullOrEmpty(actionAlert))
{
    <div class="form-alert success" style="margin-bottom: 1rem;" role="status">
        @actionAlert
    </div>
}

@if (!string.IsNullOrEmpty(actionError))
{
    <div class="form-alert error" style="margin-bottom: 1rem;" role="alert">
        @actionError
    </div>
}

<!-- 4 KPI Metrics Cards -->
<section class="admin-kpi-grid">
    <div class="kpi-card card-movies">
        <div class="kpi-icon-wrap gold"><CinemaIcon Name="CinemaIconName.Crown" Size="22" /></div>
        <div class="kpi-body">
            <span class="kpi-value">Line-Rate Gigabit</span>
            <span class="kpi-label">Luồng VIP FastServer</span>
            <span class="kpi-change">0 bóp băng thông · 4K UHD · Đệm 8 MB</span>
        </div>
    </div>

    <div class="kpi-card card-episodes">
        <div class="kpi-icon-wrap cyan"><CinemaIcon Name="CinemaIconName.Globe" Size="22" /></div>
        <div class="kpi-body">
            <span class="kpi-value font-mono-num">@FormatBandwidth(GetPolicy("cdn")?.MaxBandwidthKbps ?? 3500)</span>
            <span class="kpi-label">Luồng Hydra CDN (Phổ thông)</span>
            <span class="kpi-change">Trần 1080p FHD · Đệm @((GetPolicy("cdn")?.BufferInitialBurstKb ?? 2048) / 1024) MB</span>
        </div>
    </div>

    <div class="kpi-card card-users">
        <div class="kpi-icon-wrap amber"><CinemaIcon Name="CinemaIconName.HardDrive" Size="22" /></div>
        <div class="kpi-body">
            <span class="kpi-value font-mono-num">@FormatBandwidth(GetPolicy("backup")?.MaxBandwidthKbps ?? 1500)</span>
            <span class="kpi-label">Luồng Dự phòng (Backup)</span>
            <span class="kpi-change">Trần 720p HD · Tiết kiệm băng thông</span>
        </div>
    </div>

    <div class="kpi-card card-rating">
        <div class="kpi-icon-wrap green"><CinemaIcon Name="CinemaIconName.Check" Size="22" /></div>
        <div class="kpi-body">
            <span class="kpi-value font-mono-num">@policies.Count(p => p.IsActive)/@policies.Count</span>
            <span class="kpi-label">Hạ tầng sẵn sàng</span>
            <span class="kpi-change">@policies.Count(p => !p.IsActive) cụm đang bảo trì (503)</span>
        </div>
    </div>
</section>

<!-- Filter Suite: Quick Status Tabs -->
<div class="cockpit-filter-suite">
    <div class="filter-suite-top">
        <div class="status-tabs-row" style="margin-bottom: 0; flex-wrap: wrap; gap: 0.45rem;">
            <button type="button" class="status-tab-btn @(statusFilter == null ? "active" : "")" @onclick="SetFilterAll">
                Tất cả cụm (@policies.Count)
            </button>
            <button type="button" class="status-tab-btn @(statusFilter == "active" ? "active" : "")" @onclick="SetFilterActive">
                <span class="status-dot green"></span> Đang hoạt động (@policies.Count(p => p.IsActive))
            </button>
            <button type="button" class="status-tab-btn @(statusFilter == "maintenance" ? "active" : "")" @onclick="SetFilterMaintenance">
                <span class="status-dot red"></span> Đang bảo trì (@policies.Count(p => !p.IsActive))
            </button>
            <button type="button" class="status-tab-btn @(statusFilter == "vip" ? "active" : "")" @onclick="SetFilterVip">
                <span class="status-dot amber"></span> Khóa VIP-Only (@policies.Count(p => p.IsVipOnly))
            </button>
        </div>
    </div>
</div>

<!-- Main Table: Server Policies -->
<section class="admin-table-section">
    <div class="table-frame">
        @if (isLoading)
        {
            <div class="admin-table-state-msg">Đang đồng bộ chính sách máy chủ từ hệ thống...</div>
        }
        else if (FilteredPolicies.Count == 0)
        {
            <div class="admin-table-state-msg">Không có cụm máy chủ nào phù hợp với bộ lọc.</div>
        }
        else
        {
            <table class="admin-movies-table">
                <thead>
                    <tr>
                        <th>Cụm máy chủ</th>
                        <th>Phân loại</th>
                        <th>Trạng thái phát</th>
                        <th>Quyền truy cập</th>
                        <th>Trần băng thông</th>
                        <th>Chất lượng tối đa</th>
                        <th>Đệm ban đầu</th>
                        <th>Ưu tiên</th>
                        <th>Cập nhật</th>
                        <th style="text-align: right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var policy in FilteredPolicies)
                    {
                        var isVipCluster = policy.ServerKey.Equals("vip", StringComparison.OrdinalIgnoreCase);
                        var isCdnCluster = policy.ServerKey.Equals("cdn", StringComparison.OrdinalIgnoreCase);

                        <tr>
                            <td>
                                <div style="display: flex; align-items: center; gap: 0.65rem;">
                                    <div class="kpi-icon-wrap @(isVipCluster ? "gold" : isCdnCluster ? "cyan" : "amber")" style="width: 32px; height: 32px; min-width: 32px; border-radius: 6px;">
                                        @if (isVipCluster)
                                        {
                                            <CinemaIcon Name="CinemaIconName.Crown" Size="16" />
                                        }
                                        else if (isCdnCluster)
                                        {
                                            <CinemaIcon Name="CinemaIconName.Globe" Size="16" />
                                        }
                                        else
                                        {
                                            <CinemaIcon Name="CinemaIconName.HardDrive" Size="16" />
                                        }
                                    </div>
                                    <div>
                                        <strong style="color: var(--admin-text-title); font-size: 0.88rem;">@policy.DisplayName</strong>
                                        <div style="font-size: 0.72rem; color: var(--admin-text-muted); margin-top: 2px;">
                                            Mã: <code class="font-mono-num">@policy.ServerKey</code> · Tiền tố: @policy.ServerNamePrefix
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <span class="status-pill @(isVipCluster ? "status-amber" : isCdnCluster ? "status-cyan" : "status-green")">
                                    @policy.ServerType
                                </span>
                            </td>

                            <td>
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    <label class="cockpit-switch" title="@(policy.IsActive ? "Đang phát bình thường (Bấm để tạm dừng bảo trì)" : "Đang bảo trì 503 (Bấm để kích hoạt lại)")" aria-label="Chuyển trạng thái hoạt động">
                                        <input type="checkbox" checked="@policy.IsActive" @onchange="() => QuickToggleActive(policy)" disabled="@isQuickUpdating" />
                                        <span class="cockpit-slider emerald"></span>
                                    </label>
                                    <span style="font-size: 0.78rem; font-weight: 600; color: @(policy.IsActive ? "var(--admin-accent-green)" : "var(--admin-accent-rose)");">
                                        @(policy.IsActive ? "Hoạt động" : "Bảo trì (503)")
                                    </span>
                                </div>
                            </td>

                            <td>
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    <label class="cockpit-switch" title="@(policy.IsVipOnly ? "Khóa VIP-Only (Bấm để mở cho tất cả)" : "Công khai (Bấm để giới hạn chỉ thành viên VIP)")" aria-label="Chuyển quyền VIP-Only">
                                        <input type="checkbox" checked="@policy.IsVipOnly" @onchange="() => QuickToggleVipOnly(policy)" disabled="@isQuickUpdating" />
                                        <span class="cockpit-slider"></span>
                                    </label>
                                    <span style="font-size: 0.78rem; font-weight: 600; color: @(policy.IsVipOnly ? "var(--admin-accent-amber)" : "var(--admin-text-muted)");">
                                        @(policy.IsVipOnly ? "VIP-Only" : "Công khai")
                                    </span>
                                </div>
                            </td>

                            <td>
                                <strong class="font-mono-num" style="color: @(policy.MaxBandwidthKbps <= 0 ? "var(--admin-accent-amber)" : "var(--admin-text-title)");">
                                    @FormatBandwidth(policy.MaxBandwidthKbps)
                                </strong>
                                <small style="display: block; color: var(--admin-text-muted); font-size: 0.72rem; margin-top: 1px;">
                                    @(policy.MaxBandwidthKbps <= 0 ? "Không bóp tốc độ" : $"{policy.MaxBandwidthKbps} Kbps")
                                </small>
                            </td>

                            <td>
                                <span class="movie-quality-tag">@policy.MaxQuality</span>
                            </td>

                            <td>
                                <span class="font-mono-num">@(policy.BufferInitialBurstKb / 1024) MB</span>
                                <small style="display: block; color: var(--admin-text-muted); font-size: 0.72rem;">@policy.BufferInitialBurstKb KB</small>
                            </td>

                            <td>
                                <span class="category-tag font-mono-num">Ưu tiên @policy.Priority</span>
                            </td>

                            <td class="td-time">
                                <span class="time-date font-mono-num">@policy.UpdatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                <span class="time-hour font-mono-num">@policy.UpdatedAtUtc.ToLocalTime().ToString("HH:mm")</span>
                            </td>

                            <td style="text-align: right;">
                                <div class="row-actions">
                                    <button type="button" class="btn-table-action edit" @onclick="() => OpenEditModal(policy)" title="Mở bảng cấu hình chính sách chi tiết">
                                        <CinemaIcon Name="CinemaIconName.Edit" Size="13" />
                                        <span>Cấu hình</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>

<!-- Standard Edit Policy Modal -->
@if (editingPolicy != null)
{
    <div class="admin-modal-backdrop" @onclick="CloseEditModal">
        <div class="admin-modal-card" style="max-width: 640px;" role="dialog" aria-modal="true" tabindex="-1" @onclick:stopPropagation>
            <div class="admin-modal-header">
                <h3>Cấu hình chính sách cụm: @editingPolicy.DisplayName (@editingPolicy.ServerKey)</h3>
                <button type="button" class="btn-close-modal" @onclick="CloseEditModal">&times;</button>
            </div>

            <div class="admin-modal-body">
                @if (!string.IsNullOrEmpty(modalError))
                {
                    <div class="form-alert error" style="margin-bottom: 1rem;" role="alert">@modalError</div>
                }

                <!-- Dual Quick Toggles in Modal -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem; padding: 0.85rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px;">
                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                        <label class="cockpit-switch" title="Chuyển trạng thái hoạt động">
                            <input type="checkbox" @bind="modalReq.IsActive" />
                            <span class="cockpit-slider emerald"></span>
                        </label>
                        <div>
                            <strong style="display: block; font-size: 0.82rem; color: var(--admin-text-title);">Trạng thái phát</strong>
                            <small style="color: var(--admin-text-muted); font-size: 0.72rem;">@(modalReq.IsActive ? "Sẵn sàng phục vụ" : "Bảo trì (Trả về 503)")</small>
                        </div>
                    </div>

                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                        <label class="cockpit-switch" title="Chuyển quyền VIP-Only">
                            <input type="checkbox" @bind="modalReq.IsVipOnly" />
                            <span class="cockpit-slider"></span>
                        </label>
                        <div>
                            <strong style="display: block; font-size: 0.82rem; color: var(--admin-text-title);">Đặc quyền VIP-Only</strong>
                            <small style="color: var(--admin-text-muted); font-size: 0.72rem;">@(modalReq.IsVipOnly ? "Chỉ thành viên VIP" : "Mở cho mọi người")</small>
                        </div>
                    </div>
                </div>

                <!-- Bandwidth Throttling -->
                <div class="admin-form-group" style="margin-bottom: 1.25rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                        <label style="margin-bottom: 0;">Trần băng thông phát (Bandwidth Cap)</label>
                        <strong class="font-mono-num" style="color: var(--admin-accent-amber); font-size: 0.85rem;">
                            @FormatBandwidth(modalReq.MaxBandwidthKbps)
                        </strong>
                    </div>

                    <div class="status-tabs-row" style="margin-bottom: 0.6rem; gap: 0.35rem;">
                        <button type="button" class="status-tab-btn @(modalReq.MaxBandwidthKbps == 1500 ? "active" : "")" @onclick="SetPreset1500">1.5M (Tiết kiệm)</button>
                        <button type="button" class="status-tab-btn @(modalReq.MaxBandwidthKbps == 3500 ? "active" : "")" @onclick="SetPreset3500">3.5M (Chuẩn 1080p)</button>
                        <button type="button" class="status-tab-btn @(modalReq.MaxBandwidthKbps == 5000 ? "active" : "")" @onclick="SetPreset5000">5.0M (Tốc độ cao)</button>
                        <button type="button" class="status-tab-btn @(modalReq.MaxBandwidthKbps == 0 ? "active" : "")" @onclick="SetPresetUnlimited">Không giới hạn</button>
                    </div>

                    <input type="range" min="0" max="15000" step="250" style="width: 100%; accent-color: var(--admin-accent);" @bind="modalReq.MaxBandwidthKbps" />
                    <small style="color: var(--admin-text-muted); font-size: 0.74rem; margin-top: 0.25rem; display: block;">
                        Tốc độ truyền tải sẽ được giới hạn chính xác sau khi người dùng tải hết lượng dữ liệu mở đầu ban đầu.
                    </small>
                </div>

                <!-- Quality & Buffer Grid -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
                    <div class="admin-form-group">
                        <label>Trần chất lượng phát</label>
                        <select @bind="modalReq.MaxQuality">
                            <option value="4K Ultra HD">4K Ultra HD</option>
                            <option value="1080p Full HD">1080p Full HD</option>
                            <option value="720p HD">720p HD</option>
                            <option value="480p SD">480p SD</option>
                        </select>
                        <small style="color: var(--admin-text-muted); font-size: 0.72rem; margin-top: 0.25rem; display: block;">
                            Trần độ phân giải phục vụ từ server này.
                        </small>
                    </div>

                    <div class="admin-form-group">
                        <label>Bộ đệm mở đầu xả nhanh</label>
                        <select @bind="modalReq.BufferInitialBurstKb">
                            <option value="8192">8 MB (Mở phim tức thì)</option>
                            <option value="4096">4 MB (Nhanh)</option>
                            <option value="2048">2 MB (Tiêu chuẩn)</option>
                            <option value="1024">1 MB (Tiết kiệm)</option>
                            <option value="512">512 KB (Bóp chặt)</option>
                        </select>
                        <small style="color: var(--admin-text-muted); font-size: 0.72rem; margin-top: 0.25rem; display: block;">
                            Lượng byte đầu tiên xả tốc độ tối đa để bật video không giật.
                        </small>
                    </div>
                </div>

                <!-- Priority & Description -->
                <div style="display: grid; grid-template-columns: 140px 1fr; gap: 1rem; margin-bottom: 1rem;">
                    <div class="admin-form-group">
                        <label>Độ ưu tiên (1 - 10)</label>
                        <input type="number" min="1" max="10" @bind="modalReq.Priority" />
                    </div>

                    <div class="admin-form-group">
                        <label>Ghi chú quản trị</label>
                        <input type="text" @bind="modalReq.Description" placeholder="Mô tả mục đích sử dụng..." />
                    </div>
                </div>
            </div>

            <div class="admin-modal-footer">
                <button type="button" class="btn-secondary-ghost" @onclick="CloseEditModal" disabled="@isSubmittingModal">Hủy</button>
                <button type="button" class="btn-primary-action" @onclick="SubmitEditModal" disabled="@isSubmittingModal">
                    @(isSubmittingModal ? "Đang lưu..." : "Lưu thay đổi chính sách")
                </button>
            </div>
        </div>
    </div>
}

<!-- Confirm Reset Dialog -->
<AdminConfirmDialog IsOpen="@showResetConfirm"
                    Title="Khôi phục chính sách mặc định?"
                    Message="Bạn có chắc chắn muốn đặt lại toàn bộ thông số băng thông, bộ đệm và chất lượng của 3 cụm máy chủ về cấu hình chuẩn ban đầu?"
                    ConfirmText="Xác nhận khôi phục"
                    CancelText="Giữ nguyên"
                    Variant="warning"
                    OnConfirm="ExecuteResetDefaultsAsync"
                    OnCancel="() => showResetConfirm = false" />

@code {
    private List<StreamServerPolicyDto> policies = new();
    private bool isLoading = true;
    private string? actionAlert;
    private string? actionError;
    private string? statusFilter;
    private bool showResetConfirm;
    private bool isQuickUpdating;

    // Modal state
    private StreamServerPolicyDto? editingPolicy;
    private UpdateStreamServerPolicyRequest modalReq = new();
    private bool isSubmittingModal;
    private string? modalError;

    private List<StreamServerPolicyDto> FilteredPolicies
    {
        get
        {
            if (string.IsNullOrEmpty(statusFilter)) return policies;
            return statusFilter switch
            {
                "active" => policies.Where(p => p.IsActive).ToList(),
                "maintenance" => policies.Where(p => !p.IsActive).ToList(),
                "vip" => policies.Where(p => p.IsVipOnly).ToList(),
                _ => policies
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPoliciesAsync();
    }

    private async Task LoadPoliciesAsync()
    {
        isLoading = true;
        actionAlert = null;
        actionError = null;

        try
        {
            var res = await AdminApi.GetStreamServerPoliciesAsync();
            if (res != null && res.Success && res.Data != null)
            {
                policies = res.Data;
            }
            else
            {
                actionError = res?.Message ?? "Không thể tải danh sách chính sách máy chủ.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lỗi khi tải chính sách máy chủ");
            actionError = "Lỗi kết nối máy chủ API: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private StreamServerPolicyDto? GetPolicy(string key)
    {
        return policies.FirstOrDefault(p => p.ServerKey.Equals(key, StringComparison.OrdinalIgnoreCase));
    }

    private void SetFilterAll() => statusFilter = null;
    private void SetFilterActive() => statusFilter = "active";
    private void SetFilterMaintenance() => statusFilter = "maintenance";
    private void SetFilterVip() => statusFilter = "vip";

    private void SetPreset1500() => modalReq.MaxBandwidthKbps = 1500;
    private void SetPreset3500() => modalReq.MaxBandwidthKbps = 3500;
    private void SetPreset5000() => modalReq.MaxBandwidthKbps = 5000;
    private void SetPresetUnlimited() => modalReq.MaxBandwidthKbps = 0;

    private string FormatBandwidth(int kbps)
    {
        if (kbps <= 0) return "Line-Rate (Gigabit)";
        return $"{Math.Round(kbps / 1000.0, 1)} Mbps";
    }

    private async Task QuickToggleActive(StreamServerPolicyDto policy)
    {
        if (isQuickUpdating) return;
        isQuickUpdating = true;
        actionAlert = null;
        actionError = null;

        var targetActive = !policy.IsActive;
        try
        {
            var req = new UpdateStreamServerPolicyRequest
            {
                IsActive = targetActive,
                IsVipOnly = policy.IsVipOnly,
                MaxBandwidthKbps = policy.MaxBandwidthKbps,
                MaxQuality = policy.MaxQuality,
                BufferInitialBurstKb = policy.BufferInitialBurstKb,
                Priority = policy.Priority,
                Description = policy.Description
            };

            var res = await AdminApi.UpdateStreamServerPolicyAsync(policy.ServerKey, req);
            if (res != null && res.Success && res.Data != null)
            {
                policy.IsActive = res.Data.IsActive;
                policy.UpdatedAtUtc = res.Data.UpdatedAtUtc;
                actionAlert = $"Đã {(policy.IsActive ? "kích hoạt" : "chuyển sang bảo trì")} cụm '{policy.DisplayName}' thành công!";
            }
            else
            {
                actionError = res?.Message ?? "Không thể cập nhật trạng thái hoạt động.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lỗi khi đổi trạng thái hoạt động cụm {Key}", policy.ServerKey);
            actionError = "Lỗi thao tác: " + ex.Message;
        }
        finally
        {
            isQuickUpdating = false;
        }
    }

    private async Task QuickToggleVipOnly(StreamServerPolicyDto policy)
    {
        if (isQuickUpdating) return;
        isQuickUpdating = true;
        actionAlert = null;
        actionError = null;

        var targetVipOnly = !policy.IsVipOnly;
        try
        {
            var req = new UpdateStreamServerPolicyRequest
            {
                IsActive = policy.IsActive,
                IsVipOnly = targetVipOnly,
                MaxBandwidthKbps = policy.MaxBandwidthKbps,
                MaxQuality = policy.MaxQuality,
                BufferInitialBurstKb = policy.BufferInitialBurstKb,
                Priority = policy.Priority,
                Description = policy.Description
            };

            var res = await AdminApi.UpdateStreamServerPolicyAsync(policy.ServerKey, req);
            if (res != null && res.Success && res.Data != null)
            {
                policy.IsVipOnly = res.Data.IsVipOnly;
                policy.UpdatedAtUtc = res.Data.UpdatedAtUtc;
                actionAlert = $"Đã {(policy.IsVipOnly ? "khóa VIP-Only" : "mở quyền truy cập")} cho cụm '{policy.DisplayName}'!";
            }
            else
            {
                actionError = res?.Message ?? "Không thể cập nhật quyền VIP-Only.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lỗi khi đổi quyền VIP-Only cụm {Key}", policy.ServerKey);
            actionError = "Lỗi thao tác: " + ex.Message;
        }
        finally
        {
            isQuickUpdating = false;
        }
    }

    private void OpenEditModal(StreamServerPolicyDto policy)
    {
        editingPolicy = policy;
        modalError = null;
        modalReq = new UpdateStreamServerPolicyRequest
        {
            IsActive = policy.IsActive,
            IsVipOnly = policy.IsVipOnly,
            MaxBandwidthKbps = policy.MaxBandwidthKbps,
            MaxQuality = policy.MaxQuality,
            BufferInitialBurstKb = policy.BufferInitialBurstKb,
            Priority = policy.Priority,
            Description = policy.Description
        };
    }

    private void CloseEditModal()
    {
        editingPolicy = null;
        modalError = null;
    }

    private async Task SubmitEditModal()
    {
        if (editingPolicy is null || isSubmittingModal) return;
        isSubmittingModal = true;
        modalError = null;

        try
        {
            var res = await AdminApi.UpdateStreamServerPolicyAsync(editingPolicy.ServerKey, modalReq);
            if (res != null && res.Success && res.Data != null)
            {
                var idx = policies.FindIndex(p => p.ServerKey.Equals(editingPolicy.ServerKey, StringComparison.OrdinalIgnoreCase));
                if (idx >= 0)
                {
                    policies[idx] = res.Data;
                }
                actionAlert = $"Đã cập nhật chính sách cụm '{editingPolicy.DisplayName}' thành công!";
                CloseEditModal();
            }
            else
            {
                modalError = res?.Message ?? "Không thể lưu cập nhật chính sách.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lỗi khi lưu modal cho cụm {Key}", editingPolicy.ServerKey);
            modalError = "Lỗi: " + ex.Message;
        }
        finally
        {
            isSubmittingModal = false;
        }
    }

    private async Task ExecuteResetDefaultsAsync()
    {
        showResetConfirm = false;
        isLoading = true;
        actionAlert = null;
        actionError = null;

        try
        {
            var res = await AdminApi.ResetStreamServerPoliciesAsync();
            if (res != null && res.Success && res.Data != null)
            {
                policies = res.Data;
                actionAlert = "Đã khôi phục toàn bộ chính sách máy chủ về thông số chuẩn mặc định!";
            }
            else
            {
                actionError = res?.Message ?? "Không thể khôi phục chính sách mặc định.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lỗi khi khôi phục chính sách mặc định");
            actionError = "Lỗi khi gọi API: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
