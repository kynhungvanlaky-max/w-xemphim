@page "/admin"
@page "/admin/overview"
@layout WebXemPhim.Client.Components.Layout.AdminLayout
@using WebXemPhim.Shared.Models
@using WebXemPhim.Shared.Enums
@using WebXemPhim.Client.Components.Icons
@using WebXemPhim.Client.Services
@inject NavigationManager Nav
@inject AuthState Auth
@inject IAdminApiClient AdminApi
@inject IMovieApiClient MovieApi
@implements IDisposable

<CinemaPageTitle>Tổng quan hệ thống - CinemaFlow Admin</CinemaPageTitle>

<!-- Top Operational Bar -->
<header class="admin-topbar">
    <div class="topbar-title-group">
        <div style="display: flex; align-items: center; gap: 0.85rem; margin-bottom: 0.25rem;">
            <h1 class="topbar-title">Tổng quan vận hành</h1>
            <div class="live-status-pill @(health is null ? "is-offline" : "")">
                <span class="live-dot-pulse"></span>
                <span>@(health is null ? "Đang kết nối…" : "Hệ thống trực tuyến")</span>
            </div>
        </div>
        <p class="topbar-subtitle">Báo cáo số liệu tổng hợp, hoạt động thời gian thực và phân bố nội dung CinemaFlow</p>
    </div>

    <div class="topbar-actions">
        <button type="button" class="btn-secondary-ghost" @onclick="RefreshData">
            <CinemaIcon Name="CinemaIconName.Refresh" Size="15" />
            <span>Làm mới</span>
        </button>
        <NavLink href="/admin/movies" class="btn-add-movie">
            <CinemaIcon Name="CinemaIconName.Film" Size="16" />
            <span>Quản lý kho phim</span>
        </NavLink>
    </div>
</header>

@if (!string.IsNullOrEmpty(actionAlert))
{
    <div class="form-alert success" style="margin-bottom: 1rem;" role="status">
        @actionAlert
    </div>
}

@if (!string.IsNullOrEmpty(actionError))
{
    <div class="form-alert error" style="margin-bottom: 1rem;" role="alert">
        @actionError
    </div>
}

<!-- 4 KPI Metrics Cards -->
<section class="admin-kpi-grid">
    <div class="kpi-card card-movies">
        <div class="kpi-icon-wrap red"><CinemaIcon Name="CinemaIconName.Film" Size="22" /></div>
        <div class="kpi-body">
            <span class="kpi-value">@(stats != null ? (stats.TotalMovies + stats.TotalSeries + stats.TotalAnime).ToString("N0") : "...")</span>
            <span class="kpi-label">Tổng số phim</span>
            <span class="kpi-change">@(stats?.TotalSeries ?? 0) phim bộ · @(stats?.TotalAnime ?? 0) anime</span>
        </div>
    </div>

    <div class="kpi-card card-episodes">
        <div class="kpi-icon-wrap cyan"><CinemaIcon Name="CinemaIconName.Play" Size="22" Filled="true" /></div>
        <div class="kpi-body">
            <span class="kpi-value">@(stats != null ? stats.TotalEpisodes.ToString("N0") : "...")</span>
            <span class="kpi-label">Tổng tập phim</span>
            <span class="kpi-change">@(stats?.TotalMovies ?? 0) phim lẻ</span>
        </div>
    </div>

    <div class="kpi-card card-users">
        <div class="kpi-icon-wrap purple"><CinemaIcon Name="CinemaIconName.Users" Size="22" /></div>
        <div class="kpi-body">
            <span class="kpi-value">@(stats != null ? stats.TotalUsers.ToString("N0") : "...")</span>
            <span class="kpi-label">Người dùng hệ thống</span>
            <span class="kpi-change">@(stats?.ActiveVipUsers ?? 0) VIP hoạt động</span>
        </div>
    </div>

    <div class="kpi-card card-rating">
        <div class="kpi-icon-wrap amber"><CinemaIcon Name="CinemaIconName.Star" Size="22" Filled="true" /></div>
        <div class="kpi-body">
            <span class="kpi-value">@(stats != null ? stats.AverageRating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) : "...")</span>
            <span class="kpi-label">Điểm đánh giá TB</span>
            <span class="kpi-change">@(stats?.TotalReviews ?? 0) lượt đánh giá</span>
        </div>
    </div>
</section>

<!-- Charts: Genre distribution + Member structure -->
<section class="admin-charts-grid">
    <div class="admin-chart-card">
        <div class="chart-header">
            <div class="chart-title-group">
                <h3><CinemaIcon Name="CinemaIconName.TrendingUp" Size="18" style="color: #e50914;" /> Phân bổ kho phim theo thể loại</h3>
                <p>Số phim đang có trong từng thể loại</p>
            </div>
            <span class="chart-stat-badge">
                <CinemaIcon Name="CinemaIconName.Film" Size="13" />
                <span>@((stats?.TotalMovies ?? 0) + (stats?.TotalSeries ?? 0) + (stats?.TotalAnime ?? 0)) phim trong kho</span>
            </span>
        </div>

        <div class="chart-svg-container">
            @{
                var genreStats = stats?.GenreDistribution ?? new Dictionary<string, int>();
                var genreEntries = genreStats.OrderByDescending(entry => entry.Value).ThenBy(entry => entry.Key).ToList();
                var genreMax = genreEntries.Count > 0 ? Math.Max(1, genreEntries.Max(entry => entry.Value)) : 1;
            }
            @if (genreEntries.Count == 0)
            {
                <div class="admin-table-state-msg">Chưa có dữ liệu thể loại để hiển thị.</div>
            }
            else
            {
                <ul class="admin-genre-bars">
                    @foreach (var entry in genreEntries)
                    {
                        var width = (entry.Value * 100.0 / genreMax).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
                        <li class="admin-genre-bar-row">
                            <span class="admin-genre-bar-label" title="@entry.Key">@entry.Key</span>
                            <span class="admin-genre-bar-track">
                                <span class="admin-genre-bar-fill" style="width: @width%;"></span>
                            </span>
                            <span class="admin-genre-bar-value font-mono-num">@entry.Value</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="admin-chart-card">
        <div class="chart-header">
            <div class="chart-title-group">
                <h3><CinemaIcon Name="CinemaIconName.Users" Size="18" style="color: var(--admin-accent-amber);" /> Cơ cấu Thành viên</h3>
                <p>Tỷ trọng hội viên VIP vs Tài khoản miễn phí</p>
            </div>
            <span class="chart-stat-badge amber">
                @(stats != null ? stats.TotalUsers : 0) Thành viên
            </span>
        </div>

        <div class="donut-chart-layout">
            @{
                var totalUsers = Math.Max(1, stats?.TotalUsers ?? 1);
                var vipUsers = stats?.ActiveVipUsers ?? 0;
                var freeUsers = Math.Max(0, totalUsers - vipUsers);
                var vipPct = (vipUsers * 100.0) / totalUsers;
                var circumference = 2 * Math.PI * 45;
                var vipStroke = (vipPct / 100.0) * circumference;
            }
            <div class="donut-visual-wrap">
                <svg viewBox="0 0 120 120">
                    <circle cx="60" cy="60" r="45" fill="transparent" stroke="#252936" stroke-width="14" />
                    <circle cx="60" cy="60" r="45" fill="transparent" stroke="var(--admin-accent-amber)" stroke-width="14"
                            stroke-dasharray="@vipStroke.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) @circumference.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)"
                            stroke-linecap="round" />
                </svg>
                <div class="donut-center-info">
                    <span class="donut-center-val">@vipPct.ToString("0")%</span>
                    <span class="donut-center-lbl">Tỷ lệ VIP</span>
                </div>
            </div>

            <div class="donut-legends-list">
                <div class="donut-legend-row">
                    <span class="legend-color-tag">
                        <span class="legend-dot amber"></span>
                        <span>Hội viên VIP</span>
                    </span>
                    <span class="legend-stat">
                        <strong class="legend-count">@vipUsers</strong>
                        <span class="legend-percent">(@vipPct.ToString("0")%)</span>
                    </span>
                </div>

                <div class="donut-legend-row">
                    <span class="legend-color-tag">
                        <span class="legend-dot purple"></span>
                        <span>Miễn phí</span>
                    </span>
                    <span class="legend-stat">
                        <strong class="legend-count">@freeUsers</strong>
                        <span class="legend-percent">(@((100 - vipPct).ToString("0"))%)</span>
                    </span>
                </div>

                <div class="donut-legend-row" style="border-top: 1px solid rgba(255,255,255,0.06); padding-top: 0.5rem; margin-top: 0.2rem;">
                    <span class="legend-color-tag">
                        <span class="legend-dot red"></span>
                        <span>Kho phim lẻ</span>
                    </span>
                    <span class="legend-stat">
                        <strong class="legend-count">@(stats?.TotalMovies ?? 0)</strong>
                    </span>
                </div>

                <div class="donut-legend-row">
                    <span class="legend-color-tag">
                        <span class="legend-dot cyan"></span>
                        <span>Phim bộ / Anime</span>
                    </span>
                    <span class="legend-stat">
                        <strong class="legend-count">@((stats?.TotalSeries ?? 0) + (stats?.TotalAnime ?? 0))</strong>
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Main content: Recent movies (full width) -->
<section class="admin-table-section" style="margin-bottom: 2rem;">
    <div class="section-title-bar">
        <div class="title-with-dropdown">
            <h2>Tác phẩm nổi bật &amp; gần đây</h2>
            <NavLink href="/admin/movies" class="widget-link-all">Xem tất cả kho phim →</NavLink>
        </div>
    </div>

    <div class="table-frame">
        @if (isLoading)
        {
            <div class="admin-table-state-msg">Đang tải dữ liệu từ API...</div>
        }
        else if (recentMovies.Count == 0)
        {
            <div class="admin-table-state-msg">Chưa có phim nào trong cơ sở dữ liệu.</div>
        }
        else
        {
            var pagedMovies = recentMovies.Take(6).ToList();
            <table class="admin-movies-table">
                <thead>
                    <tr>
                        <th>Tác phẩm</th>
                        <th>Định dạng</th>
                        <th>Chất lượng</th>
                        <th>Điểm</th>
                        <th>Năm</th>
                        <th style="text-align: right;">Quản lý tập</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in pagedMovies)
                    {
                        <tr>
                            <td class="td-movie-info">
                                <img src="@m.PosterUrl" alt="@m.Title" class="movie-thumb-mini" />
                                <div class="movie-name-group">
                                    <strong>@m.Title</strong>
                                    <small>@m.OriginalTitle</small>
                                </div>
                            </td>
                            <td>
                                <span class="status-pill @(m.Type == MovieType.Movie ? "status-green" : m.Type == MovieType.Series ? "status-blue" : "status-purple")">
                                    @(m.Type == MovieType.Movie ? "Phim lẻ" : m.Type == MovieType.Series ? "Phim bộ" : "Anime")
                                </span>
                            </td>
                            <td><span class="quality-badge-gold">@m.Quality</span></td>
                            <td><span class="rating-cell">★ @m.Rating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span></td>
                            <td class="td-time">
                                <span class="time-date">@m.ReleaseYear</span>
                                <span class="time-hour">@m.DurationMinutes p</span>
                            </td>
                            <td style="text-align: right;">
                                <NavLink href="@($"/admin/episodes/{m.Id}")" class="btn-action-icon" title="Quản lý tập phim">
                                    <CinemaIcon Name="CinemaIconName.List" Size="15" />
                                </NavLink>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>

<!-- Hoạt động gần đây: 3 section riêng -->
<section class="admin-table-section" style="margin-bottom: 1.5rem;">
    <div class="section-title-bar">
        <div class="title-with-dropdown">
            <h2>Đánh giá mới nhất</h2>
            <NavLink href="/admin/reviews" class="widget-link-all">Xem tất cả →</NavLink>
        </div>
    </div>
    <div class="table-frame" style="padding: 1rem;">
        @if (isLoading)
        {
            <div class="admin-table-state-msg">Đang tải...</div>
        }
        else if (stats?.RecentReviews is not { Count: > 0 })
        {
            <div class="admin-table-state-msg">Chưa có đánh giá nào.</div>
        }
        else
        {
            <ul class="admin-activity-list" style="margin: 0; padding: 0; list-style: none;">
                @foreach (var r in (stats?.RecentReviews ?? new List<AdminReviewDto>()).Take(5))
                {
                    <li class="activity-item">
                        <div class="activity-icon amber"><CinemaIcon Name="CinemaIconName.Star" Size="15" /></div>
                        <div class="activity-content">
                            <div><strong>@r.UserFullName</strong> đánh giá ★@r.Rating cho <em>@r.MovieTitle</em></div>
                            <div class="activity-comment-bubble">"@r.Comment"</div>
                            <small>@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</section>

<section class="admin-table-section" style="margin-bottom: 1.5rem;">
    <div class="section-title-bar">
        <div class="title-with-dropdown">
            <h2>Giao dịch mới nhất</h2>
            <NavLink href="/admin/vip" class="widget-link-all">Xem tất cả →</NavLink>
        </div>
    </div>
    <div class="table-frame" style="padding: 1rem;">
        @if (isLoading)
        {
            <div class="admin-table-state-msg">Đang tải...</div>
        }
        else if (stats?.RecentPayments is not { Count: > 0 })
        {
            <div class="admin-table-state-msg">Chưa có giao dịch nào.</div>
        }
        else
        {
            <ul class="admin-activity-list" style="margin: 0; padding: 0; list-style: none;">
                @foreach (var p in (stats?.RecentPayments ?? new List<PaymentDto>()).Take(5))
                {
                    <li class="activity-item">
                        <div class="activity-icon blue"><CinemaIcon Name="CinemaIconName.Crown" Size="15" /></div>
                        <div class="activity-content">
                            <div>Nâng cấp <strong>@p.PlanName</strong>: <strong style="color: var(--admin-accent-emerald);">@p.Amount.ToString("N0")đ</strong></div>
                            <div class="activity-order-bubble">Đơn hàng: @p.OrderCode</div>
                            <small>@p.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</section>

<section class="admin-table-section" style="margin-bottom: 2rem;">
    <div class="section-title-bar">
        <div class="title-with-dropdown">
            <h2>Kiểm toán gần đây</h2>
            <NavLink href="/admin/audit-logs" class="widget-link-all">Xem tất cả →</NavLink>
        </div>
    </div>
    <div class="table-frame" style="padding: 1rem;">
        @if (isLoading)
        {
            <div class="admin-table-state-msg">Đang tải...</div>
        }
        else if (recentAuditLogs.Count == 0)
        {
            <div class="admin-table-state-msg">Chưa có bản ghi kiểm toán nào.</div>
        }
        else
        {
            <ul class="admin-activity-list" style="margin: 0; padding: 0; list-style: none;">
                @foreach (var a in recentAuditLogs.Take(5))
                {
                    var chipClass = GetActionClass(a.Action);
                    <li class="activity-item">
                        <div class="activity-icon blue"><CinemaIcon Name="CinemaIconName.Shield" Size="15" /></div>
                        <div class="activity-content">
                            <div style="display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
                                <span class="audit-chip-mini @chipClass">@a.Action</span>
                                <span style="font-size: 0.76rem; color: #94a3b8;">@a.EntityType</span>
                            </div>
                            <div style="font-size: 0.8rem; color: var(--admin-text-body); margin-top: 0.2rem;">@a.Summary</div>
                            <small>@a.AdminEmail • @a.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</section>

@code {
    private AdminDashboardDto? stats;
    private SystemHealthDto? health;
    private List<MovieDetailDto> recentMovies = [];
    private List<AuditLogDto> recentAuditLogs = [];
    private bool isLoading = true;
    private string? actionAlert;
    private string? actionError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Auth.InitializeAsync();
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        if (!Auth.IsAdmin) return;
        isLoading = true;
        try
        {
            var statsTask = AdminApi.GetStatsAsync();
            var moviesTask = AdminApi.GetMoviesAsync();
            var healthTask = AdminApi.GetSystemHealthAsync();
            var auditTask = AdminApi.GetAuditLogsAsync(take: 4);
            await Task.WhenAll(statsTask, moviesTask, healthTask, auditTask);

            stats = await statsTask;
            recentMovies = await moviesTask;
            health = await healthTask;
            recentAuditLogs = await auditTask;
        }
        catch (Exception ex)
        {
            actionError = "Không thể tải số liệu tổng quan: " + ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        actionAlert = null;
        actionError = null;
        await LoadData();
        if (string.IsNullOrEmpty(actionError))
        {
            actionAlert = "Đã làm mới số liệu hệ thống thành công!";
        }
    }

    private static string GetActionClass(string action)
    {
        var upper = action.ToUpperInvariant();
        if (upper.Contains("DELETE") || upper.Contains("LOCK") || upper.Contains("XÓA")) return "delete";
        if (upper.Contains("CREATE") || upper.Contains("ADD") || upper.Contains("TẠO") || upper.Contains("THÊM")) return "create";
        if (upper.Contains("UPDATE") || upper.Contains("EDIT") || upper.Contains("SỬA")) return "update";
        if (upper.Contains("BULK") || upper.Contains("BATCH") || upper.Contains("LOẠT")) return "bulk";
        return "security";
    }

    public void Dispose()
    {
    }
}
