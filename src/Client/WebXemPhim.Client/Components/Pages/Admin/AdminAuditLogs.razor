@code {
    /// <summary>Bản ghi do máy chủ trả về cho trang hiện tại (đã phân trang server-side).</summary>
    private List<AuditLogDto> pageItems = new();

    /// <summary>Bản ghi hiển thị sau khi áp dụng các bộ lọc cục bộ (mức độ rủi ro / khung thời gian).</summary>
    private List<AuditLogDto> visibleLogs = new();

    /// <summary>Từ khóa đang gõ trong ô tìm kiếm.</summary>
    private string searchQuery = string.Empty;

    /// <summary>Từ khóa đã được áp dụng lên máy chủ.</summary>
    private string appliedQuery = string.Empty;

    private string? selectedEntityType = null;
    private string? selectedRiskLevel = null;
    private string timeHorizonFilter = "all";
    private int currentPage = 1;
    private int pageSize = 50;
    private int totalItems = 0;
    private bool isLoading = true;
    private bool isTimelineView = false;
    private bool hasLoadedLogs;
    private string? actionAlert;
    private string? actionError;
    private AuditLogDto? activeLog;
    private bool isCopied = false;

    // Tùy chỉnh bộ lọc: ẩn/hiện từng ô lọc, lưu lại theo trình duyệt.
    private const string FilterPrefsStorageKey = "cinemaflow_admin_audit_filter_prefs_v2";
    private static readonly (string Key, string Label)[] FilterOptions =
    [
        ("entity", "Thực thể quản trị"),
        ("risk", "Mức độ rủi ro"),
        ("time", "Khung thời gian")
    ];
    // Mặc định ban đầu: chưa bật ô lọc nào (tick trống) — admin tự chọn ô cần dùng.
    private readonly HashSet<string> hiddenFilters = [.. FilterOptions.Select(o => o.Key)];
    private bool showFilterSettings;
    private bool filtersCollapsed;

    // Debounce 400ms cho ô tìm kiếm
    private bool isSearchPending = false;
    private CancellationTokenSource? searchDebounceCts;

    // Sentinel Auto-Refresh
    private int autoRefreshIntervalSeconds = 0;
    private System.Threading.Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        Auth.OnChange += HandleAuthChanged;

        // AuthState.InitializeAsync is idempotent: the admin layout may already be restoring
        // the session. Awaiting it here prevents a deep link or hard refresh from bouncing a
        // valid admin to /login before the session has been restored.
        await Auth.InitializeAsync();
        await LoadFilterPrefsAsync();
        await EnsureAccessAndLoadAsync();
    }

    private async Task EnsureAccessAndLoadAsync()
    {
        // While the API is unreachable the layout shows its reconnect gate. Do not redirect
        // and do not fetch: the session is still valid, we simply cannot verify it yet.
        if (Auth.ApiUnavailable) return;

        if (!Auth.IsAuthenticated || !Auth.IsAdmin)
        {
            Nav.NavigateTo("/login?returnUrl=/admin/audit-logs");
            return;
        }

        if (hasLoadedLogs) return;
        hasLoadedLogs = true;
        await LoadAuditLogsAsync();
    }

    private void HandleAuthChanged()
    {
        InvokeAsync(async () =>
        {
            await EnsureAccessAndLoadAsync();
            StateHasChanged();
        });
    }

    private async Task LoadAuditLogsAsync(bool silent = false)
    {
        if (!Auth.IsAdmin) return;
        if (!silent)
        {
            isLoading = true;
            actionAlert = null;
            actionError = null;
            StateHasChanged();
        }

        try
        {
            var result = await AdminApi.GetAuditLogsPagedAsync(
                query: appliedQuery,
                entityType: selectedEntityType,
                page: currentPage,
                pageSize: pageSize);

            pageItems = result.Items ?? new List<AuditLogDto>();
            totalItems = result.TotalItems;
            ApplyClientFilters();
        }
        catch (Exception ex)
        {
            if (!silent)
            {
                actionError = $"Không thể tải dữ liệu nhật ký hệ thống: {ex.Message}";
            }
            pageItems = new List<AuditLogDto>();
            visibleLogs = new List<AuditLogDto>();
            totalItems = 0;
        }
        finally
        {
            if (!silent)
            {
                isLoading = false;
            }
            StateHasChanged();
        }
    }

    /// <summary>
    /// Áp dụng các bộ lọc chỉ máy chủ chưa hỗ trợ (mức độ rủi ro, khung thời gian) trên tập bản ghi của trang hiện tại.
    /// </summary>
    private void ApplyClientFilters()
    {
        IEnumerable<AuditLogDto> result = pageItems;

        // 1. Filter by Risk Level
        if (!string.IsNullOrWhiteSpace(selectedRiskLevel))
        {
            result = selectedRiskLevel switch
            {
                "danger" => result.Where(l => ClassifyAction(l.Action) == AuditActionCategory.Danger),
                "create" => result.Where(l => ClassifyAction(l.Action) == AuditActionCategory.Create),
                "update" => result.Where(l => ClassifyAction(l.Action) == AuditActionCategory.Update),
                "other" => result.Where(l => ClassifyAction(l.Action) == AuditActionCategory.Other),
                _ => result
            };
        }

        // 2. Filter by Time Horizon
        if (timeHorizonFilter != "all")
        {
            var now = DateTimeOffset.UtcNow;
            result = timeHorizonFilter switch
            {
                "24h" => result.Where(l => (now - l.Timestamp.ToUniversalTime()).TotalHours <= 24),
                "7d" => result.Where(l => (now - l.Timestamp.ToUniversalTime()).TotalDays <= 7),
                "30d" => result.Where(l => (now - l.Timestamp.ToUniversalTime()).TotalDays <= 30),
                _ => result
            };
        }

        visibleLogs = result.ToList();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? string.Empty;
        isSearchPending = !string.Equals(searchQuery.Trim(), appliedQuery.Trim(), StringComparison.Ordinal);
        ScheduleSearchApply();
    }

    /// <summary>Hủy lịch debounce cũ và hẹn lại 400ms để áp dụng từ khóa tìm kiếm.</summary>
    private void ScheduleSearchApply()
    {
        var previous = searchDebounceCts;
        searchDebounceCts = null;
        if (previous is not null)
        {
            try { previous.Cancel(); }
            catch (ObjectDisposedException) { /* đã được giải phóng ở task cũ */ }
        }

        var cts = new CancellationTokenSource();
        searchDebounceCts = cts;
        _ = RunSearchDebounceAsync(cts);
    }

    private async Task RunSearchDebounceAsync(CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(400, cts.Token);
            if (cts.IsCancellationRequested) return;

            await InvokeAsync(async () =>
            {
                if (cts.IsCancellationRequested) return;
                await ApplySearchQueryAsync();
            });
        }
        catch (OperationCanceledException)
        {
            // Người dùng vừa gõ thêm => huỷ lần debounce trước.
        }
        finally
        {
            if (ReferenceEquals(searchDebounceCts, cts))
            {
                searchDebounceCts = null;
            }
            cts.Dispose();
        }
    }

    private async Task ApplySearchQueryAsync()
    {
        isSearchPending = false;

        if (string.Equals(appliedQuery, searchQuery, StringComparison.Ordinal))
        {
            StateHasChanged();
            return;
        }

        appliedQuery = searchQuery;
        currentPage = 1;
        await LoadAuditLogsAsync();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            var cts = searchDebounceCts;
            searchDebounceCts = null;
            if (cts is not null)
            {
                try { cts.Cancel(); }
                catch (ObjectDisposedException) { }
            }

            appliedQuery = searchQuery;
            isSearchPending = false;
            currentPage = 1;
            await LoadAuditLogsAsync();
        }
    }

    private async Task ClearSearch()
    {
        var cts = searchDebounceCts;
        searchDebounceCts = null;
        if (cts is not null)
        {
            try { cts.Cancel(); }
            catch (ObjectDisposedException) { }
        }

        searchQuery = string.Empty;
        appliedQuery = string.Empty;
        isSearchPending = false;
        currentPage = 1;
        await LoadAuditLogsAsync();
    }

    private async Task FilterByEntityType(string? entityType)
    {
        selectedEntityType = entityType;
        currentPage = 1;
        await LoadAuditLogsAsync();
    }

    private void FilterByRiskLevel(string? risk)
    {
        selectedRiskLevel = risk;
        ApplyClientFilters();
        StateHasChanged();
    }

    private void OnTimeHorizonChanged(ChangeEventArgs e)
    {
        timeHorizonFilter = e.Value?.ToString() ?? "all";
        ApplyClientFilters();
        StateHasChanged();
    }

    private async Task HandlePageChanged(int page)
    {
        if (page == currentPage) return;
        currentPage = page;
        await LoadAuditLogsAsync();
    }

    private async Task HandlePageSizeChanged(int size)
    {
        if (size == pageSize) return;
        pageSize = size;
        currentPage = 1;
        await LoadAuditLogsAsync();
    }

    private void OnAutoRefreshChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var seconds))
        {
            autoRefreshIntervalSeconds = seconds;
            SetupRefreshTimer();
        }
    }

    private void SetupRefreshTimer()
    {
        refreshTimer?.Dispose();
        refreshTimer = null;

        if (autoRefreshIntervalSeconds > 0)
        {
            refreshTimer = new System.Threading.Timer(async _ =>
            {
                await InvokeAsync(async () =>
                {
                    await LoadAuditLogsAsync(silent: true);
                });
            }, null, TimeSpan.FromSeconds(autoRefreshIntervalSeconds), TimeSpan.FromSeconds(autoRefreshIntervalSeconds));
        }
    }

    private async Task ResetFilters()
    {
        searchQuery = string.Empty;
        appliedQuery = string.Empty;
        isSearchPending = false;
        selectedEntityType = null;
        selectedRiskLevel = null;
        timeHorizonFilter = "all";
        currentPage = 1;
        await LoadAuditLogsAsync();
    }

    // ---------- Tùy chỉnh bộ lọc ----------

    private void ToggleFilterSettings()
    {
        showFilterSettings = !showFilterSettings;
    }

    private void CloseFilterSettings()
    {
        showFilterSettings = false;
    }

    private void OnFilterSettingsKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") showFilterSettings = false;
    }

    private async Task ToggleFilterCollapse()
    {
        filtersCollapsed = !filtersCollapsed;
        await SaveFilterPrefsAsync();
    }

    /// <summary>Bật/tắt một ô lọc. Ẩn ô lọc sẽ xóa luôn giá trị đang chọn để tránh lọc ngầm.</summary>
    private async Task SetFilterVisibility(string key, bool visible)
    {
        // Bỏ qua sự kiện phát sinh khi popover đã đóng.
        if (!showFilterSettings) return;

        if (visible) hiddenFilters.Remove(key);
        else hiddenFilters.Add(key);

        var cleared = !visible && ClearFilterValue(key);
        await SaveFilterPrefsAsync();

        if (cleared)
        {
            if (key == "entity") await FilterByEntityType(null);
            else ApplyClientFilters();
        }

        StateHasChanged();
    }

    /// <summary>Xóa giá trị của bộ lọc vừa bị ẩn. Trả về true nếu thực sự có thay đổi.</summary>
    private bool ClearFilterValue(string key)
    {
        switch (key)
        {
            case "entity" when !string.IsNullOrEmpty(selectedEntityType):
                selectedEntityType = null;
                return true;
            case "risk" when !string.IsNullOrEmpty(selectedRiskLevel):
                selectedRiskLevel = null;
                return true;
            case "time" when timeHorizonFilter != "all":
                timeHorizonFilter = "all";
                return true;
            default:
                return false;
        }
    }

    private async Task ShowAllFiltersAsync()
    {
        if (hiddenFilters.Count == 0) return;
        hiddenFilters.Clear();
        await SaveFilterPrefsAsync();
    }

    /// <summary>Đọc lại lựa chọn ẩn/hiện bộ lọc đã lưu trong localStorage của trình duyệt.</summary>
    private async Task LoadFilterPrefsAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("adminTools.getStoredJson", FilterPrefsStorageKey);
            if (string.IsNullOrWhiteSpace(json)) return;

            var prefs = System.Text.Json.JsonSerializer.Deserialize<AuditFilterPrefs>(json);
            if (prefs is null) return;

            hiddenFilters.Clear();
            foreach (var key in prefs.Hidden.Where(k => FilterOptions.Any(o => o.Key == k)))
            {
                hiddenFilters.Add(key);
            }
            filtersCollapsed = prefs.Collapsed;
        }
        catch
        {
            // Tùy chọn hiển thị chỉ là tiện ích: localStorage bị chặn hoặc dữ liệu hỏng thì dùng mặc định.
        }
    }

    private async Task SaveFilterPrefsAsync()
    {
        try
        {
            var prefs = new AuditFilterPrefs(hiddenFilters.ToList(), filtersCollapsed);
            var json = System.Text.Json.JsonSerializer.Serialize(prefs);
            await JS.InvokeVoidAsync("adminTools.setStoredJson", FilterPrefsStorageKey, json);
        }
        catch
        {
            // Không lưu được thì thôi, không chặn thao tác của admin.
        }
    }

    private sealed record AuditFilterPrefs(List<string> Hidden, bool Collapsed);

    private void OpenDetailsModal(AuditLogDto log)
    {
        activeLog = log;
        isCopied = false;
    }

    private void CloseDetailsModal()
    {
        activeLog = null;
        isCopied = false;
    }

    private async Task CopyPayloadToClipboard()
    {
        if (activeLog?.DetailsJson == null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", activeLog.DetailsJson);
            isCopied = true;
            StateHasChanged();
            await Task.Delay(2000);
            isCopied = false;
            StateHasChanged();
        }
        catch
        {
            // Ignore clipboard errors
        }
    }

    private async Task ExportLogsJsonAsync()
    {
        if (!visibleLogs.Any())
        {
            actionError = "Không có bản ghi nào trên trang hiện tại để xuất JSON. Hãy xóa bớt bộ lọc hoặc chuyển trang.";
            return;
        }
        try
        {
            var json = JsonSerializer.Serialize(visibleLogs, new JsonSerializerOptions { WriteIndented = true });
            var fileName = $"cinemaflow_audit_logs_{DateTime.UtcNow:yyyyMMdd_HHmmss}.json";
            await JS.InvokeVoidAsync("adminTools.downloadFile", fileName, "application/json", json);
            actionAlert = $"Đã xuất {visibleLogs.Count} bản ghi nhật ký (trang {currentPage}) dạng JSON.";
        }
        catch (Exception ex)
        {
            actionError = $"Lỗi khi xuất file JSON: {ex.Message}";
        }
    }

    private async Task ExportLogsCsvAsync()
    {
        if (!visibleLogs.Any())
        {
            actionError = "Không có bản ghi nào trên trang hiện tại để xuất CSV. Hãy xóa bớt bộ lọc hoặc chuyển trang.";
            return;
        }
        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine("TimestampUtc,AdminEmail,Action,EntityType,EntityId,Summary");
            foreach (var l in visibleLogs)
            {
                sb.AppendLine(CsvSecurity.FormatRow(
                    l.Timestamp.ToString("O"), l.AdminEmail, l.Action, l.EntityType, l.EntityId, l.Summary));
            }
            var fileName = $"cinemaflow_audit_logs_{DateTime.UtcNow:yyyyMMdd_HHmmss}.csv";
            await JS.InvokeVoidAsync("adminTools.downloadFile", fileName, "text/csv;charset=utf-8", sb.ToString());
            actionAlert = $"Đã xuất {visibleLogs.Count} bản ghi nhật ký (trang {currentPage}) dạng CSV.";
        }
        catch (Exception ex)
        {
            actionError = $"Lỗi khi xuất file CSV: {ex.Message}";
        }
    }

    private string FormatJson(string? rawJson)
    {
        if (string.IsNullOrWhiteSpace(rawJson)) return "{}";
        try
        {
            using var doc = JsonDocument.Parse(rawJson);
            return JsonSerializer.Serialize(doc.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return rawJson;
        }
    }

    private enum AuditActionCategory { Other, Create, Update, Danger }

    /// <summary>
    /// Phân loại mỗi thao tác vào đúng một nhóm để các chip và thanh phân bổ
    /// không đếm trùng (ví dụ UPDATE_ROLE trước đây vừa là "Sửa" vừa là "Rủi ro").
    /// </summary>
    private static AuditActionCategory ClassifyAction(string action)
    {
        if (IsDangerAction(action)) return AuditActionCategory.Danger;
        if (IsCreateAction(action)) return AuditActionCategory.Create;
        if (IsUpdateAction(action)) return AuditActionCategory.Update;
        return AuditActionCategory.Other;
    }

    private int CountActions(AuditActionCategory category) =>
        pageItems.Count(l => ClassifyAction(l.Action) == category);

    private static bool IsCreateAction(string action) =>
        action.Contains("CREATE", StringComparison.OrdinalIgnoreCase) ||
        action.Contains("ADD", StringComparison.OrdinalIgnoreCase) ||
        action.Contains("GENERATE", StringComparison.OrdinalIgnoreCase) ||
        action.Contains("CLONE", StringComparison.OrdinalIgnoreCase);

    private static bool IsUpdateAction(string action) =>
        action.Contains("UPDATE", StringComparison.OrdinalIgnoreCase) ||
        action.Contains("EDIT", StringComparison.OrdinalIgnoreCase) ||
        action.Contains("TOGGLE", StringComparison.OrdinalIgnoreCase) ||
        action.Contains("REPLY", StringComparison.OrdinalIgnoreCase);

    private static bool IsDangerAction(string action) =>
        action.Contains("DELETE", StringComparison.OrdinalIgnoreCase) ||
        action.Contains("LOCK", StringComparison.OrdinalIgnoreCase) ||
        action.Contains("BAN", StringComparison.OrdinalIgnoreCase) ||
        action.Contains("ROLE", StringComparison.OrdinalIgnoreCase);

    private double GetActionPercent(AuditActionCategory category)
    {
        if (!pageItems.Any()) return 0;
        var count = pageItems.Count(l => ClassifyAction(l.Action) == category);
        return Math.Round((double)count / pageItems.Count * 100.0, 1);
    }

    private string GetActionCssClass(string action)
    {
        if (string.IsNullOrEmpty(action)) return "audit-action-bulk";
        if (IsCreateAction(action)) return "audit-action-create";
        if (IsDangerAction(action)) return "audit-action-delete";
        if (action.Contains("PROBE", StringComparison.OrdinalIgnoreCase)) return "audit-action-probe";
        if (action.Contains("BULK", StringComparison.OrdinalIgnoreCase) || action.Contains("BATCH", StringComparison.OrdinalIgnoreCase)) return "audit-action-bulk";
        return "audit-action-update";
    }

    private string GetNodeCssClass(string action)
    {
        if (IsDangerAction(action)) return "danger";
        if (IsCreateAction(action)) return "success";
        if (action.Contains("PROBE", StringComparison.OrdinalIgnoreCase)) return "probe";
        if (action.Contains("BULK", StringComparison.OrdinalIgnoreCase) ||
            action.Contains("BATCH", StringComparison.OrdinalIgnoreCase) ||
            action.Contains("APPROVE", StringComparison.OrdinalIgnoreCase)) return "warning";
        return "update";
    }

    private string GetActionSymbol(string action)
    {
        if (IsDangerAction(action)) return "!";
        if (IsCreateAction(action)) return "+";
        if (action.Contains("PROBE", StringComparison.OrdinalIgnoreCase)) return "P";
        if (action.Contains("BULK", StringComparison.OrdinalIgnoreCase)) return "*";
        return "~";
    }

    private string GetRelativeTime(DateTimeOffset time)
    {
        var diff = DateTimeOffset.UtcNow - time.ToUniversalTime();
        if (diff.TotalSeconds < 60) return "vừa xong";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} phút trước";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} giờ trước";
        if (diff.TotalDays < 30) return $"{(int)diff.TotalDays} ngày trước";
        return time.ToLocalTime().ToString("dd/MM/yyyy");
    }

    public void Dispose()
    {
        Auth.OnChange -= HandleAuthChanged;
        refreshTimer?.Dispose();

        var cts = searchDebounceCts;
        searchDebounceCts = null;
        if (cts is not null)
        {
            try { cts.Cancel(); }
            catch (ObjectDisposedException) { }
            cts.Dispose();
        }
    }
}
