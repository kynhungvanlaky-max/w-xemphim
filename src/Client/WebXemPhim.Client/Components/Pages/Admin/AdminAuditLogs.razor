@page "/admin/audit-logs"
@layout WebXemPhim.Client.Components.Layout.AdminLayout
@using WebXemPhim.Shared.Models
@using WebXemPhim.Client.Components.Icons
@using WebXemPhim.Client.Services
@using System.Text.Json
@inject NavigationManager Nav
@inject AuthState Auth
@inject IAdminApiClient AdminApi
@inject IJSRuntime JS
@implements IDisposable

<CinemaPageTitle>Nhật ký hệ thống (Audit Trail) - CinemaFlow Cockpit</CinemaPageTitle>

<!-- Topbar -->
<header class="admin-topbar">
    <div class="topbar-title-group">
        <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
            <h1 class="topbar-title">Nhật ký Hệ thống &amp; Giám sát (Audit Trail)</h1>
            @if (autoRefreshIntervalSeconds > 0)
            {
                <span class="sentinel-badge">
                    <span class="sentinel-pulse-dot"></span> SENTINEL LIVE (@autoRefreshIntervalSeconds s)
                </span>
            }
            else
            {
                <span class="cockpit-pulse-badge">
                    <span class="pulse-dot"></span> COCKPIT AUDIT
                </span>
            }
        </div>
        <p class="topbar-subtitle">Ghi vết thời gian thực mọi thao tác quản trị nhạy cảm: cập nhật phim, phân quyền, cấu hình luồng phát và duyệt thanh toán</p>
    </div>

    <div class="topbar-actions">
        <div class="topbar-search-pill">
            <CinemaIcon Name="CinemaIconName.Search" Size="16" Class="search-icon" />
            <input type="text"
                   placeholder="Tìm theo quản trị viên, hành động, ID..."
                   value="@searchQuery"
                   @oninput="OnSearchInput"
                   @onkeydown="HandleSearchKeyDown" />
            @if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                <button type="button" class="search-clear-btn" @onclick="ClearSearch" title="Xóa tìm kiếm" aria-label="Xóa tìm kiếm">&times;</button>
            }
        </div>

        <!-- Auto Refresh Sentinel Selector -->
        <div class="audit-auto-refresh-selector">
            <CinemaIcon Name="CinemaIconName.Clock" Size="14" />
            <span>Tự làm mới:</span>
            <select class="audit-refresh-select" value="@autoRefreshIntervalSeconds" @onchange="OnAutoRefreshChanged">
                <option value="0">Tắt</option>
                <option value="5">Mỗi 5 giây</option>
                <option value="15">Mỗi 15 giây</option>
                <option value="30">Mỗi 30 giây</option>
            </select>
        </div>

        <button type="button" class="action-btn secondary" @onclick="() => LoadAuditLogsAsync()" title="Làm mới nhật ký ngay">
            <CinemaIcon Name="CinemaIconName.Refresh" Size="16" />
            <span>Làm mới</span>
        </button>

        <button type="button" class="action-btn secondary" @onclick="ExportLogsJsonAsync" title="Xuất dữ liệu JSON của trang đang xem">
            <CinemaIcon Name="CinemaIconName.Bookmark" Size="16" />
            <span>Xuất JSON</span>
        </button>

        <button type="button" class="action-btn secondary" @onclick="ExportLogsCsvAsync" title="Xuất file CSV của trang đang xem">
            <CinemaIcon Name="CinemaIconName.Bookmark" Size="16" />
            <span>Xuất CSV</span>
        </button>
    </div>
</header>

@if (!string.IsNullOrEmpty(actionAlert))
{
    <div class="form-alert success" style="margin-bottom: 1.5rem;" role="status">
        @actionAlert
    </div>
}

@if (!string.IsNullOrEmpty(actionError))
{
    <div class="form-alert error" style="margin-bottom: 1.5rem;" role="alert">
        @actionError
    </div>
}

<!-- Streamlined Cockpit Telemetry & Mini-Distribution Ribbon (Compact Executive Grade) -->
<section class="audit-streamlined-bar">
    <div class="audit-telemetry-chips">
        <div class="audit-metric-chip @(string.IsNullOrEmpty(selectedRiskLevel) ? "active" : "")" @onclick='() => FilterByRiskLevel(null)' title="Tổng số bản ghi nhật ký khớp từ khóa và loại đối tượng đang lọc">
            <CinemaIcon Name="CinemaIconName.Shield" Size="13" />
            <span>Tổng khớp bộ lọc:</span>
            <strong class="font-mono-num">@totalItems</strong>
        </div>
        <div class="audit-metric-chip static" title="Số bản ghi đang tải ở trang hiện tại">
            <CinemaIcon Name="CinemaIconName.List" Size="13" />
            <span>Đang tải:</span>
            <strong class="font-mono-num">@pageItems.Count</strong>
        </div>
        <div class="audit-metric-chip create @(selectedRiskLevel == "create" ? "active" : "")" @onclick='() => FilterByRiskLevel("create")' title="Lọc các thao tác Tạo mới (+ADD) trong @pageItems.Count bản ghi đang tải">
            <CinemaIcon Name="CinemaIconName.Plus" Size="13" />
            <span>Tạo mới:</span>
            <strong class="font-mono-num">@CountActions(AuditActionCategory.Create)</strong>
        </div>
        <div class="audit-metric-chip update @(selectedRiskLevel == "update" ? "active" : "")" @onclick='() => FilterByRiskLevel("update")' title="Lọc các thao tác Cập nhật / Sửa trong @pageItems.Count bản ghi đang tải">
            <CinemaIcon Name="CinemaIconName.Refresh" Size="13" />
            <span>Sửa:</span>
            <strong class="font-mono-num">@CountActions(AuditActionCategory.Update)</strong>
        </div>
        <div class="audit-metric-chip danger @(selectedRiskLevel == "danger" ? "active" : "")" @onclick='() => FilterByRiskLevel("danger")' title="Lọc các thao tác Rủi ro cao (Xóa / Khóa) trong @pageItems.Count bản ghi đang tải">
            <CinemaIcon Name="CinemaIconName.Trash" Size="13" />
            <span>Rủi ro:</span>
            <strong class="font-mono-num">@CountActions(AuditActionCategory.Danger)</strong>
        </div>
        <div class="audit-metric-chip batch @(selectedRiskLevel == "other" ? "active" : "")" @onclick='() => FilterByRiskLevel("other")' title="Lọc các thao tác còn lại (duyệt, đo kiểm, hàng loạt...) trong @pageItems.Count bản ghi đang tải">
            <CinemaIcon Name="CinemaIconName.Play" Size="13" />
            <span>Khác:</span>
            <strong class="font-mono-num">@CountActions(AuditActionCategory.Other)</strong>
        </div>
    </div>

    @if (pageItems.Any())
    {
        <div class="audit-mini-distribution" title="Phân bổ trong @pageItems.Count bản ghi đang tải: Tạo mới @GetActionPercent(AuditActionCategory.Create)% | Sửa @GetActionPercent(AuditActionCategory.Update)% | Rủi ro @GetActionPercent(AuditActionCategory.Danger)% | Khác @GetActionPercent(AuditActionCategory.Other)%">
            <div class="audit-mini-track">
                <div class="track-seg create" style="width: @(GetActionPercent(AuditActionCategory.Create))%;"></div>
                <div class="track-seg update" style="width: @(GetActionPercent(AuditActionCategory.Update))%;"></div>
                <div class="track-seg delete" style="width: @(GetActionPercent(AuditActionCategory.Danger))%;"></div>
                <div class="track-seg bulk" style="width: @(GetActionPercent(AuditActionCategory.Other))%;"></div>
            </div>
            <span class="audit-mini-legend font-mono-num">
                +@(GetActionPercent(AuditActionCategory.Create))% / ~@(GetActionPercent(AuditActionCategory.Update))% / -@(GetActionPercent(AuditActionCategory.Danger))%
            </span>
        </div>
    }
</section>

<section class="admin-table-section">
    <!-- Streamlined Header & Unified Filter Suite -->
    <div class="cockpit-filter-suite" style="margin-bottom: 1rem;">
        <div class="filter-suite-top">
            <div style="display: flex; align-items: center; gap: 0.85rem; flex-wrap: wrap;">
                <h2 style="font-size: 1.05rem; margin: 0; font-weight: 700;">Nhật ký thao tác</h2>

                <!-- View Mode Toggle -->
                <div class="view-mode-toggle">
                    <button type="button" class="view-mode-btn @(!isTimelineView ? "active" : "")" @onclick="() => isTimelineView = false" title="Xem dạng bảng chi tiết">
                        <CinemaIcon Name="CinemaIconName.List" Size="13" />
                        <span>Bảng</span>
                    </button>
                    <button type="button" class="view-mode-btn @(isTimelineView ? "active" : "")" @onclick="() => isTimelineView = true" title="Xem dạng dòng thời gian trực quan">
                        <CinemaIcon Name="CinemaIconName.Clock" Size="13" />
                        <span>Dòng thời gian</span>
                    </button>
                </div>
            </div>

            <div class="filter-suite-tools">
                <div class="filter-count-chip">
                    <span>Trang @currentPage: hiển thị <strong>@visibleLogs.Count</strong> / @pageItems.Count bản ghi đang tải &middot; tổng hệ thống <strong>@totalItems</strong></span>
                </div>

                <div class="filter-settings-anchor">
                    <button type="button"
                            class="btn-filter-util @(showFilterSettings ? "is-active" : "")"
                            aria-haspopup="true"
                            aria-expanded="@(showFilterSettings ? "true" : "false")"
                            title="Chọn bộ lọc muốn hiển thị"
                            @onclick="ToggleFilterSettings">
                        <CinemaIcon Name="CinemaIconName.Settings" Size="13" />
                        <span>Bộ lọc</span>
                        @if (hiddenFilters.Count > 0 && hiddenFilters.Count < FilterOptions.Length)
                        {
                            <span class="filter-util-badge" title="@($"{hiddenFilters.Count} bộ lọc đang ẩn")">@hiddenFilters.Count</span>
                        }
                    </button>

                    @if (showFilterSettings)
                    {
                        <div class="filter-settings-backdrop" @onclick="CloseFilterSettings"></div>
                        <div class="filter-settings-panel" role="group" aria-label="Tùy chỉnh bộ lọc hiển thị" @onkeydown="OnFilterSettingsKeyDown">
                            <div class="filter-settings-head">
                                <strong>Hiển thị bộ lọc</strong>
                                <button type="button" class="btn-filter-util-reset" disabled="@(hiddenFilters.Count == 0)" @onclick="ShowAllFiltersAsync">
                                    Hiện tất cả
                                </button>
                            </div>
                            <p class="filter-settings-hint">Bỏ tick để ẩn bộ lọc không dùng. Giá trị đang chọn của bộ lọc bị ẩn sẽ được xóa để danh sách không bị lọc ngầm.</p>
                            <div class="filter-settings-list">
                                @foreach (var option in FilterOptions)
                                {
                                    <label class="filter-settings-item">
                                        <input type="checkbox"
                                               checked="@(!hiddenFilters.Contains(option.Key))"
                                               @onclick="() => SetFilterVisibility(option.Key, hiddenFilters.Contains(option.Key))" />
                                        <span>@option.Label</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </div>

                <button type="button"
                        class="btn-filter-util"
                        title="@(filtersCollapsed ? "Mở rộng khối bộ lọc" : "Thu gọn khối bộ lọc")"
                        aria-expanded="@(filtersCollapsed ? "false" : "true")"
                        @onclick="ToggleFilterCollapse">
                    <CinemaIcon Name="@(filtersCollapsed ? CinemaIconName.ChevronRight : CinemaIconName.ChevronDown)" Size="13" />
                    <span>@(filtersCollapsed ? "Mở rộng" : "Thu gọn")</span>
                </button>
            </div>
        </div>

        <!-- Filter Controls Grid (từng ô có thể bật/tắt) -->
        @if (!filtersCollapsed)
        {
            <div class="filter-controls-grid">
                @if (hiddenFilters.Count == FilterOptions.Length)
                {
                    <p class="filter-all-hidden-note">
                        Chưa bật ô lọc nào. Mở <strong>Bộ lọc</strong> và tick những ô bạn cần dùng.
                    </p>
                }

                @if (!hiddenFilters.Contains("entity"))
                {
                    <div class="filter-control-item">
                        <label class="filter-label">Thực thể quản trị</label>
                        <select class="admin-select-picker" value="@(selectedEntityType ?? "")" @onchange="e => FilterByEntityType(string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString())">
                            <option value="">Tất cả thực thể</option>
                            <option value="Movie">🎬 Phim</option>
                            <option value="Episode">📺 Tập phim</option>
                            <option value="StreamSource">⚡ Nguồn Stream</option>
                            <option value="User">👤 Người dùng</option>
                            <option value="Payment">💳 Giao dịch VIP</option>
                            <option value="Review">⭐ Đánh giá</option>
                        </select>
                    </div>
                }

                @if (!hiddenFilters.Contains("risk"))
                {
                    <div class="filter-control-item">
                        <label class="filter-label">Mức độ rủi ro</label>
                        <select class="admin-select-picker" value="@(selectedRiskLevel ?? "")" @onchange="e => FilterByRiskLevel(string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString())">
                            <option value="">Tất cả mức độ</option>
                            <option value="danger">⚠ Rủi ro cao (Xóa / Khóa)</option>
                            <option value="create">+ Tạo mới &amp; Thêm</option>
                            <option value="update">✎ Cập nhật &amp; Sửa</option>
                            <option value="other">⚡ Khác (duyệt, đo kiểm, hàng loạt)</option>
                        </select>
                    </div>
                }

                @if (!hiddenFilters.Contains("time"))
                {
                    <div class="filter-control-item">
                        <label class="filter-label">Khung thời gian</label>
                        <select class="admin-select-picker" value="@timeHorizonFilter" @onchange="OnTimeHorizonChanged">
                            <option value="all">Toàn bộ thời gian</option>
                            <option value="24h">Trong 24 giờ qua</option>
                            <option value="7d">Trong 7 ngày qua</option>
                            <option value="30d">Trong 30 ngày qua</option>
                        </select>
                    </div>
                }
            </div>
        }

        <p class="audit-filter-scope-note">
            &bull; Tìm kiếm &amp; <strong>Thực thể</strong> được máy chủ áp dụng (phân trang toàn hệ thống).
            &bull; <strong>Mức độ rủi ro</strong> &amp; <strong>Khung thời gian</strong> được áp dụng cục bộ trên @pageItems.Count bản ghi của trang @currentPage (máy chủ chưa hỗ trợ hai bộ lọc này).
        </p>

        <!-- Active Filter Strip & Clear All -->
        @if (!string.IsNullOrEmpty(selectedEntityType) || !string.IsNullOrEmpty(selectedRiskLevel) || timeHorizonFilter != "all" || !string.IsNullOrEmpty(searchQuery) || isSearchPending)
        {
            <div class="filter-active-strip">
                <span class="active-filter-title">Bộ lọc đang áp dụng:</span>
                @if (!string.IsNullOrEmpty(selectedEntityType))
                {
                    <span class="filter-pill-tag">
                        <span>Thực thể: @selectedEntityType</span>
                        <button type="button" @onclick="() => FilterByEntityType(null)">&times;</button>
                    </span>
                }
                @if (!string.IsNullOrEmpty(selectedRiskLevel))
                {
                    <span class="filter-pill-tag">
                        <span>Mức độ: @(selectedRiskLevel == "danger" ? "Rủi ro cao" : selectedRiskLevel == "create" ? "Tạo mới" : selectedRiskLevel == "update" ? "Cập nhật" : "Khác")</span>
                        <button type="button" @onclick="() => FilterByRiskLevel(null)">&times;</button>
                    </span>
                }
                @if (timeHorizonFilter != "all")
                {
                    <span class="filter-pill-tag">
                        <span>Thời gian: @(timeHorizonFilter == "24h" ? "24h qua" : timeHorizonFilter == "7d" ? "7 ngày qua" : "30 ngày qua")</span>
                        <button type="button" @onclick='() => { timeHorizonFilter = "all"; ApplyClientFilters(); }'>&times;</button>
                    </span>
                }
                @if (isSearchPending)
                {
                    <span class="filter-pill-tag pending" title="Từ khóa sẽ tự áp dụng sau 400ms, hoặc nhấn Enter để áp dụng ngay">
                        <span>Đang tìm…</span>
                        <button type="button" @onclick="ClearSearch">&times;</button>
                    </span>
                }
                else if (!string.IsNullOrEmpty(appliedQuery))
                {
                    <span class="filter-pill-tag">
                        <span>Tìm kiếm: "@appliedQuery"</span>
                        <button type="button" @onclick="ClearSearch">&times;</button>
                    </span>
                }

                <button type="button" class="btn-clear-all-filters" @onclick="ResetFilters">
                    Xóa tất cả bộ lọc
                </button>
            </div>
        }
    </div>

    @if (isLoading)
    {
        <div style="display: flex; flex-direction: column; gap: 0.75rem; padding: 1.5rem 0;">
            <div class="cockpit-skeleton-card" style="height: 52px;"></div>
            <div class="cockpit-skeleton-card" style="height: 52px;"></div>
            <div class="cockpit-skeleton-card" style="height: 52px;"></div>
            <div class="cockpit-skeleton-card" style="height: 52px;"></div>
            <div class="cockpit-skeleton-card" style="height: 52px;"></div>
        </div>
    }
    else if (!pageItems.Any())
    {
        <div class="empty-state audit-empty-state">
            <CinemaIcon Name="CinemaIconName.Shield" Size="48" Class="audit-empty-icon" />
            <h3 class="audit-empty-title">Không tìm thấy nhật ký tương ứng</h3>
            <p class="audit-empty-desc">
                Không có bản ghi nào khớp với từ khóa tìm kiếm "@appliedQuery"
                @if (!string.IsNullOrEmpty(selectedEntityType))
                {
                    <span> và thực thể @selectedEntityType</span>
                }
                .
            </p>
            <button type="button" class="action-btn secondary" @onclick="ResetFilters">Xóa toàn bộ bộ lọc</button>
        </div>
    }
    else if (!visibleLogs.Any())
    {
        <div class="empty-state audit-empty-state">
            <CinemaIcon Name="CinemaIconName.Filter" Size="48" Class="audit-empty-icon" />
            <h3 class="audit-empty-title">Bộ lọc cục bộ không khớp với dữ liệu trang này</h3>
            <p class="audit-empty-desc">
                Trong @pageItems.Count bản ghi đang tải ở trang @currentPage, không có bản ghi nào khớp với
                mức độ rủi ro và khung thời gian đang chọn. Hãy chuyển sang trang khác hoặc nới lỏng bộ lọc.
            </p>
            <button type="button" class="action-btn secondary" @onclick="ResetFilters">Xóa toàn bộ bộ lọc</button>
        </div>
    }
    else
    {
        if (isTimelineView)
        {
            <!-- VISUAL TIMELINE VIEW -->
            <div class="audit-timeline-container">
                <div class="audit-timeline-axis"></div>

                @foreach (var log in visibleLogs)
                {
                    <div class="audit-timeline-item">
                        <div class="audit-timeline-node @GetNodeCssClass(log.Action)">
                            <span style="font-size: 0.65rem; font-weight: 800;">@GetActionSymbol(log.Action)</span>
                        </div>

                        <div class="audit-timeline-card">
                            <div class="audit-timeline-card-header">
                                <div class="audit-timeline-meta">
                                    <span class="audit-row-action @GetActionCssClass(log.Action)">
                                        @log.Action
                                    </span>
                                    <span class="audit-timeline-actor">@log.AdminEmail</span>
                                    <span class="audit-timeline-entity-tag font-mono-num">
                                        @log.EntityType #@log.EntityId
                                    </span>
                                </div>
                                <span class="audit-timeline-time">
                                    @GetRelativeTime(log.Timestamp) (@log.Timestamp.ToLocalTime().ToString("HH:mm:ss"))
                                </span>
                            </div>

                            <div class="audit-timeline-summary">
                                @log.Summary
                            </div>

                            <div class="audit-timeline-footer">
                                <span class="font-mono-num">ID: @log.Id.ToString().Substring(0, 8)</span>
                                <div style="display: flex; gap: 0.5rem; align-items: center;">
                                    <span class="font-mono-num" style="font-size: 0.72rem;">@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd")</span>
                                    @if (!string.IsNullOrEmpty(log.DetailsJson))
                                    {
                                        <button type="button" class="action-btn secondary small" @onclick="() => OpenDetailsModal(log)" title="Xem payload chi tiết">
                                            <CinemaIcon Name="CinemaIconName.Eye" Size="13" />
                                            <span>Chi tiết JSON</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- DATA TABLE GRID VIEW -->
            <div class="table-frame">
                <table class="admin-movies-table">
                    <thead>
                        <tr>
                            <th style="width: 170px;">Thời gian (Local)</th>
                            <th style="width: 190px;">Quản trị viên</th>
                            <th style="width: 140px;">Thao tác</th>
                            <th style="width: 140px;">Thực thể</th>
                            <th>Tóm tắt hành động</th>
                            <th style="width: 100px; text-align: right;">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in visibleLogs)
                        {
                            <tr>
                                <td>
                                    <div class="audit-time-main font-mono-num">
                                        @log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                    </div>
                                    <div class="audit-time-rel">
                                        @GetRelativeTime(log.Timestamp)
                                    </div>
                                </td>
                                <td>
                                    <div class="audit-actor-row">
                                        <div class="user-avatar-initial">
                                            @(string.IsNullOrEmpty(log.AdminEmail) ? "A" : log.AdminEmail[0].ToString().ToUpper())
                                        </div>
                                        <div class="audit-actor-name" title="@log.AdminEmail">
                                            @log.AdminEmail
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="audit-row-action @GetActionCssClass(log.Action)">
                                        @log.Action
                                    </span>
                                </td>
                                <td>
                                    <div class="audit-entity-group">
                                        <span class="audit-entity-type">
                                            @log.EntityType
                                        </span>
                                        @if (!string.IsNullOrEmpty(log.EntityId))
                                        {
                                            <span class="audit-entity-id font-mono-num" title="@log.EntityId">
                                                #@log.EntityId
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="audit-summary-text">
                                        @log.Summary
                                    </div>
                                </td>
                                <td style="text-align: right;">
                                    @if (!string.IsNullOrEmpty(log.DetailsJson))
                                    {
                                        <button type="button" class="action-btn secondary small" @onclick="() => OpenDetailsModal(log)" title="Xem payload chi tiết">
                                            <CinemaIcon Name="CinemaIconName.Eye" Size="14" />
                                            <span>JSON</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="audit-empty-dash">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <AdminPagination CurrentPage="@currentPage"
                         PageSize="@pageSize"
                         TotalItems="@totalItems"
                         PageSizeOptions="@(new[] { 20, 50, 100, 200 })"
                         OnPageChanged="HandlePageChanged"
                         OnPageSizeChanged="HandlePageSizeChanged" />
    }
</section>

