    /// <summary>Mở hộp thoại xác nhận trước khi xóa một phim.</summary>
    private void RequestDeleteMovie(int id, string title)
    {
        pendingDeleteMovieId = id;
        pendingDeleteMovieTitle = title;
        deleteConfirmMessage = $"Phim \"{title}\" và toàn bộ tập, nguồn phát, đánh giá liên kết sẽ bị xóa vĩnh viễn. Thao tác này không thể hoàn tác.";
        showDeleteConfirm = true;
    }

    private void CancelDeleteMovie()
    {
        showDeleteConfirm = false;
        pendingDeleteMovieId = 0;
        pendingDeleteMovieTitle = string.Empty;
    }

    private async Task ConfirmDeleteMovie()
    {
        showDeleteConfirm = false;
        var id = pendingDeleteMovieId;
        var title = pendingDeleteMovieTitle;
        pendingDeleteMovieId = 0;
        pendingDeleteMovieTitle = string.Empty;

        if (id <= 0) return;

        if (await AdminApi.DeleteMovieAsync(id))
        {
            actionAlert = $"Đã xóa phim '{title}'.";
            await LoadMovies();
        }
        else
        {
            actionError = "Không thể xóa phim này.";
        }
        StateHasChanged();
    }

    /// <summary>Mở hộp thoại xác nhận trước khi xóa hàng loạt.</summary>
    private void RequestBulkDelete()
    {
        if (selectedMovieIds.Count == 0) return;
        bulkDeleteConfirmMessage = $"{selectedMovieIds.Count} phim đang được chọn sẽ bị xóa cùng toàn bộ tập và nguồn phát liên kết. Thao tác này không thể hoàn tác.";
        showBulkDeleteConfirm = true;
    }

    private void CancelBulkDelete()
    {
        showBulkDeleteConfirm = false;
    }

    private async Task ConfirmBulkDelete()
    {
        showBulkDeleteConfirm = false;
        await ExecuteBulkAction("delete");
    }

