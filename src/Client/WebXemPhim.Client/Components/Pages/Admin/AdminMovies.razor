                </button>
                <NavLink href="@($"/admin/episodes/{inspectingMovie.Id}")" class="btn-primary-action">
                    <CinemaIcon Name="CinemaIconName.List" Size="14" />
                    <span>Quản lý tập & Streams</span>
                </NavLink>
            </div>
        </aside>
    </div>
}

@code {
    private List<MovieDetailDto> allMoviesList = [];
    private List<MovieDetailDto> filteredMovies = [];
    private int totalMovieItems;

    /// <summary>Số liệu tổng hệ thống (định dạng phim, tổng số phim) lấy từ API dashboard.</summary>
    private AdminDashboardDto? stats;
    private List<GenreDto> availableGenres = [];
    private MovieType? selectedMovieType = null;
    private string selectedGenreFilter = "";
    private string selectedQualityFilter = "";
    private string selectedStatusFilter = "";
    private string selectedYearFilter = "";
    private string selectedCountryFilter = "";
    private string selectedRatingFilter = "";
    private string selectedSortBy = "date_desc";
    private string searchQuery = "";
    private readonly SearchDebouncer movieSearchDebouncer = new();
    private bool isLoadingMovies = true;
    private string? actionAlert;
    private string? actionError;
    private string? movieFormError;
    private int currentPage = 1;
    private int pageSize = 10;

    // Tùy chỉnh bộ lọc: ẩn/hiện từng ô lọc, lưu lại theo trình duyệt.
    private const string FilterPrefsStorageKey = "cinemaflow_admin_movie_filter_prefs_v2";
    private static readonly (string Key, string Label)[] FilterOptions =
    [
        ("search", "Tìm theo tên phim"),
        ("genre", "Thể loại"),
        ("quality", "Chất lượng"),
        ("status", "Trạng thái gắn cờ"),
        ("year", "Năm phát hành"),
        ("country", "Quốc gia"),
        ("rating", "Điểm đánh giá"),
        ("sort", "Sắp xếp")
    ];
    // Mặc định ban đầu: chưa bật ô lọc nào (tick trống) — admin tự chọn ô cần dùng.
    private readonly HashSet<string> hiddenFilters = [.. FilterOptions.Select(o => o.Key)];
    private bool showFilterSettings;
    private bool filtersCollapsed;

    private bool HasActiveMovieFilters =>
        selectedMovieType != null ||
        !string.IsNullOrEmpty(selectedGenreFilter) ||
        !string.IsNullOrEmpty(selectedQualityFilter) ||
        !string.IsNullOrEmpty(selectedStatusFilter) ||
        !string.IsNullOrEmpty(selectedYearFilter) ||
        !string.IsNullOrEmpty(selectedCountryFilter) ||
        !string.IsNullOrEmpty(selectedRatingFilter) ||
        !string.IsNullOrEmpty(searchQuery) ||
        selectedSortBy != "date_desc";

    // Multi-select state
    private readonly HashSet<int> selectedMovieIds = [];

    // Modal state
    private bool showMovieModal = false;
    private int? editingMovieId = null;
    private UpsertMovieRequest movieModel = new();
    private bool isSavingMovie = false;

    // Clone state
    private bool showCloneModal = false;
    private MovieDetailDto? targetCloneMovie;
    private CloneMovieRequest cloneModel = new();
    private string? cloneFormError;
    private bool isCloning = false;

    // Inspector state
    private MovieDetailDto? inspectingMovie;

    private bool IsAllSelected
    {
        get
        {
            var paged = CurrentPageMovies;
            return paged.Count > 0 && paged.All(m => selectedMovieIds.Contains(m.Id));
        }
    }

    private List<MovieDetailDto> CurrentPageMovies => filteredMovies;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Auth.InitializeAsync();
            await LoadFilterPrefsAsync();
            await LoadMovies();

            // Lệnh tắt nhanh trong Command Palette mở thẳng modal thêm phim.
            if (string.Equals(Action, "new", StringComparison.OrdinalIgnoreCase))
            {
                OpenAddMovieModal();
            }
        }
    }

    /// <summary>Được nạp từ query string, ví dụ /admin/movies?action=new.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "action")]
    public string? Action { get; set; }

    private async Task LoadMovies()
    {
        if (!Auth.IsAdmin) return;
        isLoadingMovies = true;
        try
        {
            var genresTask = MovieApi.GetGenresAsync();
            var statsTask = AdminApi.GetStatsAsync();
            availableGenres = await genresTask;
            await LoadMoviesPageAsync(resetPage: false);
            stats = await statsTask;
        }
        catch (Exception ex)
        {
            actionError = "Không thể tải danh sách phim: " + ex.Message;
        }
        finally
        {
            isLoadingMovies = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Tải trang hiện tại từ server. Bộ lọc và sắp xếp được áp dụng ở server nên
    /// tổng số mục luôn khớp với dữ liệu thật thay vì giới hạn ở 1000 bản ghi tải về.
    /// </summary>
    private async Task LoadMoviesPageAsync(bool resetPage)
    {
        if (!Auth.IsAdmin) return;

        if (resetPage)
        {
            currentPage = 1;
            selectedMovieIds.Clear();
        }

        isLoadingMovies = true;
        try
        {
            var (yearFrom, yearTo) = ParseYearFilter(selectedYearFilter);
            var (minRating, maxRating) = ParseRatingFilter(selectedRatingFilter);

            var result = await AdminApi.GetMoviesPagedAsync(
                page: currentPage,
                pageSize: pageSize,
                query: string.IsNullOrWhiteSpace(searchQuery) ? null : searchQuery,
                type: selectedMovieType,
                genre: string.IsNullOrWhiteSpace(selectedGenreFilter) ? null : selectedGenreFilter,
                quality: string.IsNullOrWhiteSpace(selectedQualityFilter) ? null : selectedQualityFilter,
                status: string.IsNullOrWhiteSpace(selectedStatusFilter) ? null : selectedStatusFilter,
                sortBy: string.IsNullOrWhiteSpace(selectedSortBy) ? null : selectedSortBy,
                yearFrom: yearFrom,
                yearTo: yearTo,
                country: string.IsNullOrWhiteSpace(selectedCountryFilter) ? null : selectedCountryFilter,
                minRating: minRating,
                maxRating: maxRating);

            filteredMovies = result.Items.ToList();
            totalMovieItems = result.TotalItems;
        }
        catch (Exception ex)
        {
            actionError = "Không thể tải danh liệu phim: " + ex.Message;
        }
        finally
        {
            isLoadingMovies = false;
            StateHasChanged();
        }
    }

    private static (int? From, int? To) ParseYearFilter(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return (null, null);
        if (int.TryParse(value, out var exact)) return (exact, exact);
        if (value == "2020-2022") return (2020, 2022);
        if (value == "pre-2020") return (1900, 2019);
        return (null, null);
    }

    private static (double? Min, double? Max) ParseRatingFilter(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return (null, null);
        if (value == "8+") return (8.0, null);
        if (value == "7+") return (7.0, null);
        if (value == "<7") return (null, 6.99);
        return (null, null);
    }

    /// <summary>Áp dụng toàn bộ bộ lọc đang chọn và tải lại từ server.</summary>
    private void ApplyMovieFilters()
    {
        _ = ApplyMovieFiltersAsync();
    }

    private Task ApplyMovieFiltersAsync() => LoadMoviesPageAsync(resetPage: true);

    /// <summary>Gõ tới đâu tìm tới đó nhưng chỉ gọi API sau khi người dùng ngừng gõ 400ms.</summary>
    private void ScheduleMovieSearch()
    {
        movieSearchDebouncer.Schedule(ApplyMovieFiltersAsync);
    }

    private void FilterByType(MovieType? type)
    {
        selectedMovieType = type;
        ApplyMovieFilters();
    }

    private void OnGenreFilterChanged(ChangeEventArgs e)
    {
        selectedGenreFilter = e.Value?.ToString() ?? "";
        ApplyMovieFilters();
    }

    private void OnQualityFilterChanged(ChangeEventArgs e)
    {
        selectedQualityFilter = e.Value?.ToString() ?? "";
        ApplyMovieFilters();
    }

    private void OnStatusFilterChanged(ChangeEventArgs e)
    {
        selectedStatusFilter = e.Value?.ToString() ?? "";
        ApplyMovieFilters();
    }

    private void OnYearFilterChanged(ChangeEventArgs e)
    {
        selectedYearFilter = e.Value?.ToString() ?? "";
        ApplyMovieFilters();
    }

    private void OnCountryFilterChanged(ChangeEventArgs e)
    {
        selectedCountryFilter = e.Value?.ToString() ?? "";
        ApplyMovieFilters();
    }

    private void OnRatingFilterChanged(ChangeEventArgs e)
    {
        selectedRatingFilter = e.Value?.ToString() ?? "";
        ApplyMovieFilters();
    }

    private void OnSortByChanged(ChangeEventArgs e)
    {
        selectedSortBy = e.Value?.ToString() ?? "date_desc";
        ApplyMovieFilters();
    }

    private void ToggleFilterSettings()
    {
        showFilterSettings = !showFilterSettings;
    }

    private void CloseFilterSettings()
    {
        showFilterSettings = false;
    }

    private void OnFilterSettingsKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            showFilterSettings = false;
        }
    }

    private async Task ToggleFilterCollapse()
    {
        filtersCollapsed = !filtersCollapsed;
        await SaveFilterPrefsAsync();
    }

    /// <summary>Bật/tắt một ô lọc. Ẩn ô lọc sẽ xóa luôn giá trị đang chọn để tránh lọc ngầm.</summary>
    private async Task SetFilterVisibility(string key, bool visible)
    {
        // Bỏ qua sự kiện change phát sinh khi popover đã đóng (tránh tự ẩn bộ lọc ngoài ý muốn).
        if (!showFilterSettings) return;

        if (visible) hiddenFilters.Remove(key);
        else hiddenFilters.Add(key);

        var needsReload = !visible && ClearFilterValue(key);
        await SaveFilterPrefsAsync();

        if (needsReload) await ApplyMovieFiltersAsync();
        else StateHasChanged();
    }

    /// <summary>Xóa giá trị của bộ lọc vừa bị ẩn. Trả về true nếu thực sự có thay đổi cần tải lại.</summary>
    private bool ClearFilterValue(string key)
    {
        switch (key)
        {
            case "search" when !string.IsNullOrEmpty(searchQuery):
                searchQuery = "";
                return true;
            case "genre" when !string.IsNullOrEmpty(selectedGenreFilter):
                selectedGenreFilter = "";
                return true;
            case "quality" when !string.IsNullOrEmpty(selectedQualityFilter):
                selectedQualityFilter = "";
                return true;
            case "status" when !string.IsNullOrEmpty(selectedStatusFilter):
                selectedStatusFilter = "";
                return true;
            case "year" when !string.IsNullOrEmpty(selectedYearFilter):
                selectedYearFilter = "";
                return true;
            case "country" when !string.IsNullOrEmpty(selectedCountryFilter):
                selectedCountryFilter = "";
                return true;
            case "rating" when !string.IsNullOrEmpty(selectedRatingFilter):
                selectedRatingFilter = "";
                return true;
            case "sort" when selectedSortBy != "date_desc":
                selectedSortBy = "date_desc";
                return true;
            default:
                return false;
        }
    }

    private async Task ShowAllFiltersAsync()
    {
        if (hiddenFilters.Count == 0) return;
        hiddenFilters.Clear();
        await SaveFilterPrefsAsync();
    }

    private void ClearSearchQuery()
    {
        movieSearchDebouncer.Cancel();
        searchQuery = "";
        ApplyMovieFilters();
    }

    /// <summary>Đọc lại lựa chọn ẩn/hiện bộ lọc đã lưu trong localStorage của trình duyệt.</summary>
    private async Task LoadFilterPrefsAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("adminTools.getStoredJson", FilterPrefsStorageKey);
            if (string.IsNullOrWhiteSpace(json)) return;

            var prefs = System.Text.Json.JsonSerializer.Deserialize<MovieFilterPrefs>(json);
            if (prefs is null) return;

            hiddenFilters.Clear();
            foreach (var key in prefs.Hidden.Where(k => FilterOptions.Any(o => o.Key == k)))
            {
                hiddenFilters.Add(key);
            }
            filtersCollapsed = prefs.Collapsed;
        }
        catch
        {
            // Tùy chọn hiển thị chỉ là tiện ích: localStorage bị chặn hoặc dữ liệu hỏng thì dùng mặc định.
        }
    }

    private async Task SaveFilterPrefsAsync()
    {
        try
        {
            var prefs = new MovieFilterPrefs(hiddenFilters.ToList(), filtersCollapsed);
            var json = System.Text.Json.JsonSerializer.Serialize(prefs);
            await JS.InvokeVoidAsync("adminTools.setStoredJson", FilterPrefsStorageKey, json);
        }
        catch
        {
            // Không lưu được thì thôi, không chặn thao tác của admin.
        }
    }

