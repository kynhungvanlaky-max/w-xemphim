    private void HandleStudioR2FileSelected(InputFileChangeEventArgs e)
    {
        streamActionError = null;
        var file = e.File;
        if (file == null) return;

        const long maxBytes = 4L * 1024 * 1024 * 1024;
        if (file.Size > maxBytes)
        {
            streamActionError = $"Dung lượng video ({Math.Round(file.Size / (1024.0 * 1024.0), 1)} MB) vượt quá giới hạn cho phép (4096 MB).";
            return;
        }

        studioR2SelectedFile = file;

        // Tự động nhận diện chất lượng Master từ tên tệp video
        var lower = file.Name.ToLowerInvariant();
        if (lower.Contains("4k") || lower.Contains("2160p")) studioR2MasterQuality = "4K UHD";
        else if (lower.Contains("1080p") || lower.Contains("fhd")) studioR2MasterQuality = "1080p FHD";
        else if (lower.Contains("720p") || lower.Contains("hd")) studioR2MasterQuality = "720p HD";
        else if (lower.Contains("480p") || lower.Contains("sd")) studioR2MasterQuality = "480p SD";
    }

    private async Task ExecuteStudioR2Upload()
    {
        if (managingEpisode == null || studioR2SelectedFile == null) return;
        if (studioR2SelectedServers.Count == 0)
        {
            streamActionError = "Vui lòng chọn ít nhất một cụm máy chủ để phân phối nguồn phát.";
            return;
        }

        isStudioR2Uploading = true;
        studioR2UploadProgress = 0;
        studioR2UploadStageText = "Đang truyền tải video Master lên Cloudflare R2...";
        streamActionAlert = null;
        streamActionError = null;
        StateHasChanged();

        try
        {
            await using var stream = studioR2SelectedFile.OpenReadStream(maxAllowedSize: 4L * 1024 * 1024 * 1024);
            var progress = new Progress<double>(p =>
            {
                studioR2UploadProgress = Math.Round(p, 0);
                if (studioR2UploadProgress >= 99)
                {
                    studioR2UploadStageText = "Đang xử lý hạ cấp trần chất lượng & tải các bản luồng lên Cloudflare R2...";
                }
                InvokeAsync(StateHasChanged);
            });

            var targetServersParam = studioR2SelectAllServers ? "all" : string.Join(",", studioR2SelectedServers);
            var res = await AdminApi.UploadEpisodeVideoAsync(
                managingEpisode.Id,
                stream,
                studioR2SelectedFile.Name,
                studioR2MasterQuality,
                studioR2ReplaceExisting,
                targetServersParam,
                progress,
                studioR2SelectedFile.Size);

            if (res?.Success == true && res.Data != null)
            {
                var streamsCount = res.Data.Streams.Count;
                var serversCount = res.Data.DistributedServersCount;
                streamActionAlert = $"Đã tải video '{studioR2SelectedFile.Name}' ({Math.Round(studioR2SelectedFile.Size / (1024.0 * 1024.0), 1)} MB) lên Cloudflare R2 & tự động phân phối {streamsCount} luồng phát cho {serversCount} cụm máy chủ theo trần chất lượng thành công!";
                showR2StudioUpload = false;
                studioR2SelectedFile = null;

                await Task.WhenAll(
                    LoadStreamsForEpisode(managingEpisode.Id),
                    LoadEpisodesForMovie(selectedMovieId));

                // Tự động đo ping kiểm tra các luồng mới sinh
                _ = ProbeAllStreams();
            }
            else
            {
                streamActionError = res?.Message ?? "Không thể hoàn tất quá trình tải lên và phân phối luồng R2.";
            }
        }
        catch (Exception ex)
        {
            streamActionError = "Lỗi khi tải lên R2: " + ex.Message;
        }
        finally
        {
            isStudioR2Uploading = false;
            StateHasChanged();
        }
    }

    /// <summary>Mở/đóng form thêm nguồn phát. Nếu đang sửa thì đóng form sẽ hủy trạng thái sửa.</summary>
    private void ToggleStreamForm()
    {
        if (showStreamForm)
        {
            if (editingStreamPosition.HasValue) CancelEditStream();
            showStreamForm = false;
            return;
        }
        showStreamForm = true;
        showQuickTester = false;
        showR2StudioUpload = false;
        showServerControlPanel = false;
        expandedProbeDetailPosition = null;
    }

    private async Task LoadStreamsForEpisode(int epId)
    {
        try
        {
            currentStreamsList = await AdminApi.GetEpisodeStreamsAsync(epId);
            if (currentStreamsList.Count > 0 && !editingStreamPosition.HasValue)
            {
                streamFormModel.ServerName = currentStreamsList.First().ServerName;
                streamFormModel.ServerType = currentStreamsList.First().ServerType;
            }
        }
        catch
        {
            currentStreamsList = [];
        }
        StateHasChanged();
    }

    private void StartEditStream(StreamSourceDto s)
    {
        editingStreamPosition = s.Position;
        showStreamForm = true;
        showQuickTester = false;
        showR2StudioUpload = false;
        showServerControlPanel = false;
        expandedProbeDetailPosition = null;
        formProbeResult = null;
        streamFormModel = new UpsertStreamSourceRequest
        {
            EpisodeId = managingEpisode?.Id ?? 0,
            ServerName = s.ServerName,
            ServerType = s.ServerType,
            Quality = s.Quality,
            StreamUrl = s.StreamUrl
        };
        streamActionAlert = null;
        streamActionError = null;
    }

    private void CancelEditStream()
    {
        editingStreamPosition = null;
        formProbeResult = null;
        streamFormModel = new UpsertStreamSourceRequest
        {
            EpisodeId = managingEpisode?.Id ?? 0,
            ServerName = currentStreamsList.FirstOrDefault()?.ServerName ?? "VIP FastServer 1",
            ServerType = StreamServerType.VipFastServer,
            Quality = "1080p FHD",
            StreamUrl = ""
        };
        streamActionAlert = null;
        streamActionError = null;
    }

    private void QuickAddQualityForServer(string serverName, StreamServerType serverType)
    {
        editingStreamPosition = null;
        showStreamForm = true;
        showQuickTester = false;
        showR2StudioUpload = false;
        showServerControlPanel = false;
        expandedProbeDetailPosition = null;
        formProbeResult = null;
        var existingQualities = currentStreamsList.Where(s => s.ServerName == serverName).Select(s => s.Quality).ToHashSet();
        var nextQuality = QualityPresets.FirstOrDefault(q => !existingQualities.Contains(q)) ?? "720p HD";

        streamFormModel = new UpsertStreamSourceRequest
        {
            EpisodeId = managingEpisode?.Id ?? 0,
            ServerName = serverName,
            ServerType = serverType,
            Quality = nextQuality,
            StreamUrl = ""
        };
        streamActionAlert = $"Đang thêm chất lượng '{nextQuality}' cho máy chủ '{serverName}'. Nhập URL luồng bên dưới.";
        streamActionError = null;
    }

    private async Task SaveStreamSource()
    {
        if (managingEpisode == null) return;
        if (string.IsNullOrWhiteSpace(streamFormModel.StreamUrl))
        {
            streamActionError = "Vui lòng nhập URL luồng Stream hợp lệ.";
            return;
        }

        var srvName = (streamFormModel.ServerName ?? "").Trim();
        var quality = (streamFormModel.Quality ?? "").Trim();
        if (string.IsNullOrWhiteSpace(srvName))
        {
            streamActionError = "Vui lòng nhập hoặc chọn tên máy chủ.";
            return;
        }

        var isDuplicate = currentStreamsList.Any(s =>
            (!editingStreamPosition.HasValue || s.Position != editingStreamPosition.Value) &&
            string.Equals(s.ServerName?.Trim(), srvName, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(s.Quality?.Trim(), quality, StringComparison.OrdinalIgnoreCase));

        if (isDuplicate)
        {
            streamActionError = $"Máy chủ '{srvName}' đã có luồng chất lượng '{quality}'. Vui lòng chọn chất lượng hoặc máy chủ khác.";
            return;
        }

        isSavingStream = true;
        streamActionAlert = null;
        streamActionError = null;

        try
        {
            streamFormModel.StreamUrl = streamFormModel.StreamUrl.Trim();
            streamFormModel.ServerName = srvName;
            streamFormModel.Quality = quality;

            if (editingStreamPosition.HasValue)
            {
                var res = await AdminApi.UpdateStreamSourceAsync(managingEpisode.Id, editingStreamPosition.Value, streamFormModel);
                if (res?.Success == true)
                {
                    streamActionAlert = $"Đã cập nhật nguồn stream #{editingStreamPosition.Value} ({streamFormModel.Quality}) thành công!";
                    editingStreamPosition = null;
                    showStreamForm = false;
                    formProbeResult = null;
                    streamFormModel.StreamUrl = "";
                    await Task.WhenAll(
                        LoadStreamsForEpisode(managingEpisode.Id),
                        LoadEpisodesForMovie(selectedMovieId)
                    );
                }
                else
                {
                    streamActionError = res?.Message ?? "Không thể cập nhật nguồn stream.";
                }
            }
            else
            {
                var res = await AdminApi.AddStreamSourceAsync(managingEpisode.Id, streamFormModel);
                if (res?.Success == true)
                {
                    streamActionAlert = $"Đã thêm nguồn stream '{streamFormModel.ServerName}' ({streamFormModel.Quality}) thành công!";
                    streamFormModel.StreamUrl = "";
                    formProbeResult = null;
                    await Task.WhenAll(
                        LoadStreamsForEpisode(managingEpisode.Id),
                        LoadEpisodesForMovie(selectedMovieId)
                    );
                }
                else
                {
                    streamActionError = res?.Message ?? "Không thể thêm nguồn stream.";
                }
            }
        }
        catch (Exception ex)
        {
            streamActionError = "Lỗi khi lưu nguồn: " + ex.Message;
        }
        finally
        {
            isSavingStream = false;
            StateHasChanged();
        }
    }

    private async Task DeleteStreamSource(int position)
    {
        if (managingEpisode == null) return;
        streamActionAlert = null;
        streamActionError = null;

        if (editingStreamPosition == position)
        {
            CancelEditStream();
        }

        var res = await AdminApi.DeleteStreamSourceAsync(managingEpisode.Id, position);
        if (res?.Success == true)
        {
            streamActionAlert = $"Đã xóa nguồn phát #{position}.";
            await LoadStreamsForEpisode(managingEpisode.Id);
            await LoadEpisodesForMovie(selectedMovieId);
        }
        else
        {
            streamActionError = "Không thể xóa nguồn phát.";
        }
    }

    private async Task DeleteEpisode(int episodeId)
    {
        actionAlert = null;
        actionError = null;
        if (await AdminApi.DeleteEpisodeAsync(episodeId))
        {
            actionAlert = "Đã xóa tập phim thành công.";
            await LoadEpisodesForMovie(selectedMovieId);
        }
        else
        {
            actionError = "Không thể xóa tập phim.";
        }
        StateHasChanged();
    }

    private void RequestDeleteEpisode(EpisodeDto ep)
    {
        episodePendingDelete = ep;
        showDeleteEpisodeConfirm = true;
    }

    private async Task ConfirmDeleteEpisode()
    {
        if (episodePendingDelete != null)
        {
            var epId = episodePendingDelete.Id;
            showDeleteEpisodeConfirm = false;
            episodePendingDelete = null;
            await DeleteEpisode(epId);
        }
    }

    private void RequestDeleteStreamSource(int position)
    {
        streamPendingDeletePosition = position;
        showDeleteStreamConfirm = true;
    }

    private async Task ConfirmDeleteStream()
    {
        if (streamPendingDeletePosition.HasValue)
        {
            var pos = streamPendingDeletePosition.Value;
            showDeleteStreamConfirm = false;
            streamPendingDeletePosition = null;
            await DeleteStreamSource(pos);
        }
    }

    private void HandleEpisodeModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseEpisodeModal();
        }
    }

    private void HandleEpisodeInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isSavingEpisode && !IsDuplicateEpisodeNumber)
        {
            _ = SaveEpisode();
        }
    }

    private void HandleThumbnailModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseThumbnailModal();
        }
        else if (e.Key == "Enter" && CanSubmitThumbnail && !isUploadingThumbnail)
        {
            _ = SubmitThumbnail();
        }
    }

    private void HandleProbeModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseProbeModal();
        }
    }

    private void HandleStreamsManagerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            if (showDeleteStreamConfirm) return;

            // 1. Phân tầng: nếu đang mở Drawer chi tiết ping inline, đóng drawer trước
            if (expandedProbeDetailPosition.HasValue)
            {
                expandedProbeDetailPosition = null;
                return;
            }
            // 2. Nếu đang mở công cụ test nhanh, đóng test nhanh
            if (showQuickTester)
            {
                showQuickTester = false;
                return;
            }
            // 3. Nếu đang mở công cụ tải R2, đóng R2
            if (showR2StudioUpload)
            {
                showR2StudioUpload = false;
                return;
            }
            // 4. Nếu đang mở bảng điều khiển Server, đóng Server control
            if (showServerControlPanel)
            {
                showServerControlPanel = false;
                return;
            }
            // 5. Nếu đang ở form sửa nguồn, hủy trạng thái sửa form
            if (showStreamForm && editingStreamPosition.HasValue)
            {
                CancelEditStream();
                showStreamForm = false;
                return;
            }
            // 6. Nếu đang mở form thêm luồng trống, đóng form
            if (showStreamForm)
            {
                showStreamForm = false;
                return;
            }
            // 7. Cuối cùng đóng toàn bộ popup Quản lý nguồn Stream
            CloseStreamsManager();
        }
    }

    private void HandleStreamFormInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isSavingStream)
        {
            _ = SaveStreamSource();
        }
    }

    private List<StreamServerPolicyDto> serverPolicies = [];
    private bool showServerControlPanel = false;
    private bool isLoadingPolicies = false;
    private bool isSavingPolicy = false;
    private string? savingPolicyKey = null;
    private string? policyActionAlert = null;
    private string? policyActionError = null;

    private async Task ToggleServerControlPanel()
    {
        showServerControlPanel = !showServerControlPanel;
        if (showServerControlPanel)
        {
            showQuickTester = false;
            showR2StudioUpload = false;
            showStreamForm = false;
            expandedProbeDetailPosition = null;
            if (serverPolicies.Count == 0)
            {
                await LoadServerPolicies();
            }
        }
    }

    private async Task LoadServerPolicies()
    {
        isLoadingPolicies = true;
        try
        {
            var res = await AdminApi.GetStreamServerPoliciesAsync();
            if (res?.Success == true && res.Data != null)
            {
                serverPolicies = res.Data;
            }
        }
        catch (Exception ex)
        {
            policyActionError = "Không thể tải chính sách máy chủ: " + ex.Message;
        }
        finally
        {
            isLoadingPolicies = false;
            StateHasChanged();
        }
    }

    private StreamServerPolicyDto? GetPolicyForServer(string serverName, StreamServerType serverType)
    {
        if (serverPolicies.Count == 0) return null;
        if (serverType == StreamServerType.VipFastServer || serverName.Contains("VIP", StringComparison.OrdinalIgnoreCase))
        {
            return serverPolicies.FirstOrDefault(p => p.ServerKey == "vip");
        }
        if (serverType == StreamServerType.HydraCdn || serverName.Contains("Hydra", StringComparison.OrdinalIgnoreCase) || serverName.Contains("CDN", StringComparison.OrdinalIgnoreCase))
        {
            return serverPolicies.FirstOrDefault(p => p.ServerKey == "cdn");
        }
        if (serverType == StreamServerType.BackupStream || serverName.Contains("Backup", StringComparison.OrdinalIgnoreCase) || serverName.Contains("Dự phòng", StringComparison.OrdinalIgnoreCase))
        {
            return serverPolicies.FirstOrDefault(p => p.ServerKey == "backup");
        }
        return serverPolicies.FirstOrDefault();
    }

    private async Task SaveServerPolicy(StreamServerPolicyDto policy)
    {
        isSavingPolicy = true;
        savingPolicyKey = policy.ServerKey;
        policyActionAlert = null;
        policyActionError = null;
        StateHasChanged();

        try
        {
            var req = new UpdateStreamServerPolicyRequest
            {
                IsActive = policy.IsActive,
                IsVipOnly = policy.IsVipOnly,
                MaxBandwidthKbps = policy.MaxBandwidthKbps,
                MaxQuality = policy.MaxQuality,
                BufferInitialBurstKb = policy.BufferInitialBurstKb,
                Priority = policy.Priority,
                Description = policy.Description
            };

            var res = await AdminApi.UpdateStreamServerPolicyAsync(policy.ServerKey, req);
            if (res?.Success == true && res.Data != null)
            {
                policyActionAlert = $"Đã lưu chính sách cho {policy.DisplayName}!";
                var idx = serverPolicies.FindIndex(p => p.ServerKey == policy.ServerKey);
                if (idx >= 0) serverPolicies[idx] = res.Data;
            }
            else
            {
                policyActionError = res?.Message ?? "Không thể lưu chính sách máy chủ.";
            }
        }
        catch (Exception ex)
        {
            policyActionError = "Lỗi khi lưu chính sách: " + ex.Message;
        }
        finally
        {
            isSavingPolicy = false;
            savingPolicyKey = null;
            StateHasChanged();
        }
    }

    private async Task ResetServerPolicies()
    {
        isSavingPolicy = true;
        policyActionAlert = null;
        policyActionError = null;
        StateHasChanged();

        try
        {
            var res = await AdminApi.ResetStreamServerPoliciesAsync();
            if (res?.Success == true && res.Data != null)
            {
                serverPolicies = res.Data;
                policyActionAlert = "Đã khôi phục toàn bộ chính sách máy chủ về mặc định chuẩn!";
            }
            else
            {
                policyActionError = res?.Message ?? "Không thể khôi phục mặc định.";
            }
        }
        catch (Exception ex)
        {
            policyActionError = "Lỗi khi khôi phục mặc định: " + ex.Message;
        }
        finally
        {
            isSavingPolicy = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
    }
