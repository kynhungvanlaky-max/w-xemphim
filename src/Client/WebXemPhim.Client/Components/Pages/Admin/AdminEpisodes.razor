    private Dictionary<int, ProbeStreamResultDto> streamProbeResults = new();
    private bool isBatchProbing = false;

    private async Task ProbeAllStreams()
    {
        if (currentStreamsList.Count == 0 || isBatchProbing) return;
        isBatchProbing = true;
        streamProbeResults.Clear();
        StateHasChanged();

        try
        {
            // Đo song song toàn bộ luồng thay vì tuần tự để giảm thời gian chờ.
            var probeTasks = currentStreamsList.Select(async s =>
            {
                try
                {
                    var res = await AdminApi.ProbeStreamAsync(new ProbeStreamRequest { StreamUrl = s.StreamUrl.Trim() });
                    if (res?.Data != null)
                    {
                        streamProbeResults[s.Position] = res.Data;
                    }
                }
                catch
                {
                    streamProbeResults[s.Position] = new ProbeStreamResultDto { IsSuccess = false, ErrorMessage = "Connection failed" };
                }
            }).ToList();

            await Task.WhenAll(probeTasks);
        }
        finally
        {
            isBatchProbing = false;
            StateHasChanged();
        }
    }

