@page "/admin/episodes"
@page "/admin/episodes/{MovieId:int}"
@layout WebXemPhim.Client.Components.Layout.AdminLayout
@using WebXemPhim.Shared.Models
@using WebXemPhim.Shared.Enums
@using WebXemPhim.Client.Components.Icons
@using WebXemPhim.Client.Services
@inject NavigationManager Nav
@inject AuthState Auth
@inject IAdminApiClient AdminApi
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Quản lý tập phim &amp; Nguồn phát - CinemaFlow Admin</PageTitle>

<!-- Topbar -->
<header class="admin-topbar">
    <div class="topbar-title-group">
        <h1 class="topbar-title">Studio Tập phim &amp; Nguồn Stream</h1>
        <p class="topbar-subtitle">Cấu hình luồng đa máy chủ, kiểm tra kết nối CDN ping thời gian thực và quản lý tập phim theo từng tác phẩm</p>
    </div>

    <div class="topbar-actions">
        <button type="button" class="btn-add-movie" @onclick="OpenAddEpisodeModal" disabled="@(selectedMovieId <= 0)">
            <CinemaIcon Name="CinemaIconName.Plus" Size="16" />
            <span>Thêm tập mới</span>
        </button>
    </div>
</header>

@if (!string.IsNullOrEmpty(actionAlert))
{
    <div class="form-alert success" style="margin-bottom: 1.5rem;" role="status">
        @actionAlert
    </div>
}

@if (!string.IsNullOrEmpty(actionError))
{
    <div class="form-alert error" style="margin-bottom: 1.5rem;" role="alert">
        @actionError
    </div>
}

<section class="admin-table-section">
    <div class="section-title-bar episodes-title-bar">
        <div class="title-with-dropdown">
            <h2>Quản lý tập phim</h2>
        </div>
        <div class="episodes-movie-picker">
            <span class="audit-filter-label" style="font-size: 0.8rem;">Tác phẩm đang quản lý</span>
            <div class="movie-picker">
                <button type="button"
                        class="movie-picker-trigger @(showMoviePicker ? "is-open" : "")"
                        aria-haspopup="true"
                        aria-expanded="@(showMoviePicker ? "true" : "false")"
                        title="Tìm và chọn tác phẩm cần quản lý tập phim"
                        @onclick="ToggleMoviePicker">
                    <CinemaIcon Name="CinemaIconName.Search" Size="14" Class="movie-picker-trigger-icon" />
                    <span class="movie-picker-trigger-label">@(SelectedMovie?.Title ?? "Chọn tác phẩm")</span>
                    @if (SelectedMovie is not null)
                    {
                        <span class="movie-picker-trigger-meta">@MovieTypeLabel(SelectedMovie.Type) · @SelectedMovie.ReleaseYear</span>
                    }
                    <CinemaIcon Name="CinemaIconName.ChevronDown" Size="13" Class="movie-picker-trigger-caret" />
                </button>

                @if (showMoviePicker)
                {
                    <div class="filter-settings-backdrop" @onclick="CloseMoviePicker"></div>
                    <div class="movie-picker-panel" role="group" aria-label="Tìm và chọn tác phẩm" @onkeydown="OnMoviePickerKeyDown">
                        <div class="filter-search-box movie-picker-search">
                            <CinemaIcon Name="CinemaIconName.Search" Size="14" Class="filter-search-icon" />
                            <input @ref="moviePickerInput"
                                   type="text"
                                   placeholder="Nhập tên phim, tên gốc..."
                                   aria-label="Tìm tác phẩm theo tên"
                                   @bind="moviePickerQuery"
                                   @bind:event="oninput"
                                   @onkeydown="OnMoviePickerInputKeyDown" />
                            @if (!string.IsNullOrEmpty(moviePickerQuery))
                            {
                                <button type="button" class="filter-search-clear" title="Xóa từ khóa" aria-label="Xóa từ khóa" @onclick="ClearMoviePickerQuery">&times;</button>
                            }
                        </div>

                        <div class="movie-picker-scope" role="group" aria-label="Lọc nhanh theo định dạng">
                            <button type="button" class="movie-picker-scope-btn @(moviePickerType is null ? "active" : "")" @onclick="() => SetMoviePickerType(null)">
                                Tất cả (@allMoviesList.Count)
                            </button>
                            <button type="button" class="movie-picker-scope-btn @(moviePickerType == MovieType.Series ? "active" : "")" @onclick="() => SetMoviePickerType(MovieType.Series)">
                                Phim bộ (@allMoviesList.Count(m => m.Type == MovieType.Series))
                            </button>
                            <button type="button" class="movie-picker-scope-btn @(moviePickerType == MovieType.Anime ? "active" : "")" @onclick="() => SetMoviePickerType(MovieType.Anime)">
                                Anime (@allMoviesList.Count(m => m.Type == MovieType.Anime))
                            </button>
                            <button type="button" class="movie-picker-scope-btn @(moviePickerType == MovieType.Movie ? "active" : "")" @onclick="() => SetMoviePickerType(MovieType.Movie)">
                                Phim lẻ (@allMoviesList.Count(m => m.Type == MovieType.Movie))
                            </button>
                        </div>

                        <div class="movie-picker-results">
                            @if (PickerResults.Count == 0)
                            {
                                <p class="movie-picker-empty">Không tìm thấy tác phẩm phù hợp.</p>
                            }
                            else
                            {
                                @foreach (var m in PickerResults)
                                {
                                    <button type="button"
                                            class="movie-picker-item @(m.Id == selectedMovieId ? "is-current" : "")"
                                            @onclick="() => SelectMovieFromPicker(m.Id)">
                                        <span class="movie-picker-item-title">@m.Title</span>
                                        <span class="movie-picker-item-meta">@MovieTypeLabel(m.Type) · @m.ReleaseYear · @m.TotalEpisodes tập</span>
                                    </button>
                                }
                            }
                        </div>

                        <p class="movie-picker-hint">Gõ để tìm nhanh · Enter chọn kết quả đầu tiên · Esc để đóng</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Multi-Dimensional Filter Suite for Episodes -->
    <div class="cockpit-filter-suite">
        <!-- Row 1: Count summary + filter customiser -->
        <div class="filter-suite-top">
            <div class="filter-count-chip">
                <span>Hiển thị: <strong>@filteredEpisodes.Count</strong> / @episodesList.Count tập phim</span>
            </div>

            <div class="filter-suite-tools">
                <div class="filter-settings-anchor">
                    <button type="button"
                            class="btn-filter-util @(showFilterSettings ? "is-active" : "")"
                            aria-haspopup="true"
                            aria-expanded="@(showFilterSettings ? "true" : "false")"
                            title="Chọn bộ lọc muốn hiển thị"
                            @onclick="ToggleFilterSettings">
                        <CinemaIcon Name="CinemaIconName.Settings" Size="13" />
                        <span>Bộ lọc</span>
                        @if (hiddenFilters.Count > 0 && hiddenFilters.Count < FilterOptions.Length)
                        {
                            <span class="filter-util-badge" title="@($"{hiddenFilters.Count} bộ lọc đang ẩn")">@hiddenFilters.Count</span>
                        }
                    </button>

                    @if (showFilterSettings)
                    {
                        <div class="filter-settings-backdrop" @onclick="CloseFilterSettings"></div>
                        <div class="filter-settings-panel" role="group" aria-label="Tùy chỉnh bộ lọc hiển thị" @onkeydown="OnFilterSettingsKeyDown">
                            <div class="filter-settings-head">
                                <strong>Hiển thị bộ lọc</strong>
                                <button type="button" class="btn-filter-util-reset" disabled="@(hiddenFilters.Count == 0)" @onclick="ShowAllFiltersAsync">
                                    Hiện tất cả
                                </button>
                            </div>
                            <p class="filter-settings-hint">Bỏ tick để ẩn bộ lọc không dùng. Giá trị đang chọn của bộ lọc bị ẩn sẽ được xóa để danh sách không bị lọc ngầm.</p>
                            <div class="filter-settings-list">
                                @foreach (var option in FilterOptions)
                                {
                                    <label class="filter-settings-item">
                                        <input type="checkbox"
                                               checked="@(!hiddenFilters.Contains(option.Key))"
                                               @onclick="() => SetFilterVisibility(option.Key, hiddenFilters.Contains(option.Key))" />
                                        <span>@option.Label</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </div>

                <button type="button"
                        class="btn-filter-util"
                        title="@(filtersCollapsed ? "Mở rộng khối bộ lọc" : "Thu gọn khối bộ lọc")"
                        aria-expanded="@(filtersCollapsed ? "false" : "true")"
                        @onclick="ToggleFilterCollapse">
                    <CinemaIcon Name="@(filtersCollapsed ? CinemaIconName.ChevronRight : CinemaIconName.ChevronDown)" Size="13" />
                    <span>@(filtersCollapsed ? "Mở rộng" : "Thu gọn")</span>
                </button>
            </div>
        </div>

        <!-- Row 2: Detailed Filter Controls Grid (từng ô có thể bật/tắt) -->
        @if (!filtersCollapsed)
        {
            <div class="filter-controls-grid">
                @if (hiddenFilters.Count == FilterOptions.Length)
                {
                    <p class="filter-all-hidden-note">
                        Chưa bật ô lọc nào. Mở <strong>Bộ lọc</strong> và tick những ô bạn cần dùng.
                    </p>
                }

                @if (!hiddenFilters.Contains("search"))
                {
                    <div class="filter-control-item filter-control-search">
                        <label class="filter-label" for="episode-search">Tìm kiếm tập</label>
                        <div class="filter-search-box">
                            <CinemaIcon Name="CinemaIconName.Search" Size="14" Class="filter-search-icon" />
                            <input id="episode-search"
                                   type="text"
                                   placeholder="Nhập số tập (VD: 1, #05) hoặc tiêu đề tập..."
                                   @bind="episodeSearchQuery"
                                   @bind:event="oninput"
                                   @bind:after="ApplyEpisodeFilters" />
                            @if (!string.IsNullOrEmpty(episodeSearchQuery))
                            {
                                <button type="button" class="filter-search-clear" title="Xóa từ khóa tìm kiếm" aria-label="Xóa từ khóa tìm kiếm" @onclick="ClearEpisodeSearchQuery">&times;</button>
                            }
                        </div>
                    </div>
                }

                @if (!hiddenFilters.Contains("range"))
                {
                    <div class="filter-control-item">
                        <label class="filter-label">Khoảng số tập</label>
                        <select class="admin-select-picker" value="@selectedEpRange" @onchange="OnEpRangeChanged">
                            <option value="">Tất cả các tập</option>
                            <option value="1-10">Tập 1 – 10</option>
                            <option value="11-25">Tập 11 – 25</option>
                            <option value="26-50">Tập 26 – 50</option>
                            <option value="51+">Từ tập 51 trở lên</option>
                        </select>
                    </div>
                }

                @if (!hiddenFilters.Contains("streams"))
                {
                    <div class="filter-control-item">
                        <label class="filter-label">Trạng thái luồng CDN</label>
                        <select class="admin-select-picker" value="@selectedStreamStatus" @onchange="OnStreamStatusChanged">
                            <option value="">Tất cả trạng thái</option>
                            <option value="has_streams">✓ Đã có luồng phát</option>
                            <option value="no_streams">⚠ Chưa có luồng phát</option>
                            <option value="has_vip">👑 Có nguồn VIP FastServer</option>
                        </select>
                    </div>
                }

                @if (!hiddenFilters.Contains("duration"))
                {
                    <div class="filter-control-item">
                        <label class="filter-label">Thời lượng tập</label>
                        <select class="admin-select-picker" value="@selectedDurationFilter" @onchange="OnDurationFilterChanged">
                            <option value="">Mọi thời lượng</option>
                            <option value="short">Dưới 25 phút (Anime / Ngắn)</option>
                            <option value="medium">25 – 50 phút (Tiêu chuẩn)</option>
                            <option value="long">Trên 50 phút (Dài / Đặc biệt)</option>
                        </select>
                    </div>
                }

                @if (!hiddenFilters.Contains("sort"))
                {
                    <div class="filter-control-item">
                        <label class="filter-label">Sắp xếp theo</label>
                        <select class="admin-select-picker" value="@selectedEpSort" @onchange="OnEpSortChanged">
                            <option value="ep_asc">Số tập tăng dần (#01 → #99)</option>
                            <option value="ep_desc">Số tập giảm dần (#99 → #01)</option>
                            <option value="duration_desc">Thời lượng dài nhất</option>
                            <option value="duration_asc">Thời lượng ngắn nhất</option>
                            <option value="title_asc">Tiêu đề tập (A → Z)</option>
                        </select>
                    </div>
                }
            </div>
        }

        <!-- Row 3: Active Filters Strip & Clear All -->
        @if (HasActiveEpisodeFilters)
        {
            <div class="filter-active-strip">
                <span class="active-filter-title">Bộ lọc đang áp dụng:</span>
                @if (!string.IsNullOrEmpty(episodeSearchQuery))
                {
                    <span class="filter-pill-tag">
                        <span>Từ khóa: "@episodeSearchQuery"</span>
                        <button type="button" @onclick='() => { episodeSearchQuery = ""; ApplyEpisodeFilters(); }'>&times;</button>
                    </span>
                }
                @if (!string.IsNullOrEmpty(selectedEpRange))
                {
                    <span class="filter-pill-tag">
                        <span>Khoảng tập: @selectedEpRange</span>
                        <button type="button" @onclick='() => { selectedEpRange = ""; ApplyEpisodeFilters(); }'>&times;</button>
                    </span>
                }
                @if (!string.IsNullOrEmpty(selectedStreamStatus))
                {
                    <span class="filter-pill-tag">
                        <span>Nguồn phát: @(selectedStreamStatus == "has_streams" ? "Đã có luồng" : selectedStreamStatus == "no_streams" ? "Chưa có luồng" : "VIP FastServer")</span>
                        <button type="button" @onclick='() => { selectedStreamStatus = ""; ApplyEpisodeFilters(); }'>&times;</button>
                    </span>
                }
                @if (!string.IsNullOrEmpty(selectedDurationFilter))
                {
                    <span class="filter-pill-tag">
                        <span>Thời lượng: @(selectedDurationFilter == "short" ? "< 25p" : selectedDurationFilter == "medium" ? "25-50p" : "> 50p")</span>
                        <button type="button" @onclick='() => { selectedDurationFilter = ""; ApplyEpisodeFilters(); }'>&times;</button>
                    </span>
                }
                @if (selectedEpSort != "ep_asc")
                {
                    <span class="filter-pill-tag">
                        <span>Sắp xếp tùy chỉnh</span>
                        <button type="button" @onclick='() => { selectedEpSort = "ep_asc"; ApplyEpisodeFilters(); }'>&times;</button>
                    </span>
                }

                <button type="button" class="btn-clear-all-filters" @onclick="ResetAllEpisodeFilters">
                    Xóa tất cả bộ lọc
                </button>
            </div>
        }
    </div>

    <div class="table-frame" style="margin-top: 1rem;">
        @if (isLoadingEpisodes)
        {
            <div class="admin-table-state-msg">Đang tải danh sách tập phim...</div>
        }
        else if (episodesList.Count == 0)
        {
            <div class="admin-table-state-msg" style="padding: 3rem 1.5rem;">
                Phim này hiện chưa có tập phim nào. Bấm <strong>"+ Thêm tập mới"</strong> để thiết lập nguồn phát đầu tiên.
            </div>
        }
        else if (filteredEpisodes.Count == 0)
        {
            <div class="admin-table-state-msg" style="padding: 3rem 1.5rem;">
                Không tìm thấy tập phim nào phù hợp với bộ lọc hiện tại. Bấm <strong>"Xóa tất cả bộ lọc"</strong> để xem lại toàn bộ.
            </div>
        }
        else
        {
            <table class="admin-movies-table">
                <thead>
                    <tr>
                        <th style="width: 70px;">Tập</th>
                        <th style="width: 80px;">Ảnh nền</th>
                        <th>Tiêu đề tập</th>
                        <th>Thời lượng</th>
                        <th>Máy chủ phát</th>
                        <th style="text-align: right; width: 140px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ep in filteredEpisodes.Skip((currentPage - 1) * pageSize).Take(pageSize))
                    {
                        var streamCount = ep.StreamSources?.Count ?? 0;
                        <tr>
                            <td><strong class="font-mono-num">#@ep.EpisodeNumber.ToString("00")</strong></td>
                            <td>
                                <div class="ep-table-thumb-frame" @onclick="() => OpenThumbnailModal(ep)" title="Bấm để đổi ảnh nền tập #@ep.EpisodeNumber">
                                    @if (!string.IsNullOrEmpty(ep.ThumbnailUrl))
                                    {
                                        <img src="@ep.ThumbnailUrl" alt="Tập @ep.EpisodeNumber" loading="lazy" onerror="this.onerror=null; this.src='@FallbackBackdrop';" />
                                    }
                                    else if (!string.IsNullOrEmpty(SelectedMovie?.BackdropUrl) || !string.IsNullOrEmpty(SelectedMovie?.PosterUrl))
                                    {
                                        <img src="@(SelectedMovie?.BackdropUrl ?? SelectedMovie?.PosterUrl)" alt="Tập @ep.EpisodeNumber" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="ep-thumb-empty">#@ep.EpisodeNumber</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div style="display: flex; flex-direction: column;">
                                    <strong>@ep.Title</strong>
                                    <small style="color: rgba(255,255,255,0.45); font-size: 0.76rem;">@ep.Overview</small>
                                </div>
                            </td>
                            <td><span class="font-mono-num">@ep.DurationMinutes</span> phút</td>
                            <td>
                                <button type="button" class="btn-action-icon" style="width: auto; padding: 4px 10px; gap: 6px;" @onclick="() => OpenStreamsManager(ep)">
                                    <CinemaIcon Name="CinemaIconName.Play" Size="13" />
                                    @if (streamCount > 0)
                                    {
                                        <span class="font-mono-num" style="font-size: 0.76rem; color: #10b981; font-weight: 600;">@streamCount nguồn phát</span>
                                    }
                                    else
                                    {
                                        <span style="font-size: 0.76rem; color: #f87171; font-weight: 600;">Chưa có luồng</span>
                                    }
                                </button>
                            </td>
                            <td style="text-align: right;">
                                <div class="row-actions" style="justify-content: flex-end;">
                                    <button type="button" class="btn-action-icon" title="Đổi ảnh nền tập này" @onclick="() => OpenThumbnailModal(ep)">
                                        <CinemaIcon Name="CinemaIconName.Image" Size="13" />
                                    </button>
                                    <button type="button" class="btn-action-icon" title="Chỉnh sửa thông tin tập" @onclick="() => OpenEditEpisodeModal(ep)">
                                        <CinemaIcon Name="CinemaIconName.Edit" Size="13" />
                                    </button>
                                    <button type="button" class="btn-action-icon" title="Cấu hình nguồn phát máy chủ &amp; chất lượng" @onclick="() => OpenStreamsManager(ep)">
                                        <CinemaIcon Name="CinemaIconName.Settings" Size="13" />
                                    </button>
                                    <button type="button" class="btn-action-icon" style="color: #ef4444;" title="Xóa tập phim" @onclick="() => RequestDeleteEpisode(ep)">
                                        <CinemaIcon Name="CinemaIconName.Trash" Size="13" />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <AdminPagination CurrentPage="@currentPage"
                             PageSize="@pageSize"
                             TotalItems="@filteredEpisodes.Count"
                             OnPageChanged="p => { currentPage = p; StateHasChanged(); }" />
        }
    </div>
</section>

<!-- MODAL THÊM HOẶC CHỈNH SỬA TẬP PHIM -->
@if (showEpisodeModal)
{
    <div class="admin-modal-backdrop" @onclick="CloseEpisodeModal">
        <div class="admin-modal-card" style="max-width: 600px;" role="dialog" aria-modal="true" tabindex="-1" @onkeydown="HandleEpisodeModalKeyDown" @onclick:stopPropagation>
            <div class="admin-modal-header">
                <h3>@(editingEpisodeId.HasValue ? $"Chỉnh sửa tập #{episodeModel.EpisodeNumber}" : "Thêm tập phim mới")</h3>
                <button type="button" class="btn-close-modal" @onclick="CloseEpisodeModal">&times;</button>
            </div>

            <div class="admin-modal-body">
                <div class="form-row-2">
                    <div class="admin-form-group">
                        <label>Số thứ tự tập *</label>
                        <input type="number" @bind="episodeModel.EpisodeNumber" min="1" @onkeydown="HandleEpisodeInputKeyDown" />
                        @if (IsDuplicateEpisodeNumber)
                        {
                            <span class="field-error-hint" style="color: #ef4444; font-size: 0.74rem; margin-top: 3px; display: block;">
                                Tập số #@episodeModel.EpisodeNumber đã tồn tại trong tác phẩm này.
                            </span>
                        }
                    </div>
                    <div class="admin-form-group">
                        <label>Thời lượng (phút)</label>
                        <input type="number" @bind="episodeModel.DurationMinutes" min="1" @onkeydown="HandleEpisodeInputKeyDown" />
                    </div>
                </div>

                <div class="admin-form-group">
                    <label>Tiêu đề tập</label>
                    <input type="text" @bind="episodeModel.Title" placeholder="Ví dụ: Tập 01: Khởi đầu mới" @onkeydown="HandleEpisodeInputKeyDown" />
                </div>

                <div class="admin-form-group">
                    <label>Tóm tắt nội dung tập</label>
                    <textarea rows="2" @bind="episodeModel.Overview" class="admin-select-picker" style="cursor: text; resize: vertical;" placeholder="Tóm tắt ngắn gọn nội dung tập..."></textarea>
                </div>

                @if (!editingEpisodeId.HasValue)
                {
                    <div class="admin-section-divider" style="margin: 1rem 0 0.75rem 0;"></div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                        <h4 style="font-size: 0.85rem; margin: 0; color: var(--admin-text-body); font-weight: 600;">Khởi tạo luồng phát ban đầu</h4>
                        <div class="stream-input-mode-toggle">
                            <button type="button" class="mode-toggle-btn @(episodeStreamInputMode == StreamInputMode.DirectUrl ? "active" : "")" @onclick="() => SetEpisodeStreamInputMode(StreamInputMode.DirectUrl)">
                                <CinemaIcon Name="CinemaIconName.Globe" Size="12" />
                                <span>Nhập URL</span>
                            </button>
                            <button type="button" class="mode-toggle-btn @(episodeStreamInputMode == StreamInputMode.UploadR2 ? "active" : "")" @onclick="() => SetEpisodeStreamInputMode(StreamInputMode.UploadR2)">
                                <CinemaIcon Name="CinemaIconName.Upload" Size="12" />
                                <span>Tải lên R2</span>
                            </button>
                        </div>
                    </div>

                    @if (episodeStreamInputMode == StreamInputMode.DirectUrl)
                    {
                        <div class="form-row-2">
                            <div class="admin-form-group">
                                <label>Tên máy chủ phát (Server)</label>
                                <input type="text" list="stream-server-presets" @bind="episodeModel.ServerName" placeholder="VIP FastServer 1 (R2 Edge)" />
                            </div>
                            <div class="admin-form-group">
                                <label>Chất lượng</label>
                                <select @bind="episodeModel.Quality">
                                    <option value="1080p FHD">1080p FHD</option>
                                    <option value="4K UHD">4K UHD</option>
                                    <option value="720p HD">720p HD</option>
                                    <option value="480p SD">480p SD</option>
                                </select>
                            </div>
                        </div>

                        <div class="admin-form-group">
                            <label>URL luồng Stream (HLS .m3u8 hoặc file .mp4) *</label>
                            <input type="text" @bind="episodeModel.StreamUrl" placeholder="https://domain.com/video/master.m3u8 hoặc r2://webxemphim-movies/..." />
                        </div>
                    }
                    else
                    {
                        <div class="r2-upload-card">
                            <div class="r2-upload-picker-box">
                                <label class="r2-upload-dropzone @(selectedEpisodeVideoFile != null ? "has-file" : "")">
                                    <InputFile OnChange="HandleEpisodeVideoFileSelected" accept="video/mp4,video/webm,video/x-matroska,video/quicktime,.mp4,.webm,.mkv,.mov,.m4v" class="r2-file-input-hidden" />
                                    <CinemaIcon Name="CinemaIconName.Upload" Size="20" />
                                    <div class="r2-dropzone-text">
                                        @if (selectedEpisodeVideoFile != null)
                                        {
                                            <strong class="r2-filename">@selectedEpisodeVideoFile.Name</strong>
                                            <span class="r2-filesize">(@(Math.Round(selectedEpisodeVideoFile.Size / (1024.0 * 1024.0), 1)) MB)</span>
                                            <span class="r2-change-file">Bấm để chọn tệp video khác</span>
                                        }
                                        else
                                        {
                                            <strong>Bấm chọn tệp video từ máy tính để tải trực tiếp lên Cloudflare R2</strong>
                                            <span>Hỗ trợ MP4, MKV, WebM, MOV lên tới 4 GB</span>
                                        }
                                    </div>
                                </label>
                            </div>

                            <div class="form-row-2" style="margin-top: 0.75rem;">
                                <div class="admin-form-group">
                                    <label>Cụm máy chủ phát</label>
                                    <select @bind="episodeModel.ServerName">
                                        @foreach (var srv in InstalledServers)
                                        {
                                            <option value="@srv.Name">@srv.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="admin-form-group">
                                    <label>Chất lượng</label>
                                    <select @bind="episodeModel.Quality">
                                        <option value="1080p FHD">1080p FHD</option>
                                        <option value="4K UHD">4K UHD</option>
                                        <option value="720p HD">720p HD</option>
                                        <option value="480p SD">480p SD</option>
                                    </select>
                                </div>
                            </div>

                            @if (isUploadingEpisodeVideo)
                            {
                                <div class="r2-upload-progress-wrap">
                                    <div class="r2-progress-label">
                                        <span>Đang truyền tải video lên Cloudflare R2...</span>
                                        <strong class="font-mono-num">@episodeUploadProgress%</strong>
                                    </div>
                                    <div class="r2-progress-track">
                                        <div class="r2-progress-bar" style="width: @episodeUploadProgress%;"></div>
                                    </div>
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(episodeUploadSuccessMsg))
                            {
                                <div class="r2-upload-success-badge">
                                    <CinemaIcon Name="CinemaIconName.Check" Size="14" />
                                    <span>@episodeUploadSuccessMsg</span>
                                    <span class="r2-url-code" title="@episodeModel.StreamUrl">@episodeModel.StreamUrl</span>
                                </div>
                            }
                            else if (selectedEpisodeVideoFile != null && string.IsNullOrWhiteSpace(episodeModel.StreamUrl))
                            {
                                <div class="r2-upload-actions-row">
                                    <button type="button" class="btn-primary-action btn-sm" @onclick="ExecuteEpisodeR2Upload" disabled="@isUploadingEpisodeVideo">
                                        <CinemaIcon Name="CinemaIconName.Upload" Size="12" />
                                        <span>Tải lên Cloudflare R2 ngay</span>
                                    </button>
                                    <span class="r2-auto-upload-hint">Hoặc bấm "Thêm tập phim", hệ thống sẽ tự động tải lên và lưu tập.</span>
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            <div class="admin-modal-footer">
                <button type="button" class="btn-secondary-ghost" @onclick="CloseEpisodeModal">Hủy</button>
                <button type="button" class="btn-primary-action" @onclick="SaveEpisode" disabled="@isSavingEpisode">
                    @(isSavingEpisode ? "Đang lưu..." : editingEpisodeId.HasValue ? "Lưu thay đổi tập" : "Thêm tập phim")
                </button>
            </div>
        </div>
    </div>
}

<!-- MODAL QUẢN LÝ ẢNH NỀN TẬP PHIM -->
@if (showThumbnailModal && thumbEpisode != null)
{
    <div class="admin-modal-backdrop" @onclick="CloseThumbnailModal">
        <div class="admin-modal-card" style="max-width: 580px;" role="dialog" aria-modal="true" tabindex="-1" @onkeydown="HandleThumbnailModalKeyDown" @onclick:stopPropagation>
            <div class="admin-modal-header">
                <div>
                    <h3>Đổi ảnh nền: Tập @thumbEpisode.EpisodeNumber.ToString("00")</h3>
                    <p style="font-size: 0.78rem; color: rgba(255,255,255,0.5); margin: 0.2rem 0 0;">
                        Tập @thumbEpisode.EpisodeNumber - @thumbEpisode.Title
                    </p>
                </div>
                <button type="button" class="btn-close-modal" @onclick="CloseThumbnailModal">&times;</button>
            </div>

            <div class="admin-modal-body">
                @if (!string.IsNullOrEmpty(thumbModalAlert))
                {
                    <div class="form-alert success" style="margin-bottom: 1rem;" role="status">
                        @thumbModalAlert
                    </div>
                }
                @if (!string.IsNullOrEmpty(thumbModalError))
                {
                    <div class="form-alert error" style="margin-bottom: 1rem;" role="alert">
                        @thumbModalError
                    </div>
                }

                <div class="thumb-preview-box">
                    <span class="thumb-preview-label">Ảnh nền hiện tại:</span>
                    <div class="thumb-preview-canvas">
                        @if (!string.IsNullOrEmpty(thumbPreviewUrl))
                        {
                            <img src="@thumbPreviewUrl" alt="Xem trước ảnh nền mới" />
                        }
                        else if (!string.IsNullOrEmpty(thumbEpisode.ThumbnailUrl))
                        {
                            <img src="@thumbEpisode.ThumbnailUrl" alt="Ảnh nền tập @thumbEpisode.EpisodeNumber" onerror="this.onerror=null; this.src='@FallbackBackdrop';" />
                        }
                        else
                        {
                            <div class="thumb-preview-empty">Chưa có ảnh nền</div>
                        }
                    </div>

                    <div style="margin-top: 0.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
                        @if (isCustomThumbnail)
                        {
                            <span class="server-type-badge vip" style="font-size: 0.72rem;">Ảnh tải lên tùy chỉnh</span>
                            <button type="button" class="btn-secondary-ghost" style="font-size: 0.75rem; padding: 4px 10px;" @onclick="ResetThumbnailToDefault" disabled="@isUploadingThumbnail">
                                Khôi phục ảnh mặc định
                            </button>
                        }
                        else
                        {
                            <small style="color: rgba(255,255,255,0.45); font-size: 0.75rem;">
                                Đang dùng ảnh sinh tự động. Tải ảnh lên bên dưới để áp dụng ảnh riêng cho tập này.
                            </small>
                        }
                    </div>
                </div>

                <div class="thumb-input-mode-toggle">
                    <button type="button" class="btn-thumb-mode @(thumbInputMode == "file" ? "active" : "")" @onclick='() => SetThumbInputMode("file")'>
                        <CinemaIcon Name="CinemaIconName.Upload" Size="13" />
                        <span>Tải tệp từ máy tính</span>
                    </button>
                    <button type="button" class="btn-thumb-mode @(thumbInputMode == "url" ? "active" : "")" @onclick='() => SetThumbInputMode("url")'>
                        <CinemaIcon Name="CinemaIconName.Globe" Size="13" />
                        <span>Dán link URL ảnh trực tiếp</span>
                    </button>
                </div>

                @if (thumbInputMode == "file")
                {
                    <div class="admin-form-group" style="margin-top: 0.5rem;">
                        <label>Chọn tệp ảnh từ máy tính (JPG, PNG, WEBP, GIF, AVIF - Tối đa 5 MB):</label>
                        <InputFile @ref="thumbnailFileInput" OnChange="OnThumbnailFileSelected" class="admin-file-picker" accept=".jpg,.jpeg,.png,.webp,.gif,.avif" />
                    </div>
                }
                else
                {
                    <div class="admin-form-group" style="margin-top: 0.5rem;">
                        <label>Dán link hình ảnh trực tiếp (URL từ CDN hoặc Web):</label>
                        <div style="display: flex; gap: 0.5rem;">
                            <input type="text" class="quick-prober-input" @bind="thumbUrlInput" @bind:event="oninput" placeholder="https://image-cdn.com/posters/ep01.jpg" @onkeydown="HandleThumbUrlKeyDown" />
                            @if (!string.IsNullOrWhiteSpace(thumbUrlInput))
                            {
                                <button type="button" class="btn-secondary-ghost" style="font-size: 0.75rem; padding: 0 10px; white-space: nowrap;" @onclick="ApplyThumbUrlPreview">Xem thử</button>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="admin-modal-footer">
                <button type="button" class="btn-secondary-ghost" @onclick="CloseThumbnailModal">Đóng</button>
                <button type="button" class="btn-primary-action" @onclick="SubmitThumbnail" disabled="@(!CanSubmitThumbnail || isUploadingThumbnail)">
                    @(isUploadingThumbnail ? "Đang lưu..." : "Lưu ảnh nền mới")
                </button>
            </div>
        </div>
    </div>
}

<!-- MODAL KIỂM TRA LUỒNG (STREAM PROBER) -->
@if (showProbeModal)
{
    <div class="admin-modal-backdrop is-stacked" @onclick="CloseProbeModal">
        <div class="admin-modal-card" style="max-width: 580px;" role="dialog" aria-modal="true" tabindex="-1" @onkeydown="HandleProbeModalKeyDown" @onclick:stopPropagation>
            <div class="admin-modal-header">
                <h3>Kiểm tra kết nối luồng phát (Stream Probe)</h3>
                <button type="button" class="btn-close-modal" @onclick="CloseProbeModal">&times;</button>
            </div>

            <div class="admin-modal-body">
                <div class="admin-form-group">
                    <label>URL Video Stream cần kiểm tra</label>
                    <div style="display: flex; gap: 0.5rem;">
                        <input type="text" @bind="probeUrl" placeholder="https://cdn.example.com/video.mp4" style="flex: 1;" />
                        <button type="button" class="btn-primary-action" @onclick="ExecuteProbe" disabled="@isProbing">
                            @(isProbing ? "Đang ping..." : "Ping")
                        </button>
                    </div>
                </div>

                @if (probeResult != null)
                {
                    <div style="margin-top: 1rem; padding: 1rem; border-radius: 8px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
                            <strong>Kết quả kiểm tra:</strong>
                            @if (probeResult.IsSuccess)
                            {
                                <span class="probe-pill success">HTTP @probeResult.StatusCode - KẾT NỐI TỐT</span>
                            }
                            else
                            {
                                <span class="probe-pill fail">LỖI KẾT NỐI (HTTP @probeResult.StatusCode)</span>
                            }
                        </div>

                        <div class="drawer-metric-grid">
                            <div class="drawer-metric-card">
                                <span class="drawer-metric-label">Độ trễ Ping</span>
                                <span class="drawer-metric-val font-mono-num" style="color: @(probeResult.LatencyMs < 400 ? "#34d399" : "#fbbf24");">
                                    @probeResult.LatencyMs ms
                                </span>
                            </div>
                            <div class="drawer-metric-card">
                                <span class="drawer-metric-label">Định dạng</span>
                                <span class="drawer-metric-val font-mono-num" style="font-size: 0.95rem;">
                                    @probeResult.ContentType
                                </span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(probeResult.ErrorMessage))
                        {
                            <div style="margin-top: 0.75rem; color: #f87171; font-size: 0.8rem;">
                                Chi tiết lỗi: @probeResult.ErrorMessage
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="admin-modal-footer">
                <button type="button" class="btn-secondary-ghost" @onclick="CloseProbeModal">Đóng</button>
            </div>
        </div>
    </div>
}

<!-- MODAL QUẢN LÝ CÁC NGUỒN STREAM CỦA MỘT TẬP -->
@if (managingEpisode != null)
{
    <div class="admin-modal-backdrop" @onclick="CloseStreamsManager">
        <div class="admin-modal-card streams-modal-card" role="dialog" aria-modal="true" aria-labelledby="streams-modal-title" tabindex="-1" @onkeydown="HandleStreamsManagerKeyDown" @onclick:stopPropagation>
            <div class="admin-modal-header">
                <div style="min-width: 0;">
                    <h3 id="streams-modal-title">Luồng phát · Tập @managingEpisode.EpisodeNumber</h3>
                    <p class="streams-modal-sub" title="@managingEpisode.Title">@managingEpisode.Title</p>
                </div>
                <button type="button" class="btn-close-modal" @onclick="CloseStreamsManager">&times;</button>
            </div>

            <div class="admin-modal-body">
                @if (!string.IsNullOrEmpty(streamActionAlert))
                {
                    <div class="form-alert success" role="status">
                        @streamActionAlert
                    </div>
                }
                @if (!string.IsNullOrEmpty(streamActionError))
                {
                    <div class="form-alert error" role="alert">
                        @streamActionError
                    </div>
                }

                <div class="streams-toolbar">
                    <span class="streams-toolbar-count">
                        <strong>@currentStreamsList.Count</strong> luồng · <strong>@UniqueServerNames.Count</strong> máy chủ
                    </span>
                    <div class="streams-toolbar-actions">
                        <button type="button" class="btn-stream-tool @(showServerControlPanel ? "active" : "")" @onclick="ToggleServerControlPanel" title="Điều khiển lưu lượng, trần băng thông &amp; chính sách VIP/Free của các cụm máy chủ">
                            <CinemaIcon Name="CinemaIconName.Settings" Size="13" />
                            <span>Điều khiển Server</span>
                        </button>
                        <button type="button" class="btn-stream-tool @(showR2StudioUpload ? "active" : "")" @onclick="ToggleStudioR2Upload" title="Tải tệp video từ máy tính trực tiếp lên Cloudflare R2 cho tập này">
                            <CinemaIcon Name="CinemaIconName.Upload" Size="13" />
                            <span>Tải lên R2</span>
                        </button>
                        <button type="button" class="btn-stream-tool @(showQuickTester ? "active" : "")" @onclick="ToggleQuickTester" title="Mở thanh kiểm tra ping nhanh URL bất kỳ">
                            <CinemaIcon Name="CinemaIconName.Globe" Size="13" />
                            <span>Test URL nhanh</span>
                        </button>
                        @if (currentStreamsList.Count > 0)
                        {
                            <button type="button" class="btn-stream-tool" @onclick="ProbeAllStreams" disabled="@isBatchProbing" title="Đo độ trễ toàn bộ luồng phát">
                                <CinemaIcon Name="CinemaIconName.TrendingUp" Size="13" />
                                <span>@(isBatchProbing ? "Đang đo..." : "Ping tất cả")</span>
                            </button>
                        }
                        <button type="button" class="btn-stream-tool is-primary" @onclick="ToggleStreamForm" title="Mở form thêm nguồn phát mới">
                            <CinemaIcon Name="CinemaIconName.Plus" Size="13" />
                            <span>Nguồn phát</span>
                        </button>
                    </div>
                </div>

                @if (showR2StudioUpload)
                {
                    <div class="r2-upload-inline-panel">
                        <div class="r2-panel-head">
                            <div class="r2-panel-title">
                                <CinemaIcon Name="CinemaIconName.Upload" Size="13" />
                                <span>Tải video trực tiếp lên Cloudflare R2 · Tập @managingEpisode.EpisodeNumber</span>
                            </div>
                            <button type="button" class="btn-close-prober-mini" @onclick="() => showR2StudioUpload = false" title="Đóng">&times;</button>
                        </div>
                        <div class="r2-panel-body">
                            <label class="r2-upload-dropzone @(studioR2SelectedFile != null ? "has-file" : "")">
                                <InputFile OnChange="HandleStudioR2FileSelected" accept="video/mp4,video/webm,video/x-matroska,video/quicktime,.mp4,.webm,.mkv,.mov,.m4v" class="r2-file-input-hidden" />
                                <CinemaIcon Name="CinemaIconName.Upload" Size="18" />
                                <div class="r2-dropzone-text">
                                    @if (studioR2SelectedFile != null)
                                    {
                                        <strong class="r2-filename">@studioR2SelectedFile.Name</strong>
                                        <span class="r2-filesize">(@(Math.Round(studioR2SelectedFile.Size / (1024.0 * 1024.0), 1)) MB)</span>
                                        <span class="r2-change-file">Bấm để chọn tệp video khác</span>
                                    }
                                    else
                                    {
                                        <strong>Bấm chọn tệp video từ máy tính để tải trực tiếp lên Cloudflare R2</strong>
                                        <span>Hỗ trợ MP4, MKV, WebM, MOV lên tới 4 GB</span>
                                    }
                                </div>
                            </label>

                            <div class="r2-cluster-select-header">
                                <span class="r2-cluster-select-label">
                                    <CinemaIcon Name="CinemaIconName.HardDrive" Size="13" />
                                    <span>Cụm máy chủ phân phối nguồn phát (@studioR2SelectedServers.Count/@InstalledServers.Count cụm):</span>
                                </span>
                                <button type="button" class="btn-select-all-servers @(studioR2SelectAllServers ? "is-selected" : "")" @onclick="ToggleSelectAllR2Servers">
                                    @(studioR2SelectAllServers ? "✓ Đang chọn tất cả cụm" : "+ Chọn tất cả cụm máy chủ")
                                </button>
                            </div>

                            <div class="r2-server-selection-grid">
                                @foreach (var srv in InstalledServers)
                                {
                                    var isSelected = studioR2SelectedServers.Contains(srv.Name);
                                    var ceiling = GetServerQualityCeiling(srv.ServerKey, srv.DefaultCeiling);
                                    <div class="r2-server-card @(isSelected ? "selected" : "")" @onclick="() => ToggleR2ServerSelection(srv.Name)" title="@srv.Name - @(srv.ServerType == StreamServerType.VipFastServer ? "VIP FastServer" : srv.ServerType == StreamServerType.HydraCdn ? "Hydra CDN" : "Dự phòng")">
                                        <div class="r2-server-card-check">
                                            <input type="checkbox" checked="@isSelected" @onclick:stopPropagation @onchange="() => ToggleR2ServerSelection(srv.Name)" />
                                        </div>
                                        <div class="r2-server-card-info">
                                            <div class="r2-server-card-top">
                                                <span class="server-type-badge @(srv.ServerType == StreamServerType.VipFastServer ? "vip" : srv.ServerType == StreamServerType.HydraCdn ? "cdn" : "backup")">
                                                    @(srv.ServerType == StreamServerType.VipFastServer ? "VIP" : srv.ServerType == StreamServerType.HydraCdn ? "CDN" : "Dự phòng")
                                                </span>
                                                <strong class="r2-server-card-name">@srv.Name</strong>
                                            </div>
                                            <div class="r2-server-card-ceiling">
                                                <span class="r2-ceiling-lbl">Trần chất lượng:</span>
                                                <strong class="r2-ceiling-val font-mono-num">@ceiling</strong>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="r2-panel-controls-v2">
                                <div class="admin-form-group" style="width: 170px; margin-bottom: 0;">
                                    <label style="font-size: 0.72rem; margin-bottom: 2px;">Chất lượng Master gốc</label>
                                    <select class="quick-prober-input" @bind="studioR2MasterQuality">
                                        @foreach (var q in QualityPresets)
                                        {
                                            <option value="@q">@q</option>
                                        }
                                    </select>
                                </div>
                                <div class="r2-options-toggle-group">
                                    <label class="r2-checkbox-label" title="Ghi đè toàn bộ nguồn phát hiện có của tập bằng các luồng mới sinh">
                                        <input type="checkbox" @bind="studioR2ReplaceExisting" />
                                        <span>Thay thế các nguồn cũ</span>
                                    </label>
                                </div>
                                <button type="button" class="btn-primary-action" style="align-self: flex-end; height: 34px; padding: 0 16px; font-size: 0.78rem;" @onclick="ExecuteStudioR2Upload" disabled="@(isStudioR2Uploading || studioR2SelectedFile == null || studioR2SelectedServers.Count == 0)">
                                    <CinemaIcon Name="CinemaIconName.Upload" Size="13" />
                                    <span>@(isStudioR2Uploading ? (studioR2UploadProgress >= 99 ? "Đang xử lý hạ cấp R2..." : $"Đang tải {studioR2UploadProgress}%...") : $"Tải lên R2 & Phân phối ({studioR2SelectedServers.Count} cụm)")</span>
                                </button>
                            </div>

                            @if (isStudioR2Uploading)
                            {
                                <div class="r2-upload-progress-wrap" style="margin-top: 0.6rem;">
                                    <div class="r2-progress-label">
                                        <span>@(string.IsNullOrWhiteSpace(studioR2UploadStageText) ? "Đang truyền luồng dữ liệu tới Cloudflare R2..." : studioR2UploadStageText)</span>
                                        <strong class="font-mono-num">@studioR2UploadProgress%</strong>
                                    </div>
                                    <div class="r2-progress-track">
                                        <div class="r2-progress-bar" style="width: @studioR2UploadProgress%;"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (showQuickTester)
                {
                    <div class="quick-prober-inline-panel">
                        <div class="quick-prober-head">
                            <div class="quick-prober-title">
                                <CinemaIcon Name="CinemaIconName.Globe" Size="13" />
                                <span>Kiểm tra độ trễ &amp; Tính hợp lệ URL Stream</span>
                            </div>
                            <button type="button" class="btn-close-prober-mini" @onclick="() => showQuickTester = false" title="Đóng">&times;</button>
                        </div>
                        <div class="quick-prober-form">
                            <div class="quick-prober-input-wrap">
                                <input type="text" class="quick-prober-input" @bind="quickProbeUrl" @bind:event="oninput" placeholder="Dán URL video HLS (.m3u8) hoặc (.mp4) để kiểm tra kết nối ngay..." @onkeydown="HandleQuickProbeKeyDown" />
                                @if (!string.IsNullOrWhiteSpace(quickProbeUrl))
                                {
                                    <button type="button" class="quick-prober-clear" @onclick="() => quickProbeUrl = string.Empty" title="Xóa">&times;</button>
                                }
                            </div>
                            <button type="button" class="btn-primary-action quick-prober-btn" @onclick="ExecuteQuickProbe" disabled="@(isQuickProbing || string.IsNullOrWhiteSpace(quickProbeUrl))">
                                @(isQuickProbing ? "Đang đo..." : "Đo Ping")
                            </button>
                        </div>
                        @if (quickProbeResult != null)
                        {
                            <div class="quick-prober-result @(quickProbeResult.IsSuccess ? "is-ok" : "is-err")">
                                <div class="quick-prober-result-info">
                                    <span class="probe-pill @(quickProbeResult.IsSuccess ? "success" : "fail")">
                                        @(quickProbeResult.IsSuccess ? $"HTTP {quickProbeResult.StatusCode} OK" : $"HTTP {quickProbeResult.StatusCode} LỖI")
                                    </span>
                                    <span class="quick-prober-metric">Độ trễ: <strong style="color: @(quickProbeResult.LatencyMs < 400 ? "#34d399" : "#fbbf24");">@quickProbeResult.LatencyMs ms</strong></span>
                                    <span class="quick-prober-metric font-mono-num">Loại: <strong>@(string.IsNullOrWhiteSpace(quickProbeResult.ContentType) ? "N/A" : quickProbeResult.ContentType)</strong></span>
                                    @if (!string.IsNullOrEmpty(quickProbeResult.ErrorMessage))
                                    {
                                        <span class="quick-prober-errmsg">@quickProbeResult.ErrorMessage</span>
                                    }
                                </div>
                                @if (quickProbeResult.IsSuccess)
                                {
                                    <button type="button" class="btn-quick-add-stream" @onclick="UseQuickProbeUrlInForm" title="Điền URL này vào form thêm nguồn phát">
                                        <CinemaIcon Name="CinemaIconName.Plus" Size="12" />
                                        <span>Dùng URL này để thêm luồng</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }

                @if (showServerControlPanel)
                {
                    <div class="server-control-inline-panel">
                        <div class="server-control-head">
                            <div class="server-control-title-group">
                                <div class="server-control-title">
                                    <CinemaIcon Name="CinemaIconName.Settings" Size="14" />
                                    <span>Điều khiển Băng thông &amp; Phân phối Luồng Server</span>
                                </div>
                                <p class="server-control-desc">Chủ động điều phối lưu lượng mạng: Giữ luồng VIP luôn mượt mà tối đa, giới hạn trần băng thông luồng thường để tối ưu hóa hạ tầng.</p>
                            </div>
                            <div class="server-control-actions">
                                <a href="/admin/servers" class="btn-server-policy-reset" title="Mở trang Quản lý &amp; Điều khiển Máy chủ toàn diện">
                                    <CinemaIcon Name="CinemaIconName.HardDrive" Size="12" />
                                    <span>Trang chuyên sâu ↗</span>
                                </a>
                                <button type="button" class="btn-server-policy-reset" @onclick="ResetServerPolicies" disabled="@isSavingPolicy" title="Khôi phục toàn bộ thông số máy chủ về mặc định chuẩn">
                                    <CinemaIcon Name="CinemaIconName.Refresh" Size="12" />
                                    <span>Khôi phục mặc định</span>
                                </button>
                                <button type="button" class="btn-close-prober-mini" @onclick="() => showServerControlPanel = false" title="Đóng bảng điều khiển">&times;</button>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(policyActionAlert))
                        {
                            <div class="form-alert success" style="margin-bottom: 0.75rem;">@policyActionAlert</div>
                        }
                        @if (!string.IsNullOrEmpty(policyActionError))
                        {
                            <div class="form-alert error" style="margin-bottom: 0.75rem;">@policyActionError</div>
                        }

                        @if (isLoadingPolicies && serverPolicies.Count == 0)
                        {
                            <div class="server-control-loading">Đang tải cấu hình máy chủ từ hệ thống...</div>
                        }
                        else
                        {
                            <div class="server-policies-grid">
                                @foreach (var policy in serverPolicies)
                                {
                                    var isSavingThis = isSavingPolicy && savingPolicyKey == policy.ServerKey;
                                    var isVipCluster = policy.ServerKey == "vip";
                                    <div class="server-policy-card @(policy.IsActive ? "" : "is-inactive") @(isVipCluster ? "is-vip" : "")">
                                        <div class="server-policy-card-head">
                                            <div class="server-policy-card-ident">
                                                <span class="server-type-badge @(policy.ServerType == StreamServerType.VipFastServer ? "vip" : policy.ServerType == StreamServerType.HydraCdn ? "cdn" : "backup")">
                                                    @(policy.ServerType == StreamServerType.VipFastServer ? "VIP" : policy.ServerType == StreamServerType.HydraCdn ? "CDN" : "Dự phòng")
                                                </span>
                                                <strong>@policy.DisplayName</strong>
                                            </div>
                                            <label class="server-policy-switch" title="@(policy.IsActive ? "Máy chủ đang hoạt động" : "Máy chủ đang tạm dừng bảo trì")">
                                                <input type="checkbox" @bind="policy.IsActive" />
                                                <span class="slider round"></span>
                                                <span class="switch-label">@(policy.IsActive ? "Hoạt động" : "Bảo trì")</span>
                                            </label>
                                        </div>

                                        <div class="server-policy-card-body">
                                            <!-- Toggle VIP Exclusive -->
                                            <div class="policy-field-row">
                                                <div class="policy-field-info">
                                                    <span class="policy-field-name">Đặc quyền hội viên VIP</span>
                                                    <span class="policy-field-hint">Chỉ tài khoản VIP mới được kết nối vào cụm này</span>
                                                </div>
                                                <label class="policy-toggle">
                                                    <input type="checkbox" @bind="policy.IsVipOnly" />
                                                    <span class="policy-toggle-knob"></span>
                                                </label>
                                            </div>

                                            <!-- Bandwidth Throttling -->
                                            <div class="policy-field-col">
                                                <div class="policy-field-header-split">
                                                    <span class="policy-field-name">Trần băng thông phát (Bandwidth Cap)</span>
                                                    <strong class="policy-bw-val font-mono-num">
                                                        @(policy.MaxBandwidthKbps <= 0 ? "Không giới hạn (Gigabit)" : $"{Math.Round(policy.MaxBandwidthKbps / 1000.0, 1)} Mbps ({policy.MaxBandwidthKbps} Kbps)")
                                                    </strong>
                                                </div>
                                                <div class="policy-bw-control">
                                                    @if (isVipCluster)
                                                    {
                                                        <div class="policy-vip-unlimited-pill">
                                                            <CinemaIcon Name="CinemaIconName.Sparkles" Size="12" />
                                                            <span>Ưu tiên luồng VIP: Không bóp băng thông, truyền tải tốc độ tối đa</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="policy-presets-row">
                                                            <button type="button" class="btn-preset-bw @(policy.MaxBandwidthKbps == 1500 ? "active" : "")" @onclick="() => policy.MaxBandwidthKbps = 1500">1.5M (Tiết kiệm)</button>
                                                            <button type="button" class="btn-preset-bw @(policy.MaxBandwidthKbps == 3500 ? "active" : "")" @onclick="() => policy.MaxBandwidthKbps = 3500">3.5M (Chuẩn 1080p)</button>
                                                            <button type="button" class="btn-preset-bw @(policy.MaxBandwidthKbps == 5000 ? "active" : "")" @onclick="() => policy.MaxBandwidthKbps = 5000">5.0M (Nhanh)</button>
                                                            <button type="button" class="btn-preset-bw @(policy.MaxBandwidthKbps == 0 ? "active" : "")" @onclick="() => policy.MaxBandwidthKbps = 0">Không giới hạn</button>
                                                        </div>
                                                    }
                                                    <input type="range" min="0" max="15000" step="500" class="policy-bw-slider" @bind="policy.MaxBandwidthKbps" />
                                                </div>
                                            </div>

                                            <div class="policy-grid-2">
                                                <!-- Max Quality -->
                                                <div class="policy-field-col">
                                                    <span class="policy-field-name">Trần chất lượng phát</span>
                                                    <select class="quick-prober-input" @bind="policy.MaxQuality">
                                                        <option value="4K UHD">4K UHD</option>
                                                        <option value="1080p FHD">1080p FHD</option>
                                                        <option value="720p HD">720p HD</option>
                                                        <option value="480p SD">480p SD</option>
                                                    </select>
                                                </div>

                                                <!-- Pre-buffer -->
                                                <div class="policy-field-col">
                                                    <span class="policy-field-name">Bộ đệm mở đầu (Burst Buffer)</span>
                                                    <select class="quick-prober-input" @bind="policy.BufferInitialBurstKb">
                                                        <option value="1024">1 MB (Tiết kiệm)</option>
                                                        <option value="2048">2 MB (Chuẩn)</option>
                                                        <option value="4096">4 MB (Nhanh)</option>
                                                        <option value="8192">8 MB (Siêu tốc VIP)</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="server-policy-card-foot">
                                            <button type="button" class="btn-save-policy" @onclick="() => SaveServerPolicy(policy)" disabled="@isSavingThis">
                                                <CinemaIcon Name="CinemaIconName.Check" Size="13" />
                                                <span>@(isSavingThis ? "Đang lưu..." : "Lưu cụm máy chủ này")</span>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (currentStreamsList.Count == 0)
                {
                    <p class="streams-empty">Chưa có nguồn phát nào. Bấm <strong>Tải lên R2</strong> hoặc <strong>Nguồn phát</strong> để thêm luồng đầu tiên.</p>
                }
                else
                {
                    @if (currentStreamsList.Count > 1)
                    {
                        <div class="streams-filter-bar">
                            <div class="streams-filter-search">
                                <CinemaIcon Name="CinemaIconName.Search" Size="12" />
                                <input type="text" @bind="streamFilterText" @bind:event="oninput" placeholder="Lọc theo tên server hoặc URL..." />
                                @if (!string.IsNullOrWhiteSpace(streamFilterText))
                                {
                                    <button type="button" class="filter-clear-btn" @onclick="() => streamFilterText = string.Empty">&times;</button>
                                }
                            </div>
                            <div class="streams-filter-server">
                                <select @bind="selectedServerFilter">
                                    <option value="">Tất cả máy chủ (@UniqueServerNames.Count)</option>
                                    @foreach (var srv in UniqueServerNames)
                                    {
                                        <option value="@srv">@srv</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }

                    <div class="streams-list">
                        <div class="streams-head-row">
                            <span>#</span>
                            <span>Chất lượng</span>
                            <span>Đường dẫn</span>
                            <span>Ping</span>
                            <span></span>
                        </div>

                        @foreach (var serverGroup in FilteredStreamsList.GroupBy(s => s.ServerName))
                        {
                            var sName = serverGroup.Key;
                            var sType = serverGroup.First().ServerType;
                            <div class="stream-server-group">
                                <div class="stream-server-head">
                                    <span class="server-type-badge @(sType == StreamServerType.VipFastServer ? "vip" : sType == StreamServerType.HydraCdn ? "cdn" : "backup")">
                                        @(sType == StreamServerType.VipFastServer ? "VIP" : sType == StreamServerType.HydraCdn ? "CDN" : "Dự phòng")
                                    </span>
                                    <strong class="stream-server-name" title="@sName">@sName</strong>
                                    <span class="stream-server-count">@serverGroup.Count() luồng</span>
                                    @{
                                        var groupPolicy = GetPolicyForServer(sName, sType);
                                        if (groupPolicy != null)
                                        {
                                            if (!groupPolicy.IsActive)
                                            {
                                                <span class="server-policy-chip inactive" title="Máy chủ đang bảo trì, tạm dừng phát cho người xem">Đang bảo trì</span>
                                            }
                                            else if (groupPolicy.IsVipOnly)
                                            {
                                                <span class="server-policy-chip vip" title="Đặc quyền VIP: Không giới hạn băng thông, mở sẵn buffer 8MB">VIP · Line-Rate</span>
                                            }
                                            else if (groupPolicy.MaxBandwidthKbps > 0)
                                            {
                                                <span class="server-policy-chip throttled" title="Băng thông luồng thường giới hạn @(Math.Round(groupPolicy.MaxBandwidthKbps / 1000.0, 1)) Mbps · Trần @groupPolicy.MaxQuality">Giới hạn @(Math.Round(groupPolicy.MaxBandwidthKbps / 1000.0, 1))M</span>
                                            }
                                            else
                                            {
                                                <span class="server-policy-chip unmetered" title="Không giới hạn băng thông">Tốc độ cao</span>
                                            }
                                        }
                                    }
                                    @{
                                        var probedInGroup = serverGroup
                                            .Where(s => streamProbeResults.TryGetValue(s.Position, out var r) && r != null && r.IsSuccess)
                                            .Select(s => streamProbeResults[s.Position]!.LatencyMs)
                                            .ToList();
                                        if (probedInGroup.Count > 0)
                                        {
                                            var avg = Math.Round(probedInGroup.Average());
                                            <span class="server-latency-badge @(avg < 400 ? "fast" : "slow")" title="Độ trễ trung bình của máy chủ: @avg ms">
                                                @avg ms
                                            </span>
                                        }
                                    }
                                    <button type="button" class="btn-add-quality-pill" @onclick="() => QuickAddQualityForServer(sName, sType)" title="Thêm chất lượng khác cho @sName">
                                        + Chất lượng
                                    </button>
                                    <button type="button" class="btn-add-quality-pill" style="margin-left: 0.3rem;" @onclick="() => QuickUploadR2ForServer(sName)" title="Tải video lên R2 cho máy chủ @sName">
                                        + Tải R2
                                    </button>
                                </div>

                                @foreach (var s in serverGroup)
                                {
                                    var isEditingThis = editingStreamPosition == s.Position;
                                    var isProbingThis = probingPositions.Contains(s.Position);
                                    var hasResult = streamProbeResults.TryGetValue(s.Position, out var pr);
                                    var isDetailOpen = expandedProbeDetailPosition == s.Position && hasResult;

                                    <div class="stream-row @(isEditingThis ? "is-editing" : "") @(isDetailOpen ? "has-detail-open" : "")">
                                        <span class="stream-pos font-mono-num">#@s.Position</span>
                                        <span class="stream-quality-chip">@s.Quality</span>
                                        <span class="stream-url font-mono-num" title="@s.StreamUrl">@s.StreamUrl</span>
                                        <span class="stream-status">
                                            @if (isProbingThis)
                                            {
                                                <span class="probe-pill pinging" title="Đang gửi gói tin kiểm tra kết nối...">
                                                    <span class="probe-spinner-dot"></span> Đo...
                                                </span>
                                            }
                                            else if (hasResult && pr != null)
                                            {
                                                <button type="button" class="probe-pill @(pr.IsSuccess ? "success" : "fail") clickable" @onclick="() => ToggleProbeDetail(s.Position)" title="Bấm để xem/ẩn chi tiết kỹ thuật">
                                                    @(pr.IsSuccess ? $"{pr.LatencyMs}ms" : "Lỗi")
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="stream-status-idle clickable" @onclick="() => ProbeSingleStreamInline(s.Position, s.StreamUrl)" title="Bấm để đo ping ngay">
                                                    Chưa ping
                                                </button>
                                            }
                                        </span>
                                        <span class="stream-row-actions">
                                            <button type="button" class="btn-action-icon @(isProbingThis ? "is-loading" : "") @(isDetailOpen ? "active" : "")" title="Kiểm tra ping và xem telemetry luồng này" @onclick="() => ProbeSingleStreamInline(s.Position, s.StreamUrl)" disabled="@isProbingThis">
                                                <CinemaIcon Name="CinemaIconName.TrendingUp" Size="13" />
                                            </button>
                                            <button type="button" class="btn-action-icon @(isEditingThis ? "active" : "")" title="Chỉnh sửa luồng này" @onclick="() => StartEditStream(s)">
                                                <CinemaIcon Name="CinemaIconName.Edit" Size="13" />
                                            </button>
                                            <button type="button" class="btn-action-icon action-danger" title="Xóa nguồn phát #@s.Position" @onclick="() => RequestDeleteStreamSource(s.Position)">
                                                <CinemaIcon Name="CinemaIconName.Trash" Size="13" />
                                            </button>
                                        </span>
                                    </div>

                                    @if (isDetailOpen && pr != null)
                                    {
                                        <div class="stream-probe-inline-drawer">
                                            <div class="probe-drawer-header">
                                                <span class="probe-drawer-title">
                                                    <CinemaIcon Name="CinemaIconName.TrendingUp" Size="12" />
                                                    Chi tiết kết nối luồng #@s.Position (@s.Quality)
                                                </span>
                                                <button type="button" class="probe-drawer-close" @onclick="() => ToggleProbeDetail(s.Position)" title="Đóng chi tiết">&times;</button>
                                            </div>
                                            <div class="probe-drawer-grid">
                                                <div class="probe-drawer-item">
                                                    <span class="probe-drawer-lbl">Trạng thái HTTP</span>
                                                    <span class="probe-drawer-val font-mono-num @(pr.IsSuccess ? "val-ok" : "val-err")">
                                                        @(pr.IsSuccess ? $"HTTP {pr.StatusCode} OK" : $"HTTP {pr.StatusCode} (Thất bại)")
                                                    </span>
                                                </div>
                                                <div class="probe-drawer-item">
                                                    <span class="probe-drawer-lbl">Độ trễ phản hồi</span>
                                                    <span class="probe-drawer-val font-mono-num" style="color: @(pr.LatencyMs < 400 ? "#34d399" : "#fbbf24");">
                                                        @pr.LatencyMs ms
                                                    </span>
                                                </div>
                                                <div class="probe-drawer-item">
                                                    <span class="probe-drawer-lbl">Loại dữ liệu (Content-Type)</span>
                                                    <span class="probe-drawer-val font-mono-num" title="@pr.ContentType">
                                                        @(string.IsNullOrWhiteSpace(pr.ContentType) ? "Không xác định" : pr.ContentType)
                                                    </span>
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(pr.ErrorMessage))
                                            {
                                                <div class="probe-drawer-err">
                                                    <strong>Lỗi kết nối:</strong> @pr.ErrorMessage
                                                </div>
                                            }
                                            <div class="probe-drawer-footer">
                                                <button type="button" class="btn-probe-mini-action" @onclick="() => ProbeSingleStreamInline(s.Position, s.StreamUrl)" disabled="@isProbingThis">
                                                    ↻ Đo lại ping
                                                </button>
                                                <button type="button" class="btn-probe-mini-action ghost" @onclick="() => CopyStreamUrl(s.StreamUrl)">
                                                    Sao chép URL
                                                </button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }

                @if (showStreamForm || editingStreamPosition.HasValue)
                {
                    <div class="admin-section-divider" style="margin: 0;"></div>

                    <!-- ADD OR EDIT STREAM FORM -->
                    <div class="stream-editor-box @(editingStreamPosition.HasValue ? "is-editing" : "")">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                        <h4 style="font-size: 0.92rem; margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                            @if (editingStreamPosition.HasValue)
                            {
                                <span style="color: #fbbf24;">✎ Chỉnh sửa nguồn phát vị trí #@editingStreamPosition.Value</span>
                            }
                            else
                            {
                                <span>+ Thêm nguồn phát mới</span>
                            }
                        </h4>
                        @if (editingStreamPosition.HasValue)
                        {
                            <button type="button" class="btn-cancel-edit-pill" @onclick="CancelEditStream">
                                Hủy sửa (Thêm nguồn mới)
                            </button>
                        }
                    </div>

                    <div class="form-row-3">
                        <div class="admin-form-group">
                            <label>Tên máy chủ</label>
                            <input type="text" list="existing-servers-datalist" @bind="streamFormModel.ServerName" placeholder="VIP FastServer 1" @onkeydown="HandleStreamFormInputKeyDown" />
                            <datalist id="existing-servers-datalist">
                                @foreach (var sName in UniqueServerNames)
                                {
                                    <option value="@sName">@sName</option>
                                }
                            </datalist>
                        </div>
                        <div class="admin-form-group">
                            <label>Loại máy chủ</label>
                            <select @bind="streamFormModel.ServerType">
                                <option value="@StreamServerType.VipFastServer">VIP Fast Server</option>
                                <option value="@StreamServerType.HydraCdn">Hydra CDN</option>
                                <option value="@StreamServerType.BackupStream">Backup Stream</option>
                            </select>
                        </div>
                        <div class="admin-form-group">
                            <label>Chất lượng phát</label>
                            <input type="text" @bind="streamFormModel.Quality" placeholder="1080p FHD" @onkeydown="HandleStreamFormInputKeyDown" />
                        </div>
                    </div>

                    <!-- Quick Quality Preset Chips -->
                    <div class="quick-quality-presets" style="display: flex; align-items: center; gap: 0.4rem; margin-top: -0.25rem; margin-bottom: 0.75rem; flex-wrap: wrap;">
                        <span style="font-size: 0.72rem; color: var(--admin-text-muted);">Gợi ý chất lượng:</span>
                        @foreach (var q in QualityPresets)
                        {
                            <button type="button" class="preset-pill @(streamFormModel.Quality == q ? "active" : "")" @onclick="() => streamFormModel.Quality = q">
                                @q
                            </button>
                        }
                    </div>

                    <div class="admin-form-group">
                        <label>Đường dẫn luồng Stream (HLS .m3u8 hoặc file .mp4) *</label>
                        <div style="display: flex; gap: 0.5rem;">
                            <input type="text" @bind="streamFormModel.StreamUrl" placeholder="https://domain.com/video/stream.m3u8" style="flex: 1;" @onkeydown="HandleStreamFormInputKeyDown" />
                            <button type="button" class="btn-secondary-ghost" style="white-space: nowrap; font-size: 0.75rem; padding: 0 12px;" @onclick="ProbeFormUrl" disabled="@(isFormProbing || string.IsNullOrWhiteSpace(streamFormModel.StreamUrl))">
                                @(isFormProbing ? "Đang đo..." : "Kiểm tra Ping")
                            </button>
                        </div>
                        @if (formProbeResult != null)
                        {
                            <div style="margin-top: 0.4rem; display: flex; align-items: center; gap: 0.5rem; font-size: 0.75rem;">
                                <span class="probe-pill @(formProbeResult.IsSuccess ? "success" : "fail")">
                                    @(formProbeResult.IsSuccess ? $"HTTP {formProbeResult.StatusCode} ({formProbeResult.LatencyMs}ms)" : $"Lỗi HTTP {formProbeResult.StatusCode}")
                                </span>
                                @if (formProbeResult.IsSuccess)
                                {
                                    <span style="color: var(--admin-text-muted);">Định dạng: <strong style="color: var(--admin-text-body);">@formProbeResult.ContentType</strong></span>
                                }
                                else if (!string.IsNullOrEmpty(formProbeResult.ErrorMessage))
                                {
                                    <span style="color: #f87171;">@formProbeResult.ErrorMessage</span>
                                }
                            </div>
                        }
                    </div>

                    <div style="display: flex; gap: 0.75rem; margin-top: 0.75rem;">
                        <button type="button" class="btn-primary-action" @onclick="SaveStreamSource" disabled="@isSavingStream">
                            @(isSavingStream ? "Đang lưu..." : editingStreamPosition.HasValue ? "Lưu thay đổi luồng" : "Thêm nguồn phát này")
                        </button>
                        @if (editingStreamPosition.HasValue)
                        {
                            <button type="button" class="btn-secondary-ghost" @onclick="CancelEditStream">
                                Hủy sửa
                            </button>
                        }
                    </div>
                    </div>
                }
            </div>

            <div class="admin-modal-footer">
                <button type="button" class="btn-secondary-ghost" @onclick="CloseStreamsManager">Đóng</button>
            </div>
        </div>
    </div>
}

