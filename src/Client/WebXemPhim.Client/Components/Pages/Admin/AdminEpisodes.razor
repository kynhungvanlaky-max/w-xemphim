    private async Task SaveEpisode()
    {
        if (episodeModel.EpisodeNumber < 1)
        {
            actionError = "Số thứ tự tập phim phải lớn hơn hoặc bằng 1.";
            return;
        }

        if (IsDuplicateEpisodeNumber)
        {
            actionError = $"Tập phim số #{episodeModel.EpisodeNumber} đã tồn tại trong tác phẩm này. Vui lòng chọn số tập khác.";
            return;
        }

        isSavingEpisode = true;
        actionAlert = null;
        actionError = null;

        try
        {
            if (editingEpisodeId.HasValue)
            {
                var updateReq = new UpdateEpisodeRequest
                {
                    EpisodeNumber = episodeModel.EpisodeNumber,
                    Title = episodeModel.Title,
                    DurationMinutes = episodeModel.DurationMinutes,
                    Overview = episodeModel.Overview
                };
                var res = await AdminApi.UpdateEpisodeAsync(editingEpisodeId.Value, updateReq);
                if (res?.Success == true)
                {
                    actionAlert = $"Đã cập nhật thông tin tập {episodeModel.EpisodeNumber} thành công!";
                    showEpisodeModal = false;
                    editingEpisodeId = null;
                    await LoadEpisodesForMovie(selectedMovieId);
                }
                else
                {
                    actionError = res?.Message ?? "Không thể cập nhật tập phim.";
                }
            }
            else
            {
                if (episodeStreamInputMode == StreamInputMode.UploadR2 && selectedEpisodeVideoFile != null && string.IsNullOrWhiteSpace(episodeModel.StreamUrl))
                {
                    var uploaded = await ExecuteEpisodeR2Upload();
                    if (!uploaded) return;
                }

                if (string.IsNullOrWhiteSpace(episodeModel.StreamUrl))
                {
                    actionError = episodeStreamInputMode == StreamInputMode.UploadR2
                        ? "Vui lòng chọn tệp video từ máy tính để tải lên Cloudflare R2."
                        : "Vui lòng nhập URL Stream khởi tạo cho tập mới.";
                    return;
                }

                var res = await AdminApi.AddEpisodeAsync(selectedMovieId, episodeModel);
                if (res?.Success == true)
                {
                    actionAlert = $"Đã thêm tập {episodeModel.EpisodeNumber} thành công!";
                    showEpisodeModal = false;
                    selectedEpisodeVideoFile = null;
                    episodeUploadSuccessMsg = null;
                    await LoadEpisodesForMovie(selectedMovieId);
                }
                else
                {
                    actionError = res?.Message ?? "Không thể thêm tập phim.";
                }
            }
        }
        catch (Exception ex)
        {
            actionError = "Có lỗi xảy ra: " + ex.Message;
        }
        finally
        {
            isSavingEpisode = false;
            StateHasChanged();
        }
    }

