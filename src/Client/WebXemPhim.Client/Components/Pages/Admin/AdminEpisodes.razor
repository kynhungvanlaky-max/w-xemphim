    private void ResetThumbPreview()
    {
        if (!string.IsNullOrEmpty(thumbPreviewObjectUrl))
        {
            try { _ = JS.InvokeVoidAsync("adminTools.revokeObjectUrl", thumbPreviewObjectUrl); }
            catch { /* best-effort */ }
            thumbPreviewObjectUrl = null;
        }
        thumbPreviewUrl = null;
    }

    private async Task OnThumbnailFileSelected(InputFileChangeEventArgs e)
    {
        selectedThumbnailFile = e.File;
        thumbModalError = null;
        thumbModalAlert = null;

        if (selectedThumbnailFile != null)
        {
            if (selectedThumbnailFile.Size > 5 * 1024 * 1024)
            {
                thumbModalError = "Dung lượng tệp vượt quá giới hạn 5 MB.";
                selectedThumbnailFile = null;
                ResetThumbPreview();
                return;
            }

            try
            {
                // Dùng object URL thay vì đọc toàn bộ file vào base64 (tránh đơ UI với ảnh 5 MB).
                var preview = thumbnailFileInput is null
                    ? null
                    : await JS.InvokeAsync<ThumbPreviewResult>("adminTools.previewImageFromPicker", thumbnailFileInput.Element);
                if (preview?.Ok == true && !string.IsNullOrEmpty(preview.Url))
                {
                    ResetThumbPreview();
                    thumbPreviewObjectUrl = preview.Url;
                    thumbPreviewUrl = preview.Url;
                }
            }
            catch
            {
                // Non-critical preview failure
            }
        }
    }

