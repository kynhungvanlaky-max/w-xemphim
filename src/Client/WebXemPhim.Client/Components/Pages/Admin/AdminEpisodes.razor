    private async Task ProbeSingleStreamInline(int position, string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return;
        probingPositions.Add(position);
        StateHasChanged();
        try
        {
            var res = await AdminApi.ProbeStreamAsync(new ProbeStreamRequest { StreamUrl = url.Trim() });
            if (res?.Data != null)
            {
                streamProbeResults[position] = res.Data;
            }
            else
            {
                streamProbeResults[position] = new ProbeStreamResultDto
                {
                    IsSuccess = false,
                    ErrorMessage = res?.Message ?? "Không thể kết nối tới luồng stream."
                };
            }
            expandedProbeDetailPosition = position;
        }
        catch (Exception ex)
        {
            streamProbeResults[position] = new ProbeStreamResultDto
            {
                IsSuccess = false,
                ErrorMessage = ex.Message
            };
            expandedProbeDetailPosition = position;
        }
        finally
        {
            probingPositions.Remove(position);
            StateHasChanged();
        }
    }

