    private async Task OnThumbnailFileSelected(InputFileChangeEventArgs e)
    {
        selectedThumbnailFile = e.File;
        thumbModalError = null;
        thumbModalAlert = null;

        if (selectedThumbnailFile != null)
        {
            if (selectedThumbnailFile.Size > 5 * 1024 * 1024)
            {
                thumbModalError = "Dung lượng tệp vượt quá giới hạn 5 MB.";
                selectedThumbnailFile = null;
                thumbPreviewUrl = null;
                return;
            }

            try
            {
                var buffer = new byte[selectedThumbnailFile.Size];
                await using var stream = selectedThumbnailFile.OpenReadStream(5 * 1024 * 1024);
                var read = 0;
                while (read < buffer.Length)
                {
                    var chunk = await stream.ReadAsync(buffer.AsMemory(read, buffer.Length - read));
                    if (chunk <= 0) break;
                    read += chunk;
                }
                thumbPreviewUrl = $"data:{selectedThumbnailFile.ContentType};base64,{Convert.ToBase64String(buffer)}";
            }
            catch
            {
                // Non-critical preview failure
            }
        }
    }

    private async Task SubmitThumbnailUpload()
    {
        if (thumbEpisode == null || selectedThumbnailFile == null) return;
        isUploadingThumbnail = true;
        thumbModalAlert = null;
        thumbModalError = null;

        try
        {
            await using var stream = selectedThumbnailFile.OpenReadStream(5 * 1024 * 1024);
            var res = await AdminApi.UploadEpisodeThumbnailAsync(thumbEpisode.Id, stream, selectedThumbnailFile.Name);
            if (res?.Success == true)
            {
                thumbModalAlert = "Đã cập nhật ảnh nền tập thành công!";
                thumbEpisode.ThumbnailUrl = res.Data?.ThumbnailUrl ?? thumbEpisode.ThumbnailUrl;
                thumbPreviewUrl = null;
                selectedThumbnailFile = null;
                await LoadEpisodesForMovie(selectedMovieId);
            }
            else
            {
                thumbModalError = res?.Message ?? "Không thể tải lên ảnh nền.";
            }
        }
        catch (Exception ex)
        {
            thumbModalError = "Lỗi khi tải ảnh: " + ex.Message;
        }
        finally
        {
            isUploadingThumbnail = false;
            StateHasChanged();
        }
    }

    private async Task ResetThumbnailToDefault()
