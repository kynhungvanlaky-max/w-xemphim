    /// <summary>Bật/tắt một ô lọc. Ẩn ô lọc sẽ xóa luôn giá trị đang chọn để tránh lọc ngầm.</summary>
    private async Task SetFilterVisibility(string key, bool visible)
    {
        // Bỏ qua sự kiện change phát sinh khi popover đã đóng.
        if (!showFilterSettings) return;

        if (visible) hiddenFilters.Remove(key);
        else hiddenFilters.Add(key);

        var needsReload = !visible && ClearFilterValue(key);
        await SaveFilterPrefsAsync();

        if (needsReload) ApplyEpisodeFilters();
        StateHasChanged();
    }

    /// <summary>Xóa giá trị của bộ lọc vừa bị ẩn. Trả về true nếu thực sự có thay đổi.</summary>
    private bool ClearFilterValue(string key)
    {
        switch (key)
        {
            case "search" when !string.IsNullOrEmpty(episodeSearchQuery):
                episodeSearchQuery = "";
                return true;
            case "range" when !string.IsNullOrEmpty(selectedEpRange):
                selectedEpRange = "";
                return true;
            case "streams" when !string.IsNullOrEmpty(selectedStreamStatus):
                selectedStreamStatus = "";
                return true;
            case "duration" when !string.IsNullOrEmpty(selectedDurationFilter):
                selectedDurationFilter = "";
                return true;
            case "sort" when selectedEpSort != "ep_asc":
                selectedEpSort = "ep_asc";
                return true;
            default:
                return false;
        }
    }

    private async Task ShowAllFiltersAsync()
    {
        if (hiddenFilters.Count == 0) return;
        hiddenFilters.Clear();
        await SaveFilterPrefsAsync();
    }

    private void ClearEpisodeSearchQuery()
    {
        episodeSearchQuery = "";
        ApplyEpisodeFilters();
    }

    /// <summary>Đọc lại lựa chọn ẩn/hiện bộ lọc đã lưu trong localStorage của trình duyệt.</summary>
    private async Task LoadFilterPrefsAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("adminTools.getStoredJson", FilterPrefsStorageKey);
            if (string.IsNullOrWhiteSpace(json)) return;

            var prefs = System.Text.Json.JsonSerializer.Deserialize<EpisodeFilterPrefs>(json);
            if (prefs is null) return;

            hiddenFilters.Clear();
            foreach (var key in prefs.Hidden.Where(k => FilterOptions.Any(o => o.Key == k)))
            {
                hiddenFilters.Add(key);
            }
            filtersCollapsed = prefs.Collapsed;
        }
        catch
        {
            // Tùy chọn hiển thị chỉ là tiện ích: localStorage bị chặn hoặc dữ liệu hỏng thì dùng mặc định.
        }
    }

    private async Task SaveFilterPrefsAsync()
    {
        try
        {
            var prefs = new EpisodeFilterPrefs(hiddenFilters.ToList(), filtersCollapsed);
            var json = System.Text.Json.JsonSerializer.Serialize(prefs);
            await JS.InvokeVoidAsync("adminTools.setStoredJson", FilterPrefsStorageKey, json);
        }
        catch
        {
            // Không lưu được thì thôi, không chặn thao tác của admin.
        }
    }

    private sealed record EpisodeFilterPrefs(List<string> Hidden, bool Collapsed);

    private async Task LoadEpisodesForMovie(int movieId)
    {
        isLoadingEpisodes = true;
        currentPage = 1;
        try
        {
            episodesList = await AdminApi.GetEpisodesAsync(movieId);
            ApplyEpisodeFilters();
        }
        catch (Exception ex)
        {
            actionError = "Không thể tải danh sách tập: " + ex.Message;
        }
        finally
        {
            isLoadingEpisodes = false;
            StateHasChanged();
        }
    }

    private void ApplyEpisodeFilters()
    {
        var result = episodesList.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(episodeSearchQuery))
        {
            var q = episodeSearchQuery.Trim();
            if (int.TryParse(q.TrimStart('#'), out int epNum))
            {
                result = result.Where(e => e.EpisodeNumber == epNum 
                                        || e.Title.Contains(q, StringComparison.OrdinalIgnoreCase) 
                                        || (e.Overview != null && e.Overview.Contains(q, StringComparison.OrdinalIgnoreCase)));
            }
            else
            {
                result = result.Where(e => e.Title.Contains(q, StringComparison.OrdinalIgnoreCase)
                                        || (e.Overview != null && e.Overview.Contains(q, StringComparison.OrdinalIgnoreCase)));
            }
        }

        if (!string.IsNullOrWhiteSpace(selectedEpRange))
        {
            result = selectedEpRange switch
            {
                "1-10" => result.Where(e => e.EpisodeNumber >= 1 && e.EpisodeNumber <= 10),
                "11-25" => result.Where(e => e.EpisodeNumber >= 11 && e.EpisodeNumber <= 25),
                "26-50" => result.Where(e => e.EpisodeNumber >= 26 && e.EpisodeNumber <= 50),
                "51+" => result.Where(e => e.EpisodeNumber >= 51),
                _ => result
            };
        }

        if (!string.IsNullOrWhiteSpace(selectedStreamStatus))
        {
            result = selectedStreamStatus switch
            {
                "has_streams" => result.Where(e => e.StreamSources != null && e.StreamSources.Count > 0),
                "no_streams" => result.Where(e => e.StreamSources == null || e.StreamSources.Count == 0),
                "has_vip" => result.Where(e => e.StreamSources != null && e.StreamSources.Any(s => s.ServerType == StreamServerType.VipFastServer)),
                _ => result
            };
        }

        if (!string.IsNullOrWhiteSpace(selectedDurationFilter))
        {
            result = selectedDurationFilter switch
            {
                "short" => result.Where(e => e.DurationMinutes > 0 && e.DurationMinutes < 25),
                "medium" => result.Where(e => e.DurationMinutes >= 25 && e.DurationMinutes <= 50),
                "long" => result.Where(e => e.DurationMinutes > 50),
                _ => result
            };
        }

        result = selectedEpSort switch
        {
            "ep_desc" => result.OrderByDescending(e => e.EpisodeNumber),
            "duration_desc" => result.OrderByDescending(e => e.DurationMinutes).ThenBy(e => e.EpisodeNumber),
            "duration_asc" => result.OrderBy(e => e.DurationMinutes).ThenBy(e => e.EpisodeNumber),
            "title_asc" => result.OrderBy(e => e.Title),
            _ => result.OrderBy(e => e.EpisodeNumber)
        };

        filteredEpisodes = result.ToList();
        currentPage = 1;
    }

    private void OnEpRangeChanged(ChangeEventArgs e)
    {
        selectedEpRange = e.Value?.ToString() ?? "";
        ApplyEpisodeFilters();
    }

    private void OnStreamStatusChanged(ChangeEventArgs e)
    {
        selectedStreamStatus = e.Value?.ToString() ?? "";
        ApplyEpisodeFilters();
    }

    private void OnDurationFilterChanged(ChangeEventArgs e)
    {
        selectedDurationFilter = e.Value?.ToString() ?? "";
        ApplyEpisodeFilters();
    }

    private void OnEpSortChanged(ChangeEventArgs e)
    {
        selectedEpSort = e.Value?.ToString() ?? "ep_asc";
        ApplyEpisodeFilters();
    }

    private void ResetAllEpisodeFilters()
    {
        episodeSearchQuery = "";
        selectedEpRange = "";
        selectedStreamStatus = "";
        selectedDurationFilter = "";
        selectedEpSort = "ep_asc";
        ApplyEpisodeFilters();
    }

    private void OpenAddEpisodeModal()
    {
        showMoviePicker = false;
        showFilterSettings = false;
        editingEpisodeId = null;
        episodeStreamInputMode = StreamInputMode.DirectUrl;
        selectedEpisodeVideoFile = null;
        episodeUploadSuccessMsg = null;
        isUploadingEpisodeVideo = false;
        episodeUploadProgress = 0;
        int nextEp = episodesList.Count > 0 ? episodesList.Max(e => e.EpisodeNumber) + 1 : 1;
        int defaultDuration = episodesList.LastOrDefault()?.DurationMinutes is int d && d > 0 ? d : (SelectedMovie?.DurationMinutes > 0 ? SelectedMovie.DurationMinutes : 45);
        episodeModel = new UpsertEpisodeRequest
        {
            EpisodeNumber = nextEp,
            Title = $"Tập {nextEp:00}",
            DurationMinutes = defaultDuration,
            StreamUrl = "",
            ServerName = "VIP 1 (Hà Nội)",
            Quality = "1080p FHD"
        };
        showEpisodeModal = true;
    }

    private void SetEpisodeStreamInputMode(StreamInputMode mode)
    {
        episodeStreamInputMode = mode;
        actionError = null;
        if (mode == StreamInputMode.UploadR2 && string.IsNullOrWhiteSpace(episodeModel.ServerName))
        {
            episodeModel.ServerName = "VIP 1 (Hà Nội)";
        }
    }

    private void HandleEpisodeVideoFileSelected(InputFileChangeEventArgs e)
    {
        actionError = null;
        episodeUploadSuccessMsg = null;
        var file = e.File;
        if (file == null) return;

        const long maxBytes = 4L * 1024 * 1024 * 1024; // 4 GB
        if (file.Size > maxBytes)
        {
            actionError = $"Dung lượng video ({Math.Round(file.Size / (1024.0 * 1024.0), 1)} MB) vượt quá giới hạn cho phép (4096 MB).";
            return;
        }

        selectedEpisodeVideoFile = file;

        // Auto-detect quality from filename if present
        var lower = file.Name.ToLowerInvariant();
        if (lower.Contains("4k") || lower.Contains("2160p")) episodeModel.Quality = "4K UHD";
        else if (lower.Contains("1080p") || lower.Contains("fhd")) episodeModel.Quality = "1080p FHD";
        else if (lower.Contains("720p") || lower.Contains("hd")) episodeModel.Quality = "720p HD";
        else if (lower.Contains("480p") || lower.Contains("sd")) episodeModel.Quality = "480p SD";

        if (string.IsNullOrWhiteSpace(episodeModel.ServerName))
        {
            episodeModel.ServerName = "VIP 1 (Hà Nội)";
        }
    }

    private async Task<bool> ExecuteEpisodeR2Upload()
    {
        if (selectedEpisodeVideoFile == null) return false;

        isUploadingEpisodeVideo = true;
        episodeUploadProgress = 0;
        actionError = null;
        episodeUploadSuccessMsg = null;
        StateHasChanged();

        try
        {
            await using var stream = selectedEpisodeVideoFile.OpenReadStream(maxAllowedSize: 4L * 1024 * 1024 * 1024);
            var progress = new Progress<double>(p =>
            {
                episodeUploadProgress = Math.Round(p, 0);
                InvokeAsync(StateHasChanged);
            });

            var res = await AdminApi.UploadToR2Async(stream, selectedEpisodeVideoFile.Name, "episodes", selectedEpisodeVideoFile.Size, progress);
            if (res?.Success == true && !string.IsNullOrWhiteSpace(res.Data?.Url))
            {
                episodeModel.StreamUrl = res.Data.Url;
                episodeUploadSuccessMsg = $"Đã tải lên R2 thành công ({Math.Round(selectedEpisodeVideoFile.Size / (1024.0 * 1024.0), 1)} MB)!";
