<!-- HỘP THOẠI XÁC NHẬN CẤP QUYỀN VIP TRỰC TIẾP -->
<AdminConfirmDialog IsOpen="@showGrantConfirm"
                    Title="Xác nhận cấp quyền VIP"
                    Message="@GrantConfirmMessage"
                    ConfirmText="Cấp VIP"
                    CancelText="Huỷ"
                    Variant="warning"
                    ConfirmPhrase="Cấp VIP"
                    OnConfirm="ConfirmManualVipGrant"
                    OnCancel="CancelManualVipGrant" />

@code {
    private enum AdminVipTab { Transactions, Plans, ManualGrant }
    private AdminVipTab activeTab = AdminVipTab.Transactions;

    // Payments data (server-side paging)
    private List<PaymentDto> paymentsList = [];
    private List<VipPlanDto> vipPlans = [];
    private string searchQuery = "";
    private readonly SearchDebouncer paymentSearchDebouncer = new();
    private PaymentStatus? statusFilter = null;
    private string? methodFilter = null;
    private string? sortBy = null;
    private bool isLoadingPayments = true;
    private string? actionAlert;
    private string? actionError;
    private int currentPage = 1;
    private int pageSize = 10;

    // Tùy chỉnh bộ lọc: ẩn/hiện từng ô lọc, lưu lại theo trình duyệt.
    private const string FilterPrefsStorageKey = "cinemaflow_admin_vip_filter_prefs_v2";
    private static readonly (string Key, string Label)[] FilterOptions =
    [
        ("status", "Trạng thái giao dịch"),
        ("method", "Phương thức thanh toán"),
        ("sort", "Sắp xếp"),
        ("search", "Tìm kiếm giao dịch")
    ];
    // Mặc định ban đầu: chưa bật ô lọc nào (tick trống) — admin tự chọn ô cần dùng.
    private readonly HashSet<string> hiddenFilters = [.. FilterOptions.Select(o => o.Key)];
    private bool showFilterSettings;
    private bool filtersCollapsed;

    // Totals returned by the server
    private int totalItems = 0;          // tổng bản ghi khớp bộ lọc hiện tại (PagedResult.TotalItems)
    private int countAll = 0;            // tổng đơn trong phạm vi tìm kiếm + phương thức
    private int countPending = 0;        // số đơn chờ duyệt trong phạm vi
    private int countCompleted = 0;
    private AdminDashboardDto? stats;      // số đơn hoàn tất trong phạm vi
    private int countFailed = 0;         // số đơn từ chối/hủy trong phạm vi

    // Approval modal
    private PaymentDto? approvingPayment;
    private string approvalReference = "";
    private string approvalNote = "";
    private string? approvalError;
    private bool isSubmittingApproval = false;

    // Rejection modal
    private PaymentDto? rejectingPayment;
    private string rejectionReason = "";
    private string? rejectionError;
    private bool isSubmittingRejection = false;

    // Detail modal
    private PaymentDto? detailPayment;

    // Plan management modal
    private bool isEditingPlanModal;
    private bool isNewPlan;
    private UpsertVipPlanRequest? editingPlan;
    private string editingPlanDiscountBadge = "";
    private string editingPlanBenefitsText = "";
    private string? planFormError;
    private bool isSubmittingPlan;

    // Manual VIP Grant
    private string grantTargetUser = "";
    private int grantDays = 30;
    private string grantReason = "";
    private bool isSubmittingGrant;
    private bool showGrantConfirm;
    private UserDto? lastGrantedUser;

    private bool HasActivePaymentFilters =>
        statusFilter.HasValue ||
        !string.IsNullOrEmpty(methodFilter) ||
        !string.IsNullOrEmpty(sortBy) ||
        !string.IsNullOrWhiteSpace(searchQuery);

    private string GrantConfirmMessage =>
        $"Bạn sắp cấp quyền VIP {grantDays} ngày cho thành viên \"{grantTargetUser}\" với lý do: \"{grantReason}\". " +
        "Thao tác này sẽ ghi thẳng vào hồ sơ thành viên và KHÔNG THỂ HOÀN TÁC trên hệ thống.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Auth.InitializeAsync();
            await LoadFilterPrefsAsync();
            await LoadData();

            // Lệnh tắt nhanh trong Command Palette mở thẳng tab giao dịch chờ duyệt.
            if (string.Equals(RouteFilter, "pending", StringComparison.OrdinalIgnoreCase))
            {
                statusFilter = PaymentStatus.Pending;
                currentPage = 1;
                await ReloadPaymentsAsync();
            }
        }
    }

    /// <summary>Được nạp từ query string, ví dụ /admin/vip?filter=pending.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "filter")]
    public string? RouteFilter { get; set; }

    private void SwitchTab(AdminVipTab tab)
    {
        activeTab = tab;
        actionAlert = null;
        actionError = null;
    }

    private async Task LoadData()
    {
        if (!Auth.IsAdmin) return;
        isLoadingPayments = true;
        try
        {
            var plansTask = AdminApi.GetVipPlansAsync();
            var statsTask = AdminApi.GetStatsAsync();
            await Task.WhenAll(plansTask, statsTask, LoadPaymentsAsync(), LoadScopeCountsAsync());
            vipPlans = await plansTask;
            stats = await statsTask;
        }
        catch (Exception ex)
        {
            actionError = "Không thể tải dữ liệu: " + ex.Message;
        }
        finally
        {
            isLoadingPayments = false;
            StateHasChanged();
        }
    }

    /// <summary>Nạp trang hiện tại của danh sách giao dịch từ server.</summary>
    private async Task LoadPaymentsAsync()
    {
        var result = await AdminApi.GetPaymentsPagedAsync(
            page: currentPage,
            pageSize: pageSize,
            query: NormalizedQuery,
            status: statusFilter,
            method: methodFilter,
            sortBy: sortBy);

        paymentsList = result.Items;
        totalItems = result.TotalItems;
    }

    /// <summary>
    /// Đếm số đơn theo từng trạng thái (phạm vi = từ khoá tìm kiếm + phương thức thanh toán)
    /// để các thẻ KPI và tab hiển thị đúng số liệu toàn hệ thống thay vì số liệu của trang hiện tại.
    /// </summary>
    private async Task LoadScopeCountsAsync()
    {
        var pendingTask = AdminApi.GetPaymentsPagedAsync(page: 1, pageSize: 1, query: NormalizedQuery, status: PaymentStatus.Pending, method: methodFilter);
        var completedTask = AdminApi.GetPaymentsPagedAsync(page: 1, pageSize: 1, query: NormalizedQuery, status: PaymentStatus.Completed, method: methodFilter);
        var failedTask = AdminApi.GetPaymentsPagedAsync(page: 1, pageSize: 1, query: NormalizedQuery, status: PaymentStatus.Failed, method: methodFilter);
        var allTask = AdminApi.GetPaymentsPagedAsync(page: 1, pageSize: 1, query: NormalizedQuery, method: methodFilter);

        await Task.WhenAll(pendingTask, completedTask, failedTask, allTask);

        countPending = pendingTask.Result.TotalItems;
        countCompleted = completedTask.Result.TotalItems;
        countFailed = failedTask.Result.TotalItems;
        countAll = allTask.Result.TotalItems;
    }

    private string? NormalizedQuery => string.IsNullOrWhiteSpace(searchQuery) ? null : searchQuery.Trim();

    /// <summary>Nạp lại danh sách (kèm số liệu đếm) sau khi bộ lọc thay đổi.</summary>
    private async Task ReloadPaymentsAsync(bool reloadScopeCounts = false)
    {
        if (!Auth.IsAdmin) return;
        isLoadingPayments = true;
        try
        {
            await Task.WhenAll(
                LoadPaymentsAsync(),
                reloadScopeCounts ? LoadScopeCountsAsync() : Task.CompletedTask);
        }
        catch (Exception ex)
        {
            actionError = "Không thể tải dữ liệu: " + ex.Message;
        }
        finally
        {
            isLoadingPayments = false;
            StateHasChanged();
        }
    }

    private async Task FilterByStatus(PaymentStatus? status)
    {
        if (status == null)
        {
            // "Tất cả" phải xóa TOÀN BỘ bộ lọc (trạng thái + phương thức + sắp xếp + tìm kiếm).
            statusFilter = null;
            methodFilter = null;
            sortBy = null;
            searchQuery = "";
            currentPage = 1;
            await ReloadPaymentsAsync(reloadScopeCounts: true);
            return;
        }

        statusFilter = status;
        currentPage = 1;
        await ReloadPaymentsAsync();
    }

    private async Task ClearStatusFilter()
    {
        statusFilter = null;
        currentPage = 1;
        await ReloadPaymentsAsync();
    }

    private async Task OnMethodFilterChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        methodFilter = string.IsNullOrWhiteSpace(value) ? null : value;
        currentPage = 1;
        await ReloadPaymentsAsync(reloadScopeCounts: true);
    }

    private async Task ClearMethodFilter()
    {
