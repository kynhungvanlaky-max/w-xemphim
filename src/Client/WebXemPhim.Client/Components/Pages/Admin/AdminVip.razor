@page "/admin/vip"
@layout WebXemPhim.Client.Components.Layout.AdminLayout
@using WebXemPhim.Shared.Models
@using WebXemPhim.Shared.Enums
@using WebXemPhim.Client.Components.Icons
@using WebXemPhim.Client.Services
@inject NavigationManager Nav
@inject AuthState Auth
@inject IAdminApiClient AdminApi
@inject IJSRuntime JS
@implements IDisposable

<CinemaPageTitle>Quản trị Gói VIP &amp; Tài chính - CinemaFlow Admin</CinemaPageTitle>

<!-- Topbar -->
<header class="admin-topbar">
    <div class="topbar-title-group">
        <h1 class="topbar-title">Hệ thống Gói VIP &amp; Tài chính</h1>
        <p class="topbar-subtitle">Kiểm soát dòng tiền, đối soát thanh toán chuyển khoản và phân quyền VIP thành viên</p>
    </div>

    <div class="topbar-actions">
        @if (activeTab == AdminVipTab.Transactions)
        {
            <button type="button" class="btn-secondary-ghost" @onclick="ExportFinancialCsv" title="Xuất báo cáo danh sách giao dịch ra file CSV">
                <CinemaIcon Name="CinemaIconName.Bookmark" Size="15" />
                <span>Xuất CSV</span>
            </button>
        }
        else if (activeTab == AdminVipTab.Plans)
        {
            <button type="button" class="btn-primary-action" @onclick="OpenCreatePlanModal">
                <CinemaIcon Name="CinemaIconName.Plus" Size="15" />
                <span>Thêm gói mới</span>
            </button>
        }

        <button type="button" class="btn-secondary-ghost" @onclick="RefreshData">
            <CinemaIcon Name="CinemaIconName.Refresh" Size="15" />
            <span>Làm mới</span>
        </button>

        @if (activeTab == AdminVipTab.Transactions)
        {
            <div class="topbar-search-pill">
                <CinemaIcon Name="CinemaIconName.Search" Size="16" Class="search-icon" />
                <input type="text" aria-label="Tìm theo mã đơn, email, họ tên" placeholder="Tìm theo mã đơn, email, họ tên..." @bind="searchQuery" @bind:event="oninput" @bind:after="SchedulePaymentSearch" @onkeydown="HandleSearchKeyDown" />
            </div>
        }
    </div>
</header>

@if (!string.IsNullOrEmpty(actionAlert))
{
    <div class="form-alert success" style="margin-bottom: 1.25rem;" role="status">
        @actionAlert
    </div>
}

@if (!string.IsNullOrEmpty(actionError))
{
    <div class="form-alert error" style="margin-bottom: 1.25rem;" role="alert">
        @actionError
    </div>
}

<!-- VIP Admin Navigation Tabs -->
<div class="vip-admin-tabs">
    <button type="button" class="vip-tab-pill @(activeTab == AdminVipTab.Transactions ? "active" : "")" @onclick="() => SwitchTab(AdminVipTab.Transactions)">
        <CinemaIcon Name="CinemaIconName.Dashboard" Size="16" />
        <span>Lịch sử Giao dịch &amp; Đối soát</span>
        <span class="tab-badge">@countAll</span>
    </button>
    <button type="button" class="vip-tab-pill @(activeTab == AdminVipTab.Plans ? "active" : "")" @onclick="() => SwitchTab(AdminVipTab.Plans)">
        <CinemaIcon Name="CinemaIconName.Crown" Size="16" />
        <span>Cấu hình Gói VIP</span>
        <span class="tab-badge">@vipPlans.Count</span>
    </button>
    <button type="button" class="vip-tab-pill @(activeTab == AdminVipTab.ManualGrant ? "active" : "")" @onclick="() => SwitchTab(AdminVipTab.ManualGrant)">
        <CinemaIcon Name="CinemaIconName.Users" Size="16" />
        <span>Cấp VIP Trực tiếp</span>
    </button>
</div>

<!-- TAB 1: GIAO DỊCH & ĐỐI SOÁT -->
@if (activeTab == AdminVipTab.Transactions)
{
    <!-- 4 KPI Cards -->
    <section class="admin-kpi-grid-4">
        <div class="kpi-card">
            <div class="kpi-icon-wrap gold"><CinemaIcon Name="CinemaIconName.Crown" Size="24" /></div>
            <div class="kpi-body">
                <span class="kpi-value font-mono-num" title="Tổng doanh thu của các giao dịch đã hoàn tất, lấy từ số liệu dashboard.">@(stats != null ? stats.TotalRevenue.ToString("N0") : "—")</span>
                <span class="kpi-label">Doanh thu thực nhận</span>
                <span class="kpi-change font-mono-num">@countCompleted đơn hoàn tất</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon-wrap green"><CinemaIcon Name="CinemaIconName.Check" Size="24" /></div>
            <div class="kpi-body">
                <span class="kpi-value font-mono-num">@countCompleted</span>
                <span class="kpi-label">Đơn thành công</span>
                <span class="kpi-change up">CinemaFlow VIP</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon-wrap amber"><CinemaIcon Name="CinemaIconName.TrendingUp" Size="24" /></div>
            <div class="kpi-body">
                <span class="kpi-value font-mono-num">@countPending</span>
                <span class="kpi-label">Đơn chờ duyệt</span>
                <span class="kpi-change warn">Cần đối soát</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon-wrap cyan"><CinemaIcon Name="CinemaIconName.Users" Size="24" /></div>
            <div class="kpi-body">
                <span class="kpi-value font-mono-num">@(countAll > 0 ? (countCompleted * 100 / countAll) : 0)%</span>
                <span class="kpi-label">Tỷ lệ thanh toán</span>
                <span class="kpi-change up font-mono-num">@countAll tổng đơn</span>
            </div>
        </div>
    </section>

    <!-- Filter Suite: quick status tabs + tuỳ chỉnh ẩn/hiện bộ lọc -->
    <div class="cockpit-filter-suite">
        <div class="filter-suite-top">
            <div class="status-tabs-row" style="margin-bottom: 0; flex-wrap: wrap; gap: 0.45rem;">
                <button type="button" class="status-tab-btn @(statusFilter == null ? "active" : "")" @onclick="() => FilterByStatus(null)">
                    Tất cả (@countAll)
                </button>
                <button type="button" class="status-tab-btn @(statusFilter == PaymentStatus.Pending ? "active" : "")" @onclick="() => FilterByStatus(PaymentStatus.Pending)">
                    <span class="status-dot amber"></span> Chờ duyệt (@countPending)
                </button>
                <button type="button" class="status-tab-btn @(statusFilter == PaymentStatus.Completed ? "active" : "")" @onclick="() => FilterByStatus(PaymentStatus.Completed)">
                    <span class="status-dot green"></span> Hoàn tất (@countCompleted)
                </button>
                <button type="button" class="status-tab-btn @(statusFilter == PaymentStatus.Failed ? "active" : "")" @onclick="() => FilterByStatus(PaymentStatus.Failed)">
                    <span class="status-dot gray"></span> Từ chối/Hủy (@countFailed)
                </button>
            </div>

            <div class="filter-suite-tools">
                <div class="filter-count-chip">
                    <span>Tổng khớp bộ lọc: <strong>@totalItems</strong> giao dịch</span>
                </div>

                <div class="filter-settings-anchor">
                    <button type="button"
                            class="btn-filter-util @(showFilterSettings ? "is-active" : "")"
                            aria-haspopup="true"
                            aria-expanded="@(showFilterSettings ? "true" : "false")"
                            title="Chọn bộ lọc muốn hiển thị"
                            @onclick="ToggleFilterSettings">
                        <CinemaIcon Name="CinemaIconName.Settings" Size="13" />
                        <span>Bộ lọc</span>
                        @if (hiddenFilters.Count > 0 && hiddenFilters.Count < FilterOptions.Length)
                        {
                            <span class="filter-util-badge" title="@($"{hiddenFilters.Count} bộ lọc đang ẩn")">@hiddenFilters.Count</span>
                        }
                    </button>

                    @if (showFilterSettings)
                    {
                        <div class="filter-settings-backdrop" @onclick="CloseFilterSettings"></div>
                        <div class="filter-settings-panel" role="group" aria-label="Tùy chỉnh bộ lọc hiển thị" @onkeydown="OnFilterSettingsKeyDown">
                            <div class="filter-settings-head">
                                <strong>Hiển thị bộ lọc</strong>
                                <button type="button" class="btn-filter-util-reset" disabled="@(hiddenFilters.Count == 0)" @onclick="ShowAllFiltersAsync">
                                    Hiện tất cả
                                </button>
                            </div>
                            <p class="filter-settings-hint">Bỏ tick để ẩn bộ lọc không dùng. Giá trị đang chọn của bộ lọc bị ẩn sẽ được xóa để danh sách không bị lọc ngầm.</p>
                            <div class="filter-settings-list">
                                @foreach (var option in FilterOptions)
                                {
                                    <label class="filter-settings-item">
                                        <input type="checkbox"
                                               checked="@(!hiddenFilters.Contains(option.Key))"
                                               @onclick="() => SetFilterVisibility(option.Key, hiddenFilters.Contains(option.Key))" />
                                        <span>@option.Label</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </div>

                <button type="button"
                        class="btn-filter-util"
                        title="@(filtersCollapsed ? "Mở rộng khối bộ lọc" : "Thu gọn khối bộ lọc")"
                        aria-expanded="@(filtersCollapsed ? "false" : "true")"
                        @onclick="ToggleFilterCollapse">
                    <CinemaIcon Name="@(filtersCollapsed ? CinemaIconName.ChevronRight : CinemaIconName.ChevronDown)" Size="13" />
                    <span>@(filtersCollapsed ? "Mở rộng" : "Thu gọn")</span>
                </button>
            </div>
        </div>

        <!-- Filter Controls Grid (từng ô có thể bật/tắt) -->
        @if (!filtersCollapsed)
        {
            <div class="filter-controls-grid">
                @if (hiddenFilters.Count == FilterOptions.Length)
                {
                    <p class="filter-all-hidden-note">
                        Chưa bật ô lọc nào. Mở <strong>Bộ lọc</strong> và tick những ô bạn cần dùng.
                    </p>
                }

                @if (!hiddenFilters.Contains("status"))
                {
                    <div class="filter-control-item">
                        <label class="filter-label">Trạng thái giao dịch</label>
                        <select class="admin-select-picker" value="@(statusFilter?.ToString() ?? "")" @onchange="OnStatusSelectChanged">
                            <option value="">Tất cả trạng thái</option>
                            <option value="@nameof(PaymentStatus.Pending)">⏳ Chờ duyệt</option>
                            <option value="@nameof(PaymentStatus.Completed)">✓ Hoàn tất</option>
                            <option value="@nameof(PaymentStatus.Failed)">✕ Từ chối / Hủy</option>
                        </select>
                    </div>
                }

                @if (!hiddenFilters.Contains("method"))
                {
                    <div class="filter-control-item">
                        <label class="filter-label">Phương thức thanh toán</label>
                        <select class="admin-select-picker" value="@(methodFilter ?? "")" @onchange="OnMethodFilterChanged">
                            <option value="">Tất cả phương thức</option>
                            <option value="banktransfer">Chuyển khoản VietQR</option>
                            <option value="momo">Ví MoMo</option>
                            <option value="visa">Thẻ Quốc tế</option>
                        </select>
                    </div>
                }

                @if (!hiddenFilters.Contains("sort"))
                {
                    <div class="filter-control-item">
                        <label class="filter-label">Sắp xếp theo</label>
                        <select class="admin-select-picker" value="@(sortBy ?? "")" @onchange="OnSortByChanged">
                            <option value="">Mới nhất</option>
                            <option value="oldest">Cũ nhất</option>
                            <option value="amount_desc">Số tiền giảm dần</option>
                            <option value="amount_asc">Số tiền tăng dần</option>
                        </select>
                    </div>
                }

                @if (!hiddenFilters.Contains("search"))
                {
                    <div class="filter-control-item filter-control-search">
                        <label class="filter-label" for="payment-search">Tìm kiếm giao dịch</label>
                        <div class="filter-search-box">
                            <CinemaIcon Name="CinemaIconName.Search" Size="14" Class="filter-search-icon" />
                            <input id="payment-search"
                                   type="text"
                                   placeholder="Mã đơn, email, họ tên..."
                                   @bind="searchQuery"
                                   @bind:event="oninput"
                                   @bind:after="SchedulePaymentSearch"
                                   @onkeydown="HandleSearchKeyDown" />
                            @if (!string.IsNullOrWhiteSpace(searchQuery))
                            {
                                <button type="button" class="filter-search-clear" title="Xóa từ khóa tìm kiếm" aria-label="Xóa từ khóa tìm kiếm" @onclick="ClearSearchQuery">&times;</button>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Active Filters Strip & Clear All -->
        @if (HasActivePaymentFilters)
        {
            <div class="filter-active-strip">
                <span class="active-filter-title">Bộ lọc đang áp dụng:</span>
                @if (statusFilter.HasValue)
                {
                    <span class="filter-pill-tag">
                        <span>Trạng thái: @(statusFilter == PaymentStatus.Pending ? "Chờ duyệt" : statusFilter == PaymentStatus.Completed ? "Hoàn tất" : "Từ chối/Hủy")</span>
                        <button type="button" @onclick="ClearStatusFilter">&times;</button>
                    </span>
                }
                @if (!string.IsNullOrEmpty(methodFilter))
                {
                    <span class="filter-pill-tag">
                        <span>Phương thức: @(methodFilter == "momo" ? "Ví MoMo" : methodFilter == "visa" ? "Thẻ Quốc tế" : "Chuyển khoản VietQR")</span>
                        <button type="button" @onclick="ClearMethodFilter">&times;</button>
                    </span>
                }
                @if (!string.IsNullOrEmpty(sortBy))
                {
                    <span class="filter-pill-tag">
                        <span>Sắp xếp: @(sortBy == "oldest" ? "Cũ nhất" : sortBy == "amount_desc" ? "Số tiền giảm dần" : "Số tiền tăng dần")</span>
                        <button type="button" @onclick="ClearSortBy">&times;</button>
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <span class="filter-pill-tag">
                        <span>Tìm kiếm: "@searchQuery"</span>
                        <button type="button" @onclick="ClearSearchQuery">&times;</button>
                    </span>
                }

                <button type="button" class="btn-clear-all-filters" @onclick="ResetAllPaymentFilters">
                    Xóa tất cả bộ lọc
                </button>
            </div>
        }
    </div>

    <!-- Table -->
    <section class="admin-table-section">
        <div class="table-frame">
            @if (isLoadingPayments)
            {
                <div class="admin-table-state-msg">Đang tải lịch sử giao dịch...</div>
            }
            else if (paymentsList.Count == 0)
            {
                <div class="admin-table-state-msg">Không tìm thấy giao dịch nào phù hợp với điều kiện tìm kiếm.</div>
            }
            else
            {
                <table class="admin-movies-table">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Gói VIP</th>
                            <th>Số tiền</th>
                            <th>Phương thức</th>
                            <th>Trạng thái</th>
                            <th>Thời gian tạo</th>
                            <th style="text-align: right;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in paymentsList)
                        {
                            <tr>
                                <td>
                                    <code class="admin-order-code font-mono-num" title="@p.OrderCode">@p.OrderCode</code>
                                </td>
                                <td>
                                    <div class="user-cell">
                                        <div class="user-mini-avatar">
                                            @GetInitials(p.UserFullName ?? p.UserEmail ?? "CF")
                                        </div>
                                        <div class="user-cell-info">
                                            <span class="user-cell-name">@(string.IsNullOrWhiteSpace(p.UserFullName) ? "Khách hàng" : p.UserFullName)</span>
                                            <span class="user-cell-email">@(string.IsNullOrWhiteSpace(p.UserEmail) ? p.UserId.ToString()[..8] : p.UserEmail)</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <strong>@p.PlanName</strong>
                                </td>
                                <td>
                                    <strong class="font-mono-num" style="color: @(p.Status == PaymentStatus.Completed ? "var(--admin-accent-green)" : "var(--admin-accent-amber)");">
                                        @p.Amount.ToString("N0")đ
                                    </strong>
                                </td>
                                <td>
                                    @if (p.Method == PaymentMethod.BankTransfer)
                                    {
                                        <span class="method-badge vietqr">VietQR</span>
                                    }
                                    else if (p.Method == PaymentMethod.Momo)
                                    {
                                        <span class="method-badge momo">MoMo</span>
                                    }
                                    else
                                    {
                                        <span class="method-badge visa">Visa/MC</span>
                                    }
                                </td>
                                <td>
                                    @if (p.Status == PaymentStatus.Completed)
                                    {
                                        <span class="status-pill status-completed">Thành công</span>
                                    }
                                    else if (p.Status == PaymentStatus.Pending)
                                    {
                                        <span class="status-pill status-pending">Chờ duyệt</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-failed">Đã từ chối</span>
                                    }
                                </td>
                                <td>
                                    <span class="font-mono-num" style="font-size: 0.78rem; color: var(--admin-text-body);">
                                        @p.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </td>
                                <td style="text-align: right;">
                                    <div class="table-action-group">
                                        <button type="button" class="btn-table-action detail" title="Xem chi tiết đơn" @onclick="() => OpenDetailModal(p)">
                                            <CinemaIcon Name="CinemaIconName.Eye" Size="13" />
                                            <span>Chi tiết</span>
                                        </button>

                                        @if (p.Status == PaymentStatus.Pending)
                                        {
                                            <button type="button" class="btn-table-action approve" title="Duyệt đơn & Cấp VIP" @onclick="() => OpenApprovalModal(p)">
                                                <CinemaIcon Name="CinemaIconName.Check" Size="13" />
                                                <span>Duyệt</span>
                                            </button>
                                            <button type="button" class="btn-table-action reject" title="Từ chối đơn" @onclick="() => OpenRejectionModal(p)">
                                                <CinemaIcon Name="CinemaIconName.Close" Size="13" />
                                                <span>Từ chối</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <AdminPagination CurrentPage="@currentPage"
                                 PageSize="@pageSize"
                                 TotalItems="@totalItems"
                                 PageSizeOptions="@(new[] { 10, 20, 50 })"
                                 OnPageChanged="HandlePageChanged"
                                 OnPageSizeChanged="HandlePageSizeChanged" />
            }
        </div>
    </section>
}

<!-- TAB 2: CẤU HÌNH GÓI VIP -->
@if (activeTab == AdminVipTab.Plans)
{
    <section class="admin-table-section">
        <div class="section-title-bar">
            <h2>Danh sách Gói VIP trên hệ thống (@vipPlans.Count gói)</h2>
            <button type="button" class="btn-primary-action" @onclick="OpenCreatePlanModal">
                <CinemaIcon Name="CinemaIconName.Plus" Size="14" />
                <span>Thêm gói mới</span>
            </button>
        </div>

        <div class="vip-plans-admin-grid">
            @foreach (var plan in vipPlans)
            {
                <div class="plan-admin-card @(plan.IsRecommended ? "is-recommended" : "")">
                    <div>
                        <div class="plan-card-top">
                            <div class="plan-title-block">
                                <h3>@plan.Name</h3>
                                <p>Mã gói: <code class="font-mono-num">@plan.Id</code></p>
                            </div>
                            <div class="plan-badges-stack">
                                @if (plan.IsRecommended)
                                {
                                    <span class="badge-recommended">
                                        <CinemaIcon Name="CinemaIconName.Crown" Size="12" /> Đề xuất
                                    </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(plan.DiscountBadge))
                                {
                                    <span class="badge-discount">@plan.DiscountBadge</span>
                                }
                            </div>
                        </div>

                        <div class="plan-pricing-display" style="margin: 0.9rem 0;">
                            <span class="plan-price-main font-mono-num">@plan.Price.ToString("N0")đ</span>
                            @if (plan.OriginalPrice.HasValue && plan.OriginalPrice.Value > plan.Price)
                            {
                                <span class="plan-price-original font-mono-num">@plan.OriginalPrice.Value.ToString("N0")đ</span>
                            }
                            <span class="plan-duration-tag">(@plan.DurationDays ngày)</span>
                        </div>

                        <p style="font-size: 0.82rem; color: var(--admin-text-body); margin-bottom: 0.8rem;">
                            @(string.IsNullOrWhiteSpace(plan.Description) ? "Chưa có mô tả" : plan.Description)
                        </p>

                        <div class="plan-perks-tags">
                            @foreach (var b in plan.Benefits)
                            {
                                <span class="perk-tag">✓ @b</span>
                            }
                        </div>
                    </div>

                    <div class="plan-card-actions">
                        <div class="plan-active-status">
                            <span class="status-dot @(plan.IsActive ? "green" : "gray")"></span>
                            <span>@(plan.IsActive ? "Đang mở bán" : "Đã tạm ẩn")</span>
                        </div>
                        <button type="button" class="btn-secondary-ghost" style="padding: 4px 10px; font-size: 0.8rem;" @onclick="() => OpenEditPlanModal(plan)">
                            <CinemaIcon Name="CinemaIconName.Edit" Size="13" />
                            <span>Chỉnh sửa</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    </section>
}

<!-- TAB 3: CẤP VIP TRỰC TIẾP CHO THÀNH VIÊN -->
@if (activeTab == AdminVipTab.ManualGrant)
{
    <section class="grant-vip-wrapper">
        <div class="grant-vip-header">
            <div class="grant-crown-icon">
                <CinemaIcon Name="CinemaIconName.Crown" Size="24" />
            </div>
            <div class="grant-header-text">
                <h2>Cấp quyền VIP trực tiếp cho Thành viên</h2>
                <p>Cấp ngày VIP đặc cách cho người dùng để tri âu, tài trợ hoặc bồi thường sự cố mà không cần qua cổng thanh toán.</p>
            </div>
        </div>

        <div class="admin-form-group" style="margin-bottom: 1.25rem;">
            <label>Email hoặc Tên tài khoản thành viên *</label>
            <input type="text" @bind="grantTargetUser" placeholder="Ví dụ: user@example.com hoặc Nguyễn Văn A" />
            <small style="color: var(--admin-text-muted); font-size: 0.76rem; margin-top: 0.25rem; display: block;">
                Hệ thống sẽ tra cứu chính xác theo địa chỉ Email hoặc Họ tên người dùng trong cơ sở dữ liệu.
            </small>
        </div>

