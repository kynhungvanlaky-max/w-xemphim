@page "/login"
@inject AuthState Auth
@inject NavigationManager Nav
@using WebXemPhim.Client.Components.Common

<CinemaPageTitle>Đăng nhập - CinemaFlow</CinemaPageTitle>

<main class="auth-shell">
    <section class="auth-intro">
        <CinemaLogo Size="CinemaLogo.CinemaLogoSize.Large" ShowTagline="true" />
        <p class="auth-kicker">Thành viên CinemaFlow</p>
        <h1>Trở lại với màn ảnh của bạn.</h1>
        <p>Lưu phim, tiếp tục đúng đoạn đang xem và mở khóa thư viện 4K khi nâng cấp VIP.</p>
    </section>
    <section class="auth-panel" aria-labelledby="login-title">
        <div>
            <h2 id="login-title">Đăng nhập</h2>
            <p>Chưa có tài khoản? <a href="@($"/register?returnUrl={Uri.EscapeDataString(AuthNavigation.ReturnPath(ReturnUrl))}")">Đăng ký miễn phí</a></p>
        </div>

        @if (mfaRequired)
        {
            <div class="auth-mfa-intro" role="status">
                <CinemaIcon Name="CinemaIconName.Shield" Size="20" />
                <div><strong>Xác thực hai lớp</strong><span>Mở ứng dụng xác thực và nhập mã 6 số. Bạn cũng có thể dùng một mã khôi phục.</span></div>
            </div>
            <EditForm Model="mfaModel" FormName="verify-mfa" OnValidSubmit="VerifyMfa">
                <DataAnnotationsValidator />
                <div class="form-field">
                    <label for="mfa-code">Mã xác thực</label>
                    <InputText id="mfa-code" autocomplete="one-time-code" inputmode="numeric" @bind-Value="mfaModel.Code" placeholder="000000" maxlength="24" autofocus />
                    <ValidationMessage For="() => mfaModel.Code" />
                </div>
                @if (!string.IsNullOrWhiteSpace(error)) { <p class="form-alert error" role="alert">@error</p> }
                <button class="button primary wide" type="submit" disabled="@submitting">@(submitting ? "Đang kiểm tra..." : "Xác nhận đăng nhập")</button>
                <button class="auth-back-button" type="button" @onclick="CancelMfa">Dùng tài khoản khác</button>
            </EditForm>
        }
        else
        {
            <EditForm Model="model" FormName="login" OnValidSubmit="Submit">
                <DataAnnotationsValidator />
                <div class="form-field">
                    <label for="login-email">Email hoặc Tên đăng nhập</label>
                    <InputText id="login-email" type="text" autocomplete="username" @bind-Value="model.Email" placeholder="Email của bạn hoặc 'admin' / 'vip'" maxlength="160" />
                    <ValidationMessage For="() => model.Email" />
                </div>
                <div class="form-field">
                    <div class="label-row"><label for="login-password">Mật khẩu</label><a href="/forgot-password">Quên mật khẩu?</a></div>
                    <InputText id="login-password" type="password" autocomplete="current-password" @bind-Value="model.Password" placeholder="Mật khẩu của bạn" maxlength="100" />
                    <ValidationMessage For="() => model.Password" />
                </div>
                @if (!string.IsNullOrWhiteSpace(error)) { <p class="form-alert error" role="alert">@error</p> }
                <button class="button primary wide" type="submit" disabled="@submitting"><CinemaIcon Name="CinemaIconName.Login" Size="18" />@(submitting && activeDemoAccount is null ? "Đang xác thực..." : "Đăng nhập")</button>
            </EditForm>

            <div class="auth-divider"><span>Hoặc trải nghiệm nhanh (Demo)</span></div>

            <div class="auth-quick-card" role="region" aria-label="Tài khoản dùng thử một chạm">
                <div class="auth-quick-header">
                    <div class="auth-quick-title">
                        <CinemaIcon Name="CinemaIconName.Sparkles" Size="15" />
                        <span>Đăng nhập 1 chạm Demo:</span>
                    </div>
                    <span class="auth-quick-pwd">Pass: <code>Password123!</code></span>
                </div>
                <div class="auth-quick-buttons">
                    <button type="button" class="quick-chip admin" @onclick='() => QuickLogin("admin@cinemaflow.vn", "Password123!")' disabled="@submitting" title="Đăng nhập ngay với quyền Quản trị viên">
                        <div class="quick-chip-head">
                            <span class="quick-chip-badge"><CinemaIcon Name="CinemaIconName.Shield" Size="14" /> Admin</span>
                            <span class="quick-chip-action">@(submitting && activeDemoAccount == "admin@cinemaflow.vn" ? "Đang vào..." : "Vào ngay ➜")</span>
                        </div>
                        <span class="quick-chip-email">admin@cinemaflow.vn</span>
                    </button>
                    <button type="button" class="quick-chip vip" @onclick='() => QuickLogin("vip@cinemaflow.vn", "Password123!")' disabled="@submitting" title="Đăng nhập ngay với quyền Khách VIP">
                        <div class="quick-chip-head">
                            <span class="quick-chip-badge"><CinemaIcon Name="CinemaIconName.Crown" Size="14" /> Khách VIP</span>
                            <span class="quick-chip-action">@(submitting && activeDemoAccount == "vip@cinemaflow.vn" ? "Đang vào..." : "Vào ngay ➜")</span>
                        </div>
                        <span class="quick-chip-email">vip@cinemaflow.vn</span>
                    </button>
                    <button type="button" class="quick-chip member" @onclick='() => QuickLogin("hoangnam@cinemaflow.vn", "Password123!")' disabled="@submitting" title="Đăng nhập ngay với quyền Thành viên">
                        <div class="quick-chip-head">
                            <span class="quick-chip-badge"><CinemaIcon Name="CinemaIconName.User" Size="14" /> Thành viên</span>
                            <span class="quick-chip-action">@(submitting && activeDemoAccount == "hoangnam@cinemaflow.vn" ? "Đang vào..." : "Vào ngay ➜")</span>
                        </div>
                        <span class="quick-chip-email">hoangnam@cinemaflow.vn</span>
                    </button>
                </div>
            </div>
        }
    </section>
</main>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    private readonly LoginRequest model = new();
    private readonly VerifyMfaLoginRequest mfaModel = new();
    private bool submitting;
    private bool mfaRequired;
    private string? error;
    private string? activeDemoAccount;

    private static bool IsAdminRoute(string path) =>
        path.StartsWith("/admin", StringComparison.OrdinalIgnoreCase);

    private async Task QuickLogin(string email, string password)
    {
        activeDemoAccount = email;
        model.Email = email;
        model.Password = password;
        error = null;
        await Submit();
    }

    private void QuickFill(string email, string password)
    {
        model.Email = email;
        model.Password = password;
        error = null;
    }

    private async Task Submit()
    {
        submitting = true;
        error = null;
        var emailInput = model.Email?.Trim() ?? string.Empty;
        if (emailInput.Equals("admin", StringComparison.OrdinalIgnoreCase))
        {
            model.Email = "admin@cinemaflow.vn";
        }
        else if (emailInput.Equals("demo", StringComparison.OrdinalIgnoreCase) ||
                 emailInput.Equals("vip", StringComparison.OrdinalIgnoreCase))
        {
            model.Email = "vip@cinemaflow.vn";
        }

        try
        {
            var response = await Auth.LoginAsync(model);
            submitting = false;
            activeDemoAccount = null;
            if (response?.Success == true && response.Data?.RequiresMfa == true)
            {
                mfaModel.ChallengeToken = response.Data.MfaChallengeToken;
                mfaRequired = true;
                error = null;
            }
            else if (response?.Success == true)
            {
                var target = AuthNavigation.ReturnPath(ReturnUrl, "/admin");
                if (response.Data?.User?.IsAdmin == true)
                {
                    // The cockpit stylesheet is linked from the admin layout head. A client side
                    // navigation paints the cockpit before that sheet arrives, which shows a flash
                    // of unstyled content on the very first entry — the admin area is therefore
                    // entered with a full document load.
                    Nav.NavigateTo(target, forceLoad: IsAdminRoute(target));
                }
                else
                {
                    Nav.NavigateTo(target);
                }
            }
            else
            {
                error = response?.Message ?? "Không thể kết nối máy chủ hoặc thông tin đăng nhập không chính xác. Vui lòng thử lại.";
            }
        }
        catch (Exception ex)
        {
            submitting = false;
            activeDemoAccount = null;
            error = "Không thể kết nối máy chủ hoặc dịch vụ đang khởi động. Vui lòng thử lại sau giây lát: " + ex.Message;
        }
    }

    private async Task VerifyMfa()
    {
        submitting = true;
        error = null;
        var response = await Auth.VerifyMfaLoginAsync(mfaModel);
        submitting = false;
        if (response?.Success == true)
        {
            Nav.NavigateTo(response.Data?.User?.IsAdmin == true
                ? AuthNavigation.ReturnPath(ReturnUrl, "/admin")
                : AuthNavigation.ReturnPath(ReturnUrl));
        }
        else error = response?.Message ?? "Mã xác thực không chính xác hoặc đã hết hạn.";
    }

    private void CancelMfa()
    {
        mfaRequired = false;
        mfaModel.ChallengeToken = string.Empty;
        mfaModel.Code = string.Empty;
        model.Password = string.Empty;
        error = null;
    }
}
