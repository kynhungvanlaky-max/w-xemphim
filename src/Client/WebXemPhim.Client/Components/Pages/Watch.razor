    private void OnVideoEnded() { _ = GoTo(playback.OnEnded()); }
    private void SignIn() => Nav.NavigateTo("/login?ReturnUrl=" + Uri.EscapeDataString(ReturnUrl));

    private async Task ToggleSaved()
    {
        if (!Auth.IsAuthenticated) { SignIn(); return; }
        if (movie is null || savingFilm) return;
        savingFilm = true;
        try
        {
            var wasSaved = Watchlist.IsInWatchlist(MovieId);
            await Watchlist.ToggleWatchlistAsync(movie);
            status = wasSaved != Watchlist.IsInWatchlist(MovieId) ? (wasSaved ? "Đã bỏ phim khỏi Watchlist." : "Đã lưu phim vào Watchlist.") : "Chưa thể cập nhật Watchlist. Vui lòng thử lại.";
        }
        finally { savingFilm = false; }
    }

    private async Task Share()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", Nav.Uri); status = "Đã sao chép liên kết đến tập phim."; }
        catch (JSException ex) { Logger.LogDebug(ex, "Không thể ghi clipboard tự động, chuyển sang phương án hiển thị link."); showShare = true; status = "Bạn có thể sao chép liên kết bên dưới."; }
    }

    private async Task SelectShare() => await JS.InvokeVoidAsync("CinemaPlayer.selectShareLink");

    private void OpenReport()
    {
        if (!Auth.IsAuthenticated) { SignIn(); return; }
        if (playback.Current is null) return;
        lightsOff = false; report = new() { MovieId = MovieId, EpisodeId = playback.Current.Id };
        reportStatus = null; reportOpen = true; focusReport = true;
    }

    private void CloseReport() { if (!reportSending) { reportOpen = false; focusReportTrigger = true; } }
    private void ReportKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") CloseReport(); }

    private async Task SendReport()
    {
        if (reportSending) return;
        reportSending = true;
        try
        {
            var response = await Api.ReportAsync(report);
            if (response?.Success == true) { reportOpen = false; focusReportTrigger = true; status = response.Message; }
            else reportStatus = response?.Message ?? "Chưa gửi được báo lỗi. Vui lòng thử lại.";
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { Logger.LogWarning(ex, "Lỗi truyền thông khi gửi báo lỗi phim {MovieId}.", MovieId); reportStatus = "Chưa gửi được báo lỗi. Vui lòng thử lại."; }
        finally { reportSending = false; }
    }

    private void AuthChanged() => _ = InvokeAsync(async () =>
    {
        if (Auth.IsAuthenticated)
        {
            playback.IsVipUser = Auth.User?.IsVip == true || Auth.User?.IsAdmin == true;
            await Watchlist.InitializeAsync();
            await ApplyUserSettingsAsync();
            await AcquireLeaseAndStartHeartbeatAsync();
        }
        else
        {
            playback.IsVipUser = false;
            StopHeartbeatTimer();
        }
        StateHasChanged();
    });

    private void StateChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task AcquireLeaseAndStartHeartbeatAsync()
    {
        if (!Auth.IsAuthenticated) return;
        StopHeartbeatTimer();
        if (!string.IsNullOrEmpty(currentStreamSessionId))
        {
            _ = HubClient.ReleaseStreamLeaseAsync(currentStreamSessionId);
        }

        var sessionId = Guid.NewGuid().ToString("N");
        currentStreamSessionId = sessionId;
        isEvicted = false;
        evictionNotice = null;

        var result = await HubClient.AcquireStreamLeaseAsync(
            MovieId,
            playback.Current?.Id,
            sessionId,
            "Trình duyệt Web");

        if (result is not null && result.Success)
        {
            StartHeartbeatTimer(sessionId);
        }
        else if (result is not null && !result.Success)
        {
            await HandleSessionEvictionAsync(new ForceDisconnectNotice
            {
                SessionId = sessionId,
                Reason = result.ErrorMessage ?? "Không thể khởi tạo phiên xem phim do vượt quá giới hạn thiết bị.",
                DisconnectedAtUtc = DateTime.UtcNow
            });
        }
    }

    private void StartHeartbeatTimer(string sessionId)
    {
        StopHeartbeatTimer();
        heartbeatCts = new CancellationTokenSource();
        heartbeatTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        heartbeatTask = RunHeartbeatLoopAsync(sessionId, heartbeatTimer, heartbeatCts.Token);
    }

    private async Task RunHeartbeatLoopAsync(string sessionId, PeriodicTimer timer, CancellationToken ct)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (!Auth.IsAuthenticated || currentStreamSessionId != sessionId || isEvicted)
                    break;

                var renewed = await HubClient.SendStreamHeartbeatAsync(sessionId);
                if (!renewed)
                {
                    await HandleSessionEvictionAsync(new ForceDisconnectNotice
                    {
                        SessionId = sessionId,
                        Reason = "Phiên phát phim đã hết hạn hoặc bị ngắt kết nối bởi máy chủ.",
                        DisconnectedAtUtc = DateTime.UtcNow
                    });
                    break;
                }
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Lỗi vòng lặp heartbeat phiên phát phim {SessionId}.", sessionId);
        }
    }

    private void StopHeartbeatTimer()
    {
        heartbeatCts?.Cancel();
        heartbeatTimer?.Dispose();
        heartbeatCts?.Dispose();
        heartbeatTimer = null;
        heartbeatCts = null;
        heartbeatTask = null;
    }

    private void HandleForceDisconnect(ForceDisconnectNotice notice)
    {
        _ = InvokeAsync(async () =>
        {
            if (currentStreamSessionId == notice.SessionId || string.IsNullOrEmpty(notice.SessionId))
            {
                await HandleSessionEvictionAsync(notice);
            }
        });
    }

    private async Task HandleSessionEvictionAsync(ForceDisconnectNotice notice)
    {
        StopHeartbeatTimer();
        isEvicted = true;
        evictionNotice = notice;
        autoPlayEpisodeId = null;

        if (player is not null)
        {
            await player.PauseAsync();
        }

        StateHasChanged();
    }

    private async Task ResumePlaybackHere()
    {
        isEvicted = false;
        evictionNotice = null;
        autoPlayEpisodeId = playback.Current?.Id;
        await AcquireLeaseAndStartHeartbeatAsync();
        StateHasChanged();
    }

    public void Dispose()
    {
        ++loadVersion;
        Auth.Changed -= AuthChanged;
        Watchlist.OnChange -= StateChanged;
        HubClient.OnForceDisconnectReceived -= HandleForceDisconnect;
        StopHeartbeatTimer();
        if (!string.IsNullOrEmpty(currentStreamSessionId))
        {
            _ = HubClient.ReleaseStreamLeaseAsync(currentStreamSessionId);
        }
        if (Auth.IsAuthenticated && movie is not null && playback.Current is not null && currentCursorSeconds > 0)
        {
            _ = SaveCurrentProgressAsync(immediate: true);
        }
    }

    public async ValueTask DisposeAsync()
    {
        ++loadVersion;
        Auth.Changed -= AuthChanged;
        Watchlist.OnChange -= StateChanged;
        HubClient.OnForceDisconnectReceived -= HandleForceDisconnect;
        StopHeartbeatTimer();
        if (!string.IsNullOrEmpty(currentStreamSessionId))
        {
            await HubClient.ReleaseStreamLeaseAsync(currentStreamSessionId);
        }
        if (Auth.IsAuthenticated && movie is not null && playback.Current is not null && currentCursorSeconds > 0)
        {
            await SaveCurrentProgressAsync(immediate: true);
        }
    }
