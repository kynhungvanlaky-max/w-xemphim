@page "/movie/{Id:int}"
@page "/movie/{Slug}"
@using WebXemPhim.Shared.Models
@using WebXemPhim.Shared.Enums
@using WebXemPhim.Client.Components.Icons
@using WebXemPhim.Client.Components.Common
@using WebXemPhim.Client.Services
@inject IMovieApiClient ApiClient
@inject WatchlistState Watchlist
@inject AuthState Auth
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@DisplayTitle - CinemaFlow</PageTitle>

<div class="movie-detail-container">
@if (isLoading)
{
    <div class="detail-loading-state" style="min-height: 65vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem;">
        <div style="width: 40px; height: 40px; border: 3px solid rgba(229, 9, 20, 0.2); border-top-color: #e50914; border-radius: 50%; animation: spin 0.8s linear infinite;"></div>
        <p style="color: rgba(255, 255, 255, 0.65); font-size: 0.95rem;">Đang tải thông tin phim...</p>
    </div>
}
else if (movie is null)
{
    <div class="detail-error-state" style="min-height: 70vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 3rem 1.5rem; max-width: 580px; margin: 0 auto;">
        <div style="width: 68px; height: 68px; border-radius: 50%; background: rgba(229, 9, 20, 0.12); border: 1px solid rgba(229, 9, 20, 0.3); display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem; color: #ff4d58;">
            <CinemaIcon Name="CinemaIconName.AlertCircle" Size="34" />
        </div>
        <h1 style="font-size: 1.85rem; font-weight: 800; color: #ffffff; margin-bottom: 0.75rem;">Không tìm thấy phim</h1>
        <p style="color: rgba(255, 255, 255, 0.65); font-size: 0.95rem; line-height: 1.6; margin-bottom: 2rem;">
            @(loadError ?? "Bộ phim bạn đang tìm kiếm không tồn tại hoặc đã bị xóa khỏi hệ thống.")
        </p>
        <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; justify-content: center;">
            <button type="button" @onclick="RetryLoad" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.6rem; background: #e50914; color: #ffffff; border: none; border-radius: 8px; font-weight: 700; font-size: 0.92rem; cursor: pointer; transition: all 0.2s ease;">
                <CinemaIcon Name="CinemaIconName.Refresh" Size="16" />
                <span>Thử lại</span>
            </button>
            <a href="/explore" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.6rem; background: rgba(255, 255, 255, 0.08); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.18); border-radius: 8px; font-weight: 600; font-size: 0.92rem; text-decoration: none; transition: all 0.2s ease;">
                <CinemaIcon Name="CinemaIconName.Compass" Size="16" />
                <span>Khám phá kho phim</span>
            </a>
        </div>
    </div>
}
else
{
    <!-- 1. Hero Section -->
    <header class="detail-hero-stage">
        <div class="detail-backdrop-wrap">
            <img src="@BackdropUrl"
                 alt="@DisplayTitle"
                 width="1672"
                 height="941"
                 loading="eager"
                 fetchpriority="high"
                 @onerror="HandleBackdropError"
                 class="detail-backdrop-img" />
            <div class="detail-backdrop-gradient-left"></div>
            <div class="detail-backdrop-gradient-right"></div>
            <div class="detail-backdrop-gradient-bottom"></div>
        </div>

        <div class="detail-hero-content">
            <!-- Floating Poster Card -->
            <div class="detail-poster-column">
                <div class="poster-card-frame">
                    <img src="@PosterUrl"
                         alt="Poster @DisplayTitle"
                         width="342"
                         height="513"
                         loading="eager"
                         class="poster-card-img" />
                </div>
            </div>

            <!-- Movie Metadata & Action Buttons -->
            <div class="detail-info-column">
                <div class="detail-title-group">
                    <span class="detail-original-label">CinemaFlow Original</span>
                    <h1 class="detail-main-title">@DisplayTitle</h1>
                    @if (!string.IsNullOrWhiteSpace(movie?.OriginalTitle))
                    {
                        <p class="detail-original-title">@movie.OriginalTitle</p>
                    }
                </div>

                <p class="detail-hero-synopsis">
                    @(string.IsNullOrWhiteSpace(movie?.Overview)
                        ? "Một câu chuyện điện ảnh đang chờ bạn khám phá trên CinemaFlow."
                        : movie.Overview)
                </p>

                <div class="detail-badges-row">
                    <span class="detail-rating-pill">
                        <CinemaIcon Name="CinemaIconName.Star" Size="14" Filled="true" />
                        <strong>@(movie?.Rating.ToString("0.0") ?? "-")</strong>
                    </span>
                    <span class="badge-dot" aria-hidden="true">•</span>
                    <span class="badge-text">@(movie?.ReleaseYear.ToString() ?? "Đang cập nhật")</span>
                    <span class="badge-dot" aria-hidden="true">•</span>
                    <span class="badge-pill-outline">@(movie?.AgeRating ?? "Chưa phân loại")</span>
                    <span class="badge-dot" aria-hidden="true">•</span>
                    <span class="badge-text">@(movie is null ? "Đang cập nhật" : $"{movie.DurationMinutes} phút")</span>
                    <span class="badge-dot" aria-hidden="true">•</span>
                    <span class="badge-pill-outline">@(movie?.Quality ?? "Đang cập nhật")</span>
                </div>

                @if (movie?.Genres is { Count: > 0 })
                {
                    <div class="detail-genres-row" aria-label="Thể loại">
                        @foreach (var genre in movie.Genres)
                        {
                            <a href="@($"/explore?genre={Uri.EscapeDataString(genre)}")" class="detail-genre-tag" title="Khám phá thể loại @genre">@genre</a>
                        }
                    </div>
                }

                <div class="detail-cta-group">
                    <a href="@($"/watch/{EffectiveMovieId}")" class="btn-detail-play" title="Xem phim ngay">
                        <CinemaIcon Name="CinemaIconName.Play" Size="16" Filled="true" />
                        <span>Xem phim</span>
                    </a>

                    <button type="button"
                            class="btn-detail-watchlist @(isInWatchlist ? "is-saved" : "")"
                            @onclick="ToggleWatchlist"
                            title="@(isInWatchlist ? "Xoá khỏi tủ phim" : "Thêm vào tủ phim")"
                            aria-pressed="@isInWatchlist">
                        <CinemaIcon Name="@(isInWatchlist ? CinemaIconName.BookmarkCheck : CinemaIconName.BookmarkPlus)" Size="17" />
                        <span>@(isInWatchlist ? "Đã trong tủ phim" : "Thêm vào tủ")</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- 2. Navigation Tabs -->
    <div class="detail-tabs-header-wrap">
        <nav class="detail-tabs-bar" role="tablist" aria-label="Mục chi tiết phim">
            <button type="button" class="tab-item @(activeTab == "overview" ? "active" : "")" @onclick='() => activeTab = "overview"'>Tổng quan</button>
            @if (movie?.TotalEpisodes > 1)
            {
                <button type="button" class="tab-item @(activeTab == "episodes" ? "active" : "")" @onclick='() => activeTab = "episodes"'>Danh sách tập</button>
            }
            <button type="button" class="tab-item @(activeTab == "trailer" ? "active" : "")" @onclick='() => activeTab = "trailer"'>Trailer</button>
            <button type="button" class="tab-item @(activeTab == "reviews" ? "active" : "")" @onclick='() => activeTab = "reviews"'>Bình luận</button>
            <button type="button" class="tab-item @(activeTab == "related" ? "active" : "")" @onclick='() => activeTab = "related"'>Phim tương tự</button>
        </nav>
    </div>

    <!-- 3. Tab Content Section -->
    <div class="tab-body-container">
        @if (activeTab == "overview")
        {
            <div class="overview-two-columns">
                <!-- Left: Synopsis + Cast Showcase -->
                <div class="overview-left-col">
                    <section class="synopsis-block">
                        <h2 class="section-sub-heading">Nội dung phim</h2>
                        <p class="synopsis-para">
                            @(string.IsNullOrWhiteSpace(movie?.Overview)
                                ? "Nội dung phim đang được cập nhật."
                                : movie.Overview)
                        </p>
                    </section>

                    <section class="cast-showcase-block">
                        <h2 class="section-sub-heading">Giới thiệu diễn viên</h2>
                        @if (movie?.Cast is { Count: > 0 })
                        {
                            <div class="cast-cards-row">
                                @for (var index = 0; index < movie.Cast.Count; index++)
                                {
                                    var actor = movie.Cast[index];
                                    <article class="cast-card">
                                        <img src="@CastImage(index)"
                                             alt="@actor"
                                             width="130"
                                             height="130"
                                             loading="lazy" />
                                        <div class="cast-info">
                                            <strong>@actor</strong>
                                            <small>Diễn viên chính</small>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="synopsis-para">Danh sách diễn viên đang được cập nhật.</p>
                        }
                    </section>
                </div>

                <!-- Right: Specs Table -->
                <div class="overview-right-col">
                    <aside class="specs-table-card">
                        <h2 class="section-sub-heading">Thông tin phim</h2>
                        <dl class="specs-key-values">
                            <div class="spec-row"><dt>Đạo diễn</dt><dd>@TextOrPending(movie?.Director)</dd></div>
                            <div class="spec-row"><dt>Diễn viên</dt><dd>@(movie?.Cast is { Count: > 0 } ? string.Join(", ", movie.Cast) : "Đang cập nhật")</dd></div>
                            <div class="spec-row"><dt>Thể loại</dt><dd>@(movie?.Genres is { Count: > 0 } ? string.Join(", ", movie.Genres) : "Đang cập nhật")</dd></div>
                            <div class="spec-row"><dt>Quốc gia</dt><dd>@TextOrPending(movie?.Country)</dd></div>
                            <div class="spec-row"><dt>Năm sản xuất</dt><dd>@(movie?.ReleaseYear.ToString() ?? "Đang cập nhật")</dd></div>
                            <div class="spec-row"><dt>Thời lượng</dt><dd>@(movie is null ? "Đang cập nhật" : $"{movie.DurationMinutes} phút")</dd></div>
                            <div class="spec-row"><dt>Độ tuổi</dt><dd>@TextOrPending(movie?.AgeRating)</dd></div>
                            <div class="spec-row"><dt>Định dạng</dt><dd>@TextOrPending(movie?.Quality)</dd></div>
                        </dl>
                    </aside>
                </div>
            </div>

            @if (movie?.SimilarMovies is { Count: > 0 })
            {
                <section class="overview-related-strip" aria-labelledby="overview-related-title">
                    <div class="related-strip-heading">
                        <h2 id="overview-related-title" class="section-sub-heading">Phim tương tự</h2>
                        <button type="button" class="related-view-all" @onclick='() => activeTab = "related"'>Xem tất cả <span aria-hidden="true">→</span></button>
                    </div>
                    <div class="related-strip-track">
                        @foreach (var related in movie.SimilarMovies.Take(6))
                        {
                            <a href="@($"/movie/{related.Id}")" class="related-strip-card">
                                <img src="@related.BackdropUrl" alt="@related.Title" />
                                <span>@related.Title</span>
                            </a>
                        }
                    </div>
                </section>
            }
        }
        else if (activeTab == "episodes")
        {
            <div class="episodes-tab-view">
                <h2 class="section-sub-heading">Danh sách tập</h2>
                @if (movie?.Episodes is { Count: > 0 })
                {
                    <div class="episodes-simple-grid">
                        @foreach (var ep in movie.Episodes.OrderBy(e => e.EpisodeNumber))
                        {
                            <a href="@($"/watch/{movie.Id}?ep={ep.EpisodeNumber}")" class="episode-pill-link">
                                <span>Tập @ep.EpisodeNumber.ToString("00")@(string.IsNullOrWhiteSpace(ep.Title) ? "" : $": {ep.Title}")</span>
                                <small>@ep.DurationMinutes phút</small>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p class="episodes-empty-note">Chưa có danh sách tập cho phim này.</p>
                }
            </div>
        }
        else if (activeTab == "trailer")
        {
            <div class="trailer-tab-view">
                <div class="trailer-header-row">
                    <div class="trailer-title-wrap">
                        <h2 class="section-sub-heading">Trailer chính thức</h2>
                        <p class="trailer-sub-note">Trải nghiệm trailer sắc nét với chất lượng âm thanh điện ảnh</p>
                    </div>
                    <div class="trailer-badges">
                        <span class="trailer-badge-pill">Full HD</span>
                        <span class="trailer-badge-pill">Cinema Surround</span>
                    </div>
                </div>

                <div class="trailer-video-frame">
                    @if (IsDirectVideoTrailer)
                    {
                        <video class="trailer-media-element"
                               src="@movie?.TrailerUrl"
                               controls
                               playsinline
                               poster="@BackdropUrl">
                            Trình duyệt của bạn không hỗ trợ phát video HTML5.
                        </video>
                    }
                    else
                    {
                        <iframe class="trailer-media-element"
                                src="@TrailerEmbedUrl"
                                title="Trailer phim @DisplayTitle"
                                allowfullscreen
                                referrerpolicy="strict-origin-when-cross-origin"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share">
                        </iframe>
                    }
                </div>

                <div class="trailer-action-bar">
                    <a href="@($"/watch/{EffectiveMovieId}")" class="btn-trailer-watch-full" title="Xem phim bản đầy đủ">
                        <CinemaIcon Name="CinemaIconName.Play" Size="16" Filled="true" />
                        <span>Xem phim ngay</span>
                    </a>
                    <button type="button"
                            class="btn-trailer-quick-save @(isInWatchlist ? "is-saved" : "")"
                            @onclick="ToggleWatchlist"
                            title="@(isInWatchlist ? "Xoá khỏi tủ phim" : "Thêm vào tủ phim")">
                        <CinemaIcon Name="@(isInWatchlist ? CinemaIconName.BookmarkCheck : CinemaIconName.BookmarkPlus)" Size="16" />
                        <span>@(isInWatchlist ? "Đã trong tủ phim" : "Thêm vào tủ")</span>
                    </button>
                </div>
            </div>
        }
        else if (activeTab == "reviews")
        {
            <div class="reviews-tab-view">
                <ReviewPanel MovieId="@EffectiveMovieId" />
            </div>
        }
        else
        {
            <div class="related-tab-view">
                <h2 class="section-sub-heading">Phim cùng thể loại</h2>
                @if (movie?.SimilarMovies is { Count: > 0 })
                {
                    <div class="related-cards-grid">
                        @foreach (var related in movie.SimilarMovies)
                        {
                            <a href="@($"/movie/{related.Id}")" class="related-thumb"><img src="@related.BackdropUrl" alt="@related.Title" /><span>@related.Title</span></a>
                        }
                    </div>
                }
                else
                {
                    <p class="synopsis-para">Danh sách phim liên quan đang được cập nhật.</p>
                }
            </div>
        }
    </div>

    <!-- 4. Watchlist Login Confirmation Modal -->
    @if (showLoginPrompt)
    {
        <div class="watchlist-login-modal-backdrop" @onclick="CloseLoginPrompt">
            <div class="watchlist-login-modal-content"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="watchlist-login-title"
                 @onclick:stopPropagation="true">
                <div class="watchlist-modal-header">
                    <div class="modal-header-icon-title">
                        <span class="modal-auth-icon" aria-hidden="true">
                            <CinemaIcon Name="CinemaIconName.Login" Size="20" />
                        </span>
                        <h3 id="watchlist-login-title">Yêu cầu đăng nhập</h3>
                    </div>
                    <button type="button" class="btn-close-modal" aria-label="Đóng thông báo" @onclick="CloseLoginPrompt">
                        <CinemaIcon Name="CinemaIconName.Close" Size="18" />
                    </button>
                </div>

                <div class="watchlist-modal-body">
                    <div class="modal-movie-preview">
                        <img src="@PosterUrl" alt="@DisplayTitle" class="modal-movie-poster" />
                        <div class="modal-movie-meta">
                            <strong class="modal-movie-title">@DisplayTitle</strong>
                            <span class="modal-movie-badge">@(movie?.ReleaseYear.ToString() ?? "2026") • @(movie?.Quality ?? "HD")</span>
                            <p class="modal-benefit-text">Lưu phim vào tủ để theo dõi tiến độ và xem lại bất cứ lúc nào trên mọi thiết bị.</p>
                        </div>
                    </div>

                    <p class="modal-prompt-question">
                        Bạn cần đăng nhập tài khoản CinemaFlow để thêm phim này vào tủ phim cá nhân.
                    </p>

                    <div class="watchlist-modal-actions">
                        <button type="button" class="btn-modal-cancel" @onclick="CloseLoginPrompt">
                            Hủy
                        </button>
                        <button type="button" class="btn-modal-confirm" @onclick="ConfirmLogin">
                            <CinemaIcon Name="CinemaIconName.Login" Size="16" />
                            <span>Xác nhận đăng nhập</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string? Slug { get; set; }

    private MovieDetailDto? movie;
    private bool isLoading = true;
    private string? loadError;
    private string activeTab = "overview";
    private bool showLoginPrompt;
    private bool backdropFailed;
    private bool disposed;
    private int EffectiveMovieId => movie?.Id ?? (Id > 0 ? Id : 0);
    private bool isInWatchlist => EffectiveMovieId > 0 && Watchlist.IsInWatchlist(EffectiveMovieId);

    private static readonly string[] CastImages =
    [
        "/images/generated/catalog/cast-lan.webp",
        "/images/generated/catalog/cast-minh.webp",
        "/images/generated/catalog/cast-father.webp",
        "/images/generated/catalog/cast-mother.webp"
    ];

    private string DisplayTitle => movie?.Title ?? (isLoading ? "Đang tải phim" : "Không tìm thấy phim");
    private string BackdropUrl => backdropFailed || string.IsNullOrWhiteSpace(movie?.BackdropUrl)
        ? (movie?.PosterUrl ?? "")
        : movie.BackdropUrl;
    private string PosterUrl => movie?.PosterUrl ?? "";

    private static string TextOrPending(string? value) => string.IsNullOrWhiteSpace(value) ? "Đang cập nhật" : value;
    private static string CastImage(int index) => CastImages[index % CastImages.Length];

    private bool IsDirectVideoTrailer =>
        !string.IsNullOrWhiteSpace(movie?.TrailerUrl) &&
        (movie.TrailerUrl.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) ||
         movie.TrailerUrl.EndsWith(".webm", StringComparison.OrdinalIgnoreCase) ||
         movie.TrailerUrl.Contains(".mp4?", StringComparison.OrdinalIgnoreCase));

    private string TrailerEmbedUrl
    {
        get
        {
            var url = movie?.TrailerUrl?.Trim();
            if (string.IsNullOrWhiteSpace(url))
            {
                return "https://www.youtube-nocookie.com/embed/Way9Dexny3w?rel=0";
            }

            if (url.Contains("youtube.com/watch", StringComparison.OrdinalIgnoreCase))
            {
                var queryIndex = url.IndexOf("v=", StringComparison.OrdinalIgnoreCase);
                if (queryIndex >= 0)
                {
                    var id = url.Substring(queryIndex + 2);
                    var ampIndex = id.IndexOf('&');
                    if (ampIndex >= 0) id = id.Substring(0, ampIndex);
                    return $"https://www.youtube-nocookie.com/embed/{id}?rel=0";
                }
            }
            else if (url.Contains("youtu.be/", StringComparison.OrdinalIgnoreCase))
            {
                var id = url.Substring(url.LastIndexOf('/') + 1);
                var qIndex = id.IndexOf('?');
                if (qIndex >= 0) id = id.Substring(0, qIndex);
                return $"https://www.youtube-nocookie.com/embed/{id}?rel=0";
            }
            else if (url.Contains("youtube.com/embed/", StringComparison.OrdinalIgnoreCase) ||
                     url.Contains("youtube-nocookie.com/embed/", StringComparison.OrdinalIgnoreCase))
            {
                return url.Contains('?') ? $"{url}&rel=0" : $"{url}?rel=0";
            }

            return url;
        }
    }

    protected override void OnInitialized()
    {
        Watchlist.OnChange += HandleWatchlistChanged;
        Auth.Changed += HandleAuthChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Auth.InitializeAsync();
            if (Auth.IsAuthenticated)
            {
                await Watchlist.InitializeAsync();
            }
        }
        catch
        {
            // Ignore during static prerendering
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        backdropFailed = false;
        isLoading = true;
        loadError = null;
        try
        {
            if (!string.IsNullOrWhiteSpace(Slug))
            {
                movie = await ApiClient.GetMovieBySlugAsync(Slug);
            }
            else if (Id > 0)
            {
                movie = await ApiClient.GetMovieByIdAsync(Id);
            }
            else
            {
                movie = null;
            }

            if (movie is null)
            {
                loadError = "Không tìm thấy bộ phim yêu cầu hoặc phim đã ngừng cung cấp.";
            }

            if (Auth.IsAuthenticated && !Watchlist.IsInitialized)
            {
                await Watchlist.InitializeAsync();
            }
        }
        catch (Exception)
        {
            movie = null;
            loadError = "Đã xảy ra lỗi khi kết nối máy chủ để tải phim. Vui lòng thử lại.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RetryLoad()
    {
        await OnParametersSetAsync();
    }

    private void HandleWatchlistChanged()
    {
        if (!disposed)
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void HandleAuthChanged()
    {
        if (!disposed)
        {
            _ = InvokeAsync(async () =>
            {
                if (Auth.IsAuthenticated)
                {
                    await Watchlist.InitializeAsync();
                }
                StateHasChanged();
            });
        }
    }

    public void Dispose()
    {
        disposed = true;
        Watchlist.OnChange -= HandleWatchlistChanged;
        Auth.Changed -= HandleAuthChanged;
    }

    private void HandleBackdropError()
    {
        backdropFailed = true;
    }

    private async Task ToggleWatchlist()
    {
        if (!Auth.IsAuthenticated)
        {
            showLoginPrompt = true;
            return;
        }

        if (movie is not null)
        {
            var dto = new MovieDto
            {
                Id = movie.Id,
                Title = movie.Title,
                PosterUrl = movie.PosterUrl,
                Rating = movie.Rating,
                ReleaseYear = movie.ReleaseYear,
                Quality = movie.Quality,
                DurationMinutes = movie.DurationMinutes
            };
            await Watchlist.ToggleWatchlistAsync(dto);
        }
    }

    private void CloseLoginPrompt()
    {
        showLoginPrompt = false;
    }

    private void ConfirmLogin()
    {
        showLoginPrompt = false;
        var returnTarget = !string.IsNullOrWhiteSpace(Slug) ? $"/movie/{Slug}" : $"/movie/{EffectiveMovieId}";
        Navigation.NavigateTo($"/login?returnUrl={returnTarget}");
    }
}
