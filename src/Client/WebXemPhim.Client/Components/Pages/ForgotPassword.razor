@page "/forgot-password"
@inject IAccountApiClient Api
@using WebXemPhim.Shared.Requests
@using WebXemPhim.Client.Components.Common
@using WebXemPhim.Client.Components.Icons

<PageTitle>Khôi phục mật khẩu - CinemaFlow</PageTitle>

<main class="auth-shell auth-recovery-shell">
    <section class="auth-intro">
        <CinemaLogo Size="CinemaLogo.CinemaLogoSize.Large" ShowTagline="true" />
        <p class="auth-kicker">Bảo mật tài khoản</p>
        <h1>Khôi phục quyền truy cập vào màn ảnh của bạn.</h1>
        <p>CinemaFlow sẽ gửi một liên kết bảo mật để bạn có thể đặt lại mật khẩu mới và tiếp tục theo dõi các bộ phim yêu thích.</p>

        <div class="auth-feature-list" style="margin-top: 2rem; display: flex; flex-direction: column; gap: 1rem; color: rgba(255,255,255,0.7); font-size: 0.88rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <CinemaIcon Name="CinemaIconName.Shield" Size="18" Class="text-danger" />
                <span>Bảo mật chuẩn mã hóa hai lớp</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <CinemaIcon Name="CinemaIconName.Clock" Size="18" Class="text-danger" />
                <span>Liên kết xác minh có hiệu lực trong 15 phút</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <CinemaIcon Name="CinemaIconName.BookmarkCheck" Size="18" Class="text-danger" />
                <span>Giữ nguyên toàn bộ lịch sử xem và tủ phim VIP</span>
            </div>
        </div>
    </section>

    <section class="auth-panel" aria-labelledby="forgot-title">
        <div class="auth-panel-header">
            <a class="auth-back-link" href="/login">
                <CinemaIcon Name="CinemaIconName.ArrowLeft" Size="16" />
                <span>Trở lại đăng nhập</span>
            </a>
            <h2 id="forgot-title">Quên mật khẩu?</h2>
            <p>Nhập địa chỉ email đã đăng ký. Chúng tôi sẽ gửi hướng dẫn khôi phục tài khoản cho bạn.</p>
        </div>

        @if (sent && success)
        {
            <div class="auth-success-card" role="status">
                <div class="auth-success-icon">
                    <CinemaIcon Name="CinemaIconName.Mail" Size="32" />
                </div>
                <h3>Kiểm tra hộp thư của bạn</h3>
                <p>
                    CinemaFlow đã gửi liên kết đặt lại mật khẩu đến <strong>@model.Email</strong>. Hãy kiểm tra hộp thư đến (và thư mục Spam nếu cần).
                </p>
                <div class="auth-success-actions">
                    <a href="/login" class="button primary wide">
                        <CinemaIcon Name="CinemaIconName.Login" Size="16" />
                        <span>Về trang đăng nhập</span>
                    </a>
                    <button type="button" class="button secondary wide" @onclick="ResetForm">
                        Gửi lại tới email khác
                    </button>
                </div>
            </div>
        }
        else
        {
            <EditForm Model="model" OnValidSubmit="Submit">
                <DataAnnotationsValidator />
                
                <div class="form-field">
                    <label for="forgot-email">Địa chỉ Email</label>
                    <div class="input-with-icon">
                        <InputText id="forgot-email" 
                                   type="email" 
                                   autocomplete="email" 
                                   @bind-Value="model.Email" 
                                   placeholder="name@example.com"
                                   autofocus />
                    </div>
                    <ValidationMessage For="() => model.Email" />
                </div>

                @if (sent && !success && !string.IsNullOrWhiteSpace(message))
                {
                    <div class="form-alert error" role="alert">
                        <CinemaIcon Name="CinemaIconName.AlertCircle" Size="16" />
                        <span>@message</span>
                    </div>
                }

                <button class="button primary wide btn-auth-submit" type="submit" disabled="@submitting">
                    <CinemaIcon Name="CinemaIconName.Mail" Size="18" />
                    <span>@(submitting ? "Đang gửi hướng dẫn..." : "Gửi liên kết khôi phục")</span>
                </button>
            </EditForm>
        }
    </section>
</main>

@code {
    private readonly ForgotPasswordRequest model = new();
    private bool submitting;
    private bool sent;
    private bool success;
    private string? message;

    private async Task Submit()
    {
        if (submitting) return;
        submitting = true;
        try
        {
            var response = await Api.ForgotPasswordAsync(model);
            success = response?.Success == true;
            message = response?.Message ?? "Chưa thể gửi yêu cầu lúc này. Vui lòng thử lại sau.";
            sent = true;
        }
        catch (Exception)
        {
            success = false;
            message = "Có lỗi kết nối máy chủ. Vui lòng thử lại.";
        }
        finally
        {
            submitting = false;
        }
    }

    private void ResetForm()
    {
        sent = false;
        success = false;
        message = null;
    }
}
