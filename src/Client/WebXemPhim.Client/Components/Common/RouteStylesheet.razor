@using Microsoft.AspNetCore.Components.Web
@*
    Route stylesheets:
    To avoid dynamic DOM churn (<link> elements being mounted and unmounted in <body> on every
    client-side SPA navigation, causing layout reflow and full CSSOM style recalculation),
    core stylesheets are already loaded in App.razor and AdminLayout.razor.
    Any non-globally preloaded stylesheet passed to this component is injected into <HeadContent>.
*@

@foreach (var href in ResolveDynamicSheets())
{
    <HeadContent>
        <link rel="stylesheet" href="@href" data-route-stylesheet="true" />
    </HeadContent>
}

@code {
    /// <summary>Static asset paths relative to wwwroot, e.g. "css/home-expanded.css".</summary>
    [Parameter] public string[]? Files { get; set; }

    private static readonly HashSet<string> PreloadedGlobalSheets = new(StringComparer.OrdinalIgnoreCase)
    {
        "css/home-expanded.css",
        "css/discovery-filters.css",
        "css/genres-page.css",
        "css/account-overview.css",
        "css/profile-settings.css",
        "css/library-membership.css",
        "css/watch-workspace.css",
        "css/admin-workspace.css",
        "css/cinema-theme.css",
        "css/redesign-2026.css",
        "css/light-theme.css",
        "css/mobile-ui-fixes.css",
        "css/popup-polish.css",
        "css/typography-polish.css",
        "css/related-movies.css"
    };

    private string[] ResolveDynamicSheets()
    {
        if (Files is null || Files.Length == 0) return [];

        return Files
            .Where(file => !PreloadedGlobalSheets.Contains(file))
            .Select(file => "/" + file.TrimStart('/'))
            .ToArray();
    }
}
