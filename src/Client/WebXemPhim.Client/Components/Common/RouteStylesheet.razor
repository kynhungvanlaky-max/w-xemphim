@using Microsoft.AspNetCore.Components.Web
@*
    Injects route/component specific stylesheets into the current page.

    The links are rendered as part of the page markup on purpose: Blazor then adds them when
    the page is displayed and removes them again when the visitor navigates away. Using
    <HeadContent> instead would keep every route sheet of every visited page in the document
    head, so the sheets of different pages would pile up and override each other.

    The sheet of the route is preloaded on intent (hover/focus of a link) by
    js/route-style-preload.js, so the browser already has it cached when the navigation
    happens and the page is never painted unstyled.
*@

@foreach (var href in ResolveAll())
{
    <link rel="stylesheet" href="@href" data-route-stylesheet="true" />
}

@code {
    /// <summary>Static asset paths relative to wwwroot, e.g. "css/home-expanded.css".</summary>
    [Parameter] public string[]? Files { get; set; }

    private string[] ResolveAll()
    {
        if (Files is null || Files.Length == 0) return [];

        return Files.Select(file => file switch
        {
            "css/home-expanded.css" => @Assets["css/home-expanded.css"],
            "css/discovery-filters.css" => @Assets["css/discovery-filters.css"],
            "css/genres-page.css" => @Assets["css/genres-page.css"],
            "css/account-overview.css" => @Assets["css/account-overview.css"],
            "css/profile-settings.css" => @Assets["css/profile-settings.css"],
            "css/library-membership.css" => @Assets["css/library-membership.css"],
            "css/watch-workspace.css" => @Assets["css/watch-workspace.css"],
            "css/admin-workspace.css" => @Assets["css/admin-workspace.css"],
            _ => "/" + file.TrimStart('/')
        }).ToArray();
    }
}
