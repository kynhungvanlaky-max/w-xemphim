@using WebXemPhim.Shared.Models
@using WebXemPhim.Client.Components.Icons
@inject IJSRuntime JS
@inject ILogger<CinemaPlayer> Logger
@implements IAsyncDisposable

<div class="player-container" @ref="containerRef" tabindex="0">
    <!-- Ambient Backlight: Ánh sáng hào quang rạp chiếu tương phản -->

    <div class="player-video-wrapper">
        <video @ref="videoRef"
               class="player-video"
               autoplay="@AutoPlay"
               src="@(IsHls(ActiveStreamUrl) ? null : ActiveStreamUrl)"
               @onended="OnEnded"
               @onpause="HandleVideoPause"
               @onerror="() => mediaFailed = true"
               @onloadedmetadata="MetadataLoaded"
               aria-label="@CurrentEpisodeTitle"
               poster="@PosterUrl"
               playsinline
               preload="metadata">
            Trình duyệt của bạn không hỗ trợ phát video HTML5.
        </video>

        @if (!string.IsNullOrWhiteSpace(UserEmail))
        {
            @* Watermark vẽ trên canvas: xoá bằng DevTools không đủ vì phải tìm đúng phần tử
               canvas và dừng cả vòng vẽ lại. Bản text trong DOM trước đây chỉ cần xoá 1 dòng
               là mất hoàn toàn. *@
            <canvas class="cp-watermark-canvas"
                    @ref="watermarkCanvasRef"
                    data-watermark="@WatermarkText"
                    data-watermark-zone="@currentPositionIndex"
                    aria-hidden="true"></canvas>
        }

        <!-- Simple Cinema Buffering Spinner -->
        @* aria-hidden do JS bật/tắt theo trạng thái đệm: spinner chỉ được đọc khi video thực sự
           đang tải, không phải lúc ẩn. *@
        <div class="cp-buffering-spinner" aria-label="Đang tải video" role="status" aria-hidden="true">
            <div class="cp-spinner-ring"></div>
        </div>

        <!-- Center Action Indicators (Play, Pause, Rewind 10s, Forward 10s) -->
        <div class="cp-center-pulse" aria-hidden="true">
            <div class="cp-pulse-action cp-action-play">
                <div class="cp-center-badge">
                    <svg class="pulse-svg pulse-icon-play" viewBox="0 0 24 24" width="30" height="30" fill="currentColor">
                        <path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86a1 1 0 0 0-1.5.86z" />
                    </svg>
                </div>
            </div>
            <div class="cp-pulse-action cp-action-pause">
                <div class="cp-center-badge">
                    <svg class="pulse-svg pulse-icon-pause" viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                        <rect x="5.5" y="4" width="4.5" height="16" rx="1.5" />
                        <rect x="14" y="4" width="4.5" height="16" rx="1.5" />
                    </svg>
                </div>
            </div>
            <div class="cp-pulse-action cp-action-rewind">
                <div class="cp-pill-badge">
                    <svg class="pulse-svg pulse-icon-rewind" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 4v6h6" />
                        <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" />
                    </svg>
                    <span class="cp-seek-tag">-10s</span>
                </div>
            </div>
            <div class="cp-pulse-action cp-action-forward">
                <div class="cp-pill-badge">
                    <span class="cp-seek-tag">+10s</span>
                    <svg class="pulse-svg pulse-icon-forward" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M23 4v6h-6" />
                        <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Custom Cinema Controls Bar -->
        <div class="cinema-controls" aria-label="Bảng điều khiển video">
            <!-- Progress scrubber bar -->
            <div class="cp-progress-container">
                <div class="cp-progress-track" role="slider" tabindex="0" aria-label="Vị trí phát" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                    <div class="cp-progress-buffered"></div>
                    <div class="cp-progress-played"></div>
                    <div class="cp-progress-handle"></div>
                    <div class="cp-progress-tooltip">00:00</div>
                </div>
            </div>

            <!-- Bottom Toolbar Controls -->
            <div class="cp-toolbar">
                <div class="cp-toolbar-left">
                    <!-- Play / Pause Button -->
                    <button type="button" class="cp-control-btn cp-play-btn" title="Phát (Phím cách)" aria-label="Phát (Phím cách)" aria-pressed="false">
                        <svg class="cp-play-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                            <path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86a1 1 0 0 0-1.5.86z" />
                        </svg>
                        <svg class="cp-pause-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" style="display: none;">
                            <rect x="5.5" y="4" width="4.5" height="16" rx="2" />
                            <rect x="14" y="4" width="4.5" height="16" rx="2" />
                        </svg>
                    </button>

                    <!-- Tua lùi 10s -->
                    <button type="button" class="cp-control-btn cp-rewind-btn" title="Lùi 10 giây (←)" aria-label="Lùi 10 giây (←)">
                        <CinemaIcon Name="CinemaIconName.Rewind10" Size="19" />
                    </button>

                    <!-- Tua tới 10s -->
                    <button type="button" class="cp-control-btn cp-forward-btn" title="Tới 10 giây (→)" aria-label="Tới 10 giây (→)">
                        <CinemaIcon Name="CinemaIconName.Forward10" Size="19" />
                    </button>

                    <!-- Âm lượng -->
                    <div class="cp-volume-group">
                        <button type="button" class="cp-control-btn cp-volume-btn" title="Tắt tiếng (M)" aria-label="Tắt tiếng (M)" aria-pressed="false">
                            <CinemaIcon Name="CinemaIconName.Volume" Size="18" Class="cp-vol-icon" />
                            <CinemaIcon Name="CinemaIconName.VolumeMute" Size="18" Class="cp-mute-icon" style="display: none;" />
                        </button>
                        <input type="range" class="cp-volume-slider" min="0" max="1" step="0.05" value="1" title="Âm lượng" aria-label="Âm lượng" />
                    </div>

                    <!-- Thời gian phát -->
                    <div class="cp-time-display">00:00 / 00:00</div>
                </div>

                <div class="cp-toolbar-right">
                    <!-- Đổi chất lượng video ngay trong trình phát -->
                    <div class="cp-quality-selector @(isQualityMenuOpen ? "open" : "")" @onkeydown="HandleQualityMenuKeyDown">
                        <button type="button"
                                @ref="qualityTriggerRef"
                                class="cp-quality-btn"
                                title="Đổi chất lượng video (Hiện tại: @DisplayQualityLabel)"
                                aria-label="Đổi chất lượng video"
                                aria-haspopup="true"
                                aria-expanded="@(isQualityMenuOpen ? "true" : "false")"
                                @onclick="ToggleQualityMenu"
                                @onclick:stopPropagation="true">
                            <span class="cp-q-chip">@DisplayQualityBadge</span>
                            <span class="cp-q-text">@DisplayQualityLabel</span>
                            <svg class="cp-q-arrow @(isQualityMenuOpen ? "rotated" : "")" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                <path d="m6 9 6 6 6-6" />
                            </svg>
                        </button>

                        @if (isQualityMenuOpen)
                        {
                            @* Lớp phủ trong suốt: bấm ra ngoài menu sẽ đóng menu, thay vì
                               phải bấm lại nút. *@
                            <div class="cp-quality-backdrop" @onclick="() => CloseQualityMenuAsync(false)"></div>
                            <div class="cp-quality-dropdown" @onclick:stopPropagation="true" role="menu" aria-label="Danh sách chất lượng">
                                <div class="cp-qd-header" role="presentation">
                                    <CinemaIcon Name="CinemaIconName.Settings" Size="13" />
                                    <span>Chọn chất lượng</span>
                                </div>
                                <div class="cp-qd-options">
                                    @if (isHlsActive && hlsLevels.Count > 0)
                                    {
                                        var isAutoSelected = currentHlsLevel == -1;
                                        <button type="button" 
                                                class="cp-qd-option @(isAutoSelected ? "selected" : "")"
                                                role="menuitem"
                                                @onclick="() => ChooseHlsQuality(-1)">
                                            <span class="cp-qd-badge res-auto">AUTO</span>
                                            <span class="cp-qd-name">Tự động (Auto ABR)</span>
                                            @if (isAutoSelected)
                                            {
                                                <CinemaIcon Name="CinemaIconName.Check" Size="13" Class="cp-qd-check" />
                                            }
                                        </button>

                                        @foreach (var lvl in hlsLevels)
                                        {
                                            var isSelected = currentHlsLevel == lvl.Index;
                                            var name = !string.IsNullOrWhiteSpace(lvl.Name) ? lvl.Name : $"{lvl.Height}p";
                                            var badge = GetShortBadge(name);
                                            <button type="button" 
                                                    class="cp-qd-option @(isSelected ? "selected" : "")"
                                                    role="menuitem"
                                                    @onclick="() => ChooseHlsQuality(lvl.Index)">
                                                <span class="cp-qd-badge res-@badge.ToLowerInvariant()">@badge</span>
                                                <span class="cp-qd-name">@name</span>
                                                @if (isSelected)
                                                {
                                                    <CinemaIcon Name="CinemaIconName.Check" Size="13" Class="cp-qd-check" />
                                                }
                                            </button>
                                        }
                                    }
                                    else if (AvailableQualities != null && AvailableQualities.Count > 0)
                                    {
                                        @foreach (var q in AvailableQualities)
                                        {
                                            var isSelected = string.Equals(q, QualityLabel, StringComparison.OrdinalIgnoreCase);
                                            var badge = GetShortBadge(q);
                                            <button type="button" 
                                                    class="cp-qd-option @(isSelected ? "selected" : "")"
                                                    role="menuitem"
                                                    @onclick="() => ChooseQuality(q)">
                                                <span class="cp-qd-badge res-@badge.ToLowerInvariant()">@badge</span>
                                                <span class="cp-qd-name">@q</span>
                                                @if (isSelected)
                                                {
                                                    <CinemaIcon Name="CinemaIconName.Check" Size="13" Class="cp-qd-check" />
                                                }
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Picture in Picture -->
                    <button type="button" class="cp-control-btn cp-pip-btn" title="Thu nhỏ hình trong hình (PiP)" aria-label="Thu nhỏ hình trong hình (PiP)" aria-pressed="false">
                        <CinemaIcon Name="CinemaIconName.Eye" Size="18" />
                    </button>

                    <!-- Toàn màn hình -->
                    <button type="button" class="cp-control-btn cp-fullscreen-btn" title="Toàn màn hình (F)" aria-label="Toàn màn hình (F)" aria-pressed="false">
                        <CinemaIcon Name="CinemaIconName.Maximize" Size="18" />
                    </button>
                </div>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(playerNotice))
        {
            <div class="cp-player-notice" role="status" aria-live="polite">@playerNotice</div>
        }
        @if (mediaFailed)
        {
            <div class="cp-error" role="alert">
                <strong>Không thể phát video</strong>
                <span>@MediaErrorMessage</span>
                @if (!string.IsNullOrWhiteSpace(mediaErrorDetails))
                {
                    <small class="cp-error-detail">Mã lỗi: @mediaErrorDetails</small>
                }
                <div class="cp-error-actions">
                    <button type="button" @onclick="Retry">Thử lại</button>
                    @if (HasAlternativeSource)
                    {
                        <button type="button" class="cp-error-alt" @onclick="PlayAlternativeSource">Dùng nguồn khác</button>
                    }
                </div>
            </div>
        }
    </div>
</div>

<EpisodeDrawer IsOpen="isDrawerOpen"
               IsOpenChanged="val => isDrawerOpen = val"
               Episodes="Episodes"
               CurrentEpisodeNumber="CurrentEpisodeNumber"
               OnSelectEpisode="HandleEpisodeSelect" />

@code {
    [Parameter]
    public string? UserEmail { get; set; }

    [Parameter]
    public string ActiveStreamUrl { get; set; } = string.Empty;

    [Parameter]
    public string PosterUrl { get; set; } = string.Empty;

    [Parameter]
    public string CurrentEpisodeTitle { get; set; } = "Tập 1";
    [Parameter] public string QualityLabel { get; set; } = string.Empty;
    [Parameter] public EventCallback OnEnded { get; set; }
    [Parameter] public bool AutoPlay { get; set; }
    [Parameter] public double ResumeSeconds { get; set; }

    [Parameter]
    public int CurrentEpisodeNumber { get; set; } = 1;

    [Parameter]
    public List<StreamSourceDto>? Streams { get; set; }

    [Parameter]
    public List<EpisodeDto>? Episodes { get; set; }

    [Parameter]
    public EventCallback<EpisodeDto> OnEpisodeChanged { get; set; }

    [Parameter]
    public IReadOnlyList<string>? AvailableQualities { get; set; }

    [Parameter] public EventCallback<string> OnQualityChanged { get; set; }
    [Parameter] public EventCallback<double> OnPause { get; set; }
    [Parameter] public EventCallback<double> OnProgress { get; set; }

    private ElementReference containerRef;
    private ElementReference videoRef;
    private ElementReference qualityTriggerRef;
    private ElementReference watermarkCanvasRef;
    private DotNetObjectReference<CinemaPlayer>? dotNetRef;
    private bool isDrawerOpen = false;
    private bool mediaFailed;
    private string? mediaErrorDetails;
    private string? playerNotice;
    private bool isQualityMenuOpen;
    private bool isHlsActive;
    private List<HlsQualityLevelDto> hlsLevels = [];
    private int currentHlsLevel = -1;
    private string? previousStreamUrl;
    private bool isJsInitialized;

    /// <summary>
    /// Watermark chống chia sẻ được vẽ trên canvas bởi JS. Phía .NET chỉ giữ vị trí an toàn
    /// (6 vùng) và mốc thời gian, rồi đẩy xuống qua thuộc tính <c>data-watermark</c> —
    /// như vậy không phải re-render toàn bộ trình phát chỉ để đổi chữ watermark.
    /// </summary>
    private string currentPositionClass = "wm-pos-0";
    private string currentTimestamp = string.Empty;
    private PeriodicTimer? watermarkTimer;
    private CancellationTokenSource? watermarkCts;
    private int currentPositionIndex;

    protected override void OnInitialized()
    {
        UpdateWatermarkTimestamp();
        watermarkCts = new CancellationTokenSource();
        watermarkTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        _ = RunWatermarkLoopAsync(watermarkCts.Token);
    }

    private void UpdateWatermarkTimestamp()
    {
        currentTimestamp = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm");
    }

    public void AdvanceWatermarkPositionForTesting()
    {
        currentPositionIndex = (currentPositionIndex + 1) % 6;
        currentPositionClass = $"wm-pos-{currentPositionIndex}";
        UpdateWatermarkTimestamp();
        SafeStateHasChanged();
    }

    private async Task RunWatermarkLoopAsync(CancellationToken cancellationToken)
    {
        if (watermarkTimer is null) return;
        try
        {
            while (await watermarkTimer.WaitForNextTickAsync(cancellationToken))
            {
                AdvanceWatermarkPositionForTesting();
            }
        }
        catch (OperationCanceledException)
        {
            // Expected during component disposal
        }
        catch (ObjectDisposedException)
        {
            // The timer was disposed while the loop was waiting for the next tick.
        }
    }

    /// <summary>
    /// Nội dung watermark: email đã che bớt kèm mã phiên ngắn. Che bớt email vì nếu hiện
    /// đầy đủ thì PII bị đóng khung vào video và thu được khi người xem quay màn hình.
    /// </summary>
    private string WatermarkText
    {
        get
        {
            if (string.IsNullOrWhiteSpace(UserEmail)) return string.Empty;
            return $"{MaskEmail(UserEmail)} · {currentTimestamp}";
        }
    }

    private string SessionCode
    {
        get
        {
            if (string.IsNullOrWhiteSpace(UserEmail)) return "0000";
            var hash = System.Security.Cryptography.SHA256.HashData(
                System.Text.Encoding.UTF8.GetBytes(UserEmail.Trim().ToLowerInvariant()));
            return Convert.ToHexString(hash)[..4].ToLowerInvariant();
        }
    }

    private static string MaskEmail(string email)
    {
        var at = email.IndexOf('@');
        if (at <= 0) return "***";
        var name = email[..at];
        var domain = email[(at + 1)..];
        var visible = name.Length > 1 ? name[..1] : name;
        return $"{visible}***@{domain}";
    }

    public static bool IsHls(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return false;
        var clean = url.Split('?')[0].Split('#')[0];
        return clean.EndsWith(".m3u8", StringComparison.OrdinalIgnoreCase) || clean.Contains(".m3u8", StringComparison.OrdinalIgnoreCase);
    }

    private string DisplayQualityLabel
    {
        get
        {
            if (isHlsActive && hlsLevels.Count > 0)
            {
                if (currentHlsLevel < 0 || currentHlsLevel >= hlsLevels.Count) return "Tự động (Auto ABR)";
                var lvl = hlsLevels[currentHlsLevel];
                return !string.IsNullOrWhiteSpace(lvl.Name) ? lvl.Name : $"{lvl.Height}p";
            }
            return !string.IsNullOrWhiteSpace(QualityLabel) ? QualityLabel : "Tự động";
        }
    }

    private string DisplayQualityBadge
    {
        get
        {
            if (isHlsActive && hlsLevels.Count > 0)
            {
                if (currentHlsLevel < 0 || currentHlsLevel >= hlsLevels.Count) return "AUTO";
                var lvl = hlsLevels[currentHlsLevel];
                return GetShortBadge(!string.IsNullOrWhiteSpace(lvl.Name) ? lvl.Name : $"{lvl.Height}p");
            }
            return GetShortBadge(QualityLabel);
        }
    }

    private void ToggleQualityMenu()
    {
        isQualityMenuOpen = !isQualityMenuOpen;
    }

    /// <summary>
    /// Đóng menu chất lượng bằng phím Esc và trả focus về nút đã mở menu — nếu không, người
    /// dùng bàn phím mất ngữ cảnh và các phím tắt của trình phát ngừng hoạt động.
    /// </summary>
    private async Task CloseQualityMenuAsync(bool returnFocus)
    {
        if (!isQualityMenuOpen) return;
        isQualityMenuOpen = false;
        if (returnFocus)
        {
            try
            {
                await qualityTriggerRef.FocusAsync();
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Quality trigger could not be focused.");
            }
        }
    }

    private async Task HandleQualityMenuKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await CloseQualityMenuAsync(returnFocus: true);
        }
    }

    private async Task ChooseQuality(string q)
    {
        await CloseQualityMenuAsync(returnFocus: true);
        if (!string.Equals(q, QualityLabel, StringComparison.OrdinalIgnoreCase))
        {
            await OnQualityChanged.InvokeAsync(q);
        }
    }

    private async Task ChooseHlsQuality(int levelIndex)
    {
        await CloseQualityMenuAsync(returnFocus: true);
        currentHlsLevel = levelIndex;
        try
        {
            await JS.InvokeVoidAsync("CinemaPlayer.setQualityLevel", containerRef, levelIndex);
        }
        catch (Exception ex)
        {
            // Ignored on SSR/disconnected, but a real failure must stay traceable.
            Logger.LogDebug(ex, "Quality level could not be applied in the browser.");
        }
    }

    private static string GetShortBadge(string q)
    {
        if (string.IsNullOrEmpty(q)) return "HD";
        if (q.Contains("AUTO", StringComparison.OrdinalIgnoreCase)) return "AUTO";
        if (q.Contains("4K", StringComparison.OrdinalIgnoreCase)) return "4K";
        if (q.Contains("60fps", StringComparison.OrdinalIgnoreCase)) return "60FPS";
        if (q.Contains("1080p", StringComparison.OrdinalIgnoreCase) || q.Contains("FHD", StringComparison.OrdinalIgnoreCase)) return "FHD";
        if (q.Contains("720p", StringComparison.OrdinalIgnoreCase) || q.Contains("HD", StringComparison.OrdinalIgnoreCase)) return "HD";
        if (q.Contains("480p", StringComparison.OrdinalIgnoreCase)) return "SD";
        return "HD";
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(ActiveStreamUrl) && Streams != null && Streams.Count > 0)
        {
            ActiveStreamUrl = Streams[0].StreamUrl;
        }

        if (isJsInitialized && !string.IsNullOrEmpty(ActiveStreamUrl) && !string.Equals(ActiveStreamUrl, previousStreamUrl, StringComparison.Ordinal))
        {
            previousStreamUrl = ActiveStreamUrl;
            _ = JS.InvokeVoidAsync("CinemaPlayer.loadSource", containerRef, videoRef, ActiveStreamUrl, AutoPlay, ResumeSeconds);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("ensureCinemaPlayerLoaded");
                dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("CinemaPlayer.init", containerRef, videoRef, dotNetRef);
                isJsInitialized = true;
                if (!string.IsNullOrEmpty(ActiveStreamUrl))
                {
                    previousStreamUrl = ActiveStreamUrl;
                    await JS.InvokeVoidAsync("CinemaPlayer.loadSource", containerRef, videoRef, ActiveStreamUrl, AutoPlay, ResumeSeconds);
                }
            }
            catch
            {
                // Fallback for SSR or non-JS environments
            }
        }
    }

    [JSInvokable]
    public void OnHlsManifestParsed(List<HlsQualityLevelDto> levels)
    {
        hlsLevels = levels ?? [];
        isHlsActive = hlsLevels.Count > 0;
        currentHlsLevel = -1;
        SafeStateHasChanged();
    }

    [JSInvokable]
    public void OnHlsLevelSwitched(int levelIndex)
    {
        currentHlsLevel = levelIndex;
        SafeStateHasChanged();
    }

    [JSInvokable]
    public void OnHlsFatalError(string details)
    {
        mediaFailed = true;
        mediaErrorDetails = details;
        SafeStateHasChanged();
    }

    /// <summary>
    /// Được gọi từ JS khi thẻ video báo lỗi tải media. Sự kiện <c>error</c> của thẻ video có
    /// thể xảy ra trước khi circuit Blazor kết nối, nên lỗi phải được báo qua JS interop
    /// thay vì chỉ dựa vào <c>@onerror</c> — nếu không người dùng chỉ thấy màn hình đen.
    /// </summary>
    [JSInvokable]
    public void OnMediaError(string details)
    {
        mediaFailed = true;
        mediaErrorDetails = details;
        SafeStateHasChanged();
    }

    /// <summary>
    /// Được gọi từ JS khi có thông báo ngắn dành cho người xem (ví dụ trình duyệt không hỗ
    /// trợ toàn màn hình). Thông báo tự ẩn sau vài giây.
    /// </summary>
    [JSInvokable]
    public void OnPlayerNotice(string message)
    {
        playerNotice = message;
        SafeStateHasChanged();
        _ = ClearPlayerNoticeAsync();
    }

    private async Task ClearPlayerNoticeAsync()
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(6));
            playerNotice = null;
            SafeStateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Player notice could not be cleared.");
        }
    }

    private void SafeStateHasChanged()
    {
        try
        {
            StateHasChanged();
        }
        catch (InvalidOperationException)
        {
            // Ignore during headless unit testing when component render handle is not attached
        }
    }

    [JSInvokable]
    public async Task OnPlayerPause(double seconds)
    {
        if (OnPause.HasDelegate)
        {
            await OnPause.InvokeAsync(seconds);
        }
    }

    [JSInvokable]
    public async Task OnPlayerProgress(double seconds)
    {
        if (OnProgress.HasDelegate)
        {
            await OnProgress.InvokeAsync(seconds);
        }
    }

    private async Task HandleVideoPause()
    {
        if (OnPause.HasDelegate)
        {
            var cursor = await GetCursorAsync();
            await OnPause.InvokeAsync(cursor.Seconds);
        }
    }

    public async Task PauseAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("CinemaPlayer.pause", videoRef);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone: nothing to pause any more.
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogDebug(ex, "Player pause skipped because the element is not available any more.");
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Player pause failed inside the browser.");
        }
    }

    public async ValueTask DisposeAsync()
    {
        watermarkCts?.Cancel();
        watermarkTimer?.Dispose();
        watermarkCts?.Dispose();
        watermarkTimer = null;
        watermarkCts = null;

        if (JS is not null)
        {
            try { await JS.InvokeVoidAsync("CinemaPlayer.dispose", containerRef); }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone: the browser cleans the player up on its own.
            }
            catch (InvalidOperationException ex)
            {
                Logger.LogDebug(ex, "Player dispose skipped because the element is not available any more.");
            }
            catch (JSException ex)
            {
                Logger.LogWarning(ex, "Player dispose failed inside the browser.");
            }
        }

        dotNetRef?.Dispose();
        dotNetRef = null;
    }

    private async Task Retry()
    {
        mediaFailed = false;
        mediaErrorDetails = null;
        if (IsHls(ActiveStreamUrl))
        {
            await JS.InvokeVoidAsync("CinemaPlayer.loadSource", containerRef, videoRef, ActiveStreamUrl, AutoPlay, ResumeSeconds);
        }
        else
        {
            await JS.InvokeVoidAsync("CinemaPlayer.reload", videoRef);
        }
    }

    /// <summary>Các nguồn phát khác (khác server hoặc khác chất lượng) có thể thử lại.</summary>
    private List<StreamSourceDto> AlternativeSources =>
        (Streams ?? [])
            .Where(source => !string.IsNullOrWhiteSpace(source.StreamUrl)
                && !string.Equals(source.StreamUrl, ActiveStreamUrl, StringComparison.Ordinal))
            .ToList();

    private bool HasAlternativeSource => AlternativeSources.Count > 0;

    /// <summary>Thông điệp lỗi nói rõ nguyên nhân và cách xử lý, không chỉ chung chung.</summary>
    private string MediaErrorMessage
    {
        get
        {
            var details = mediaErrorDetails ?? string.Empty;
            if (details.Contains("4", StringComparison.Ordinal) && details.Contains("MEDIA_ERR", StringComparison.OrdinalIgnoreCase))
                return "Nguồn phát không phản hồi hoặc định dạng video không được trình duyệt hỗ trợ. Hãy thử nguồn khác hoặc báo lỗi.";
            if (details.Contains("3", StringComparison.Ordinal) && details.Contains("MEDIA_ERR", StringComparison.OrdinalIgnoreCase))
                return "Không tải được video do mạng bị gián đoạn. Hãy kiểm tra kết nối rồi thử lại.";
            if (details.Contains("2", StringComparison.Ordinal) && details.Contains("MEDIA_ERR", StringComparison.OrdinalIgnoreCase))
                return "Tải video bị lỗi mạng. Thử lại hoặc chuyển sang nguồn phát khác.";
            if (details.Contains("4", StringComparison.Ordinal) && details.Contains("MEDIA_ERR", StringComparison.OrdinalIgnoreCase))
                return "Định dạng video không được hỗ trợ. Hãy chọn chất lượng khác.";
            return HasAlternativeSource
                ? "Không phát được nguồn này. Bạn có thể thử lại hoặc dùng một nguồn phát khác."
                : "Không phát được nguồn này. Hãy thử lại, kiểm tra kết nối mạng hoặc báo lỗi cho quản trị viên.";
        }
    }

    /// <summary>Chuyển sang nguồn phát kế tiếp rồi phát lại.</summary>
    private async Task PlayAlternativeSource()
    {
        var alternative = AlternativeSources.FirstOrDefault();
        if (alternative is null) return;

        mediaFailed = false;
        mediaErrorDetails = null;
        ActiveStreamUrl = alternative.StreamUrl;
        previousStreamUrl = ActiveStreamUrl;

        await JS.InvokeVoidAsync("CinemaPlayer.loadSource", containerRef, videoRef, ActiveStreamUrl, true, 0);
        if (OnQualityChanged.HasDelegate)
        {
            await OnQualityChanged.InvokeAsync(alternative.Quality);
        }
    }

    private async Task MetadataLoaded()
    {
        mediaFailed = false;
        if (ResumeSeconds > 0) await JS.InvokeVoidAsync("CinemaPlayer.seekTo", videoRef, ResumeSeconds);
    }

    public async Task<MediaCursor> GetCursorAsync()
    {
        try { return await JS.InvokeAsync<MediaCursor>("CinemaPlayer.cursor", videoRef); }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Media cursor is not available in the browser.");
            return new();
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogDebug(ex, "Media cursor skipped because the video element is not available.");
            return new();
        }
    }

    public void OpenDrawer() => isDrawerOpen = true;

    private async Task HandleEpisodeSelect(EpisodeDto ep)
    {
        CurrentEpisodeNumber = ep.EpisodeNumber;
        CurrentEpisodeTitle = ep.Title;
        if (ep.Streams.Count > 0)
        {
            ActiveStreamUrl = ep.Streams[0].StreamUrl;
            Streams = ep.Streams;
        }
        await OnEpisodeChanged.InvokeAsync(ep);
    }
}
