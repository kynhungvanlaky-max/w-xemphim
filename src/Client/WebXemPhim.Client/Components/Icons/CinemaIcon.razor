@namespace WebXemPhim.Client.Components.Icons

<svg class="@CssClass"
     width="@Size"
     height="@Size"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="@StrokeWidth"
     stroke-linecap="round"
     stroke-linejoin="round"
     role="@(HasAccessibleName ? "img" : null)"
     aria-hidden="@(HasAccessibleName ? null : "true")"
     focusable="false"
     @attributes="AdditionalAttributes">
    @if (HasAccessibleName)
    {
        <title>@Title</title>
    }

    @switch (Name)
    {
        case CinemaIconName.ArrowLeft:
            <path d="M5 12h14" />
            <path d="M5 12l6 6" />
            <path d="M5 12l6 -6" />
            break;
        case CinemaIconName.ArrowRight:
            <path d="M5 12h14" />
            <path d="M13 18l6 -6" />
            <path d="M13 6l6 6" />
            break;
        case CinemaIconName.Bookmark:
            <path d="M6 5a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v16l-6 -4l-6 4z" />
            break;
        case CinemaIconName.BookmarkCheck:
            <path d="M6 5a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v16l-6 -4l-6 4z" />
            <path d="M9 10l2 2l4 -4" />
            break;
        case CinemaIconName.BookmarkPlus:
            <path d="M6 5a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v16l-6 -4l-6 4z" />
            <path d="M12 7v6" />
            <path d="M9 10h6" />
            break;
        case CinemaIconName.Check:
            <path d="M5 12l5 5l10 -10" />
            break;
        case CinemaIconName.ChevronLeft:
            <path d="M15 6l-6 6l6 6" />
            break;
        case CinemaIconName.ChevronRight:
            <path d="M9 6l6 6l-6 6" />
            break;
        case CinemaIconName.Close:
            <path d="M18 6l-12 12" />
            <path d="M6 6l12 12" />
            break;
        case CinemaIconName.Crown:
            <path d="M5 16l-2 -10l5.5 4l3.5 -5l3.5 5l5.5 -4l-2 10z" />
            <path d="M5 20h14" />
            break;
        case CinemaIconName.Film:
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="M7 5v14" />
            <path d="M17 5v14" />
            <path d="M3 9h4" />
            <path d="M3 15h4" />
            <path d="M17 9h4" />
            <path d="M17 15h4" />
            break;
        case CinemaIconName.Home:
            <path d="M3 12l9 -9l9 9" />
            <path d="M5 10v10h14v-10" />
            <path d="M9 20v-6h6v6" />
            break;
        case CinemaIconName.Key:
            <circle cx="8" cy="15" r="4" />
            <path d="M10.8 12.2l8.2 -8.2" />
            <path d="M15 8l3 3" />
            <path d="M17 6l2 2" />
            break;
        case CinemaIconName.List:
            <path d="M9 6h11" />
            <path d="M9 12h11" />
            <path d="M9 18h11" />
            <path d="M5 6v.01" />
            <path d="M5 12v.01" />
            <path d="M5 18v.01" />
            break;
        case CinemaIconName.Login:
            <path d="M14 8l4 4l-4 4" />
            <path d="M18 12h-13" />
            <path d="M5 4v16" />
            break;
        case CinemaIconName.Logout:
            <path d="M10 8l-4 4l4 4" />
            <path d="M6 12h13" />
            <path d="M19 4v16" />
            break;
        case CinemaIconName.Mail:
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="M3 7l9 6l9 -6" />
            break;
        case CinemaIconName.Menu:
            <path d="M4 6h16" />
            <path d="M4 12h16" />
            <path d="M4 18h16" />
            break;
        case CinemaIconName.Play:
            @if (Filled)
            {
                <path fill="currentColor" stroke="none" d="M7 4v16l13 -8z" />
            }
            else
            {
                <polygon points="5 3 19 12 5 21 5 3" />
            }
            break;
        case CinemaIconName.Plus:
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
            break;
        case CinemaIconName.Refresh:
            <path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -5v5h5" />
            <path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 5v-5h-5" />
            break;
        case CinemaIconName.Search:
            <circle cx="11" cy="11" r="8" />
            <path d="M21 21l-4.35 -4.35" />
            break;
        case CinemaIconName.Star:
            @if (Filled)
            {
                <path fill="currentColor" stroke="none" d="M12 3l2.75 5.57l6.15 .9l-4.45 4.33l1.05 6.12l-5.5 -2.89l-5.5 2.89l1.05 -6.12l-4.45 -4.33l6.15 -.9z" />
            }
            else
            {
                <path d="M12 3l2.75 5.57l6.15 .9l-4.45 4.33l1.05 6.12l-5.5 -2.89l-5.5 2.89l1.05 -6.12l-4.45 -4.33l6.15 -.9z" />
            }
            break;
        case CinemaIconName.Trash:
            <path d="M4 7h16" />
            <path d="M10 11v6" />
            <path d="M14 11v6" />
            <path d="M5 7l1 14h12l1 -14" />
            <path d="M9 7v-3h6v3" />
            break;
        case CinemaIconName.User:
            @if (Filled)
            {
                <circle cx="12" cy="7" r="4" fill="currentColor" stroke="none" />
                <path d="M5.5 21a6.5 6.5 0 0 1 13 0" fill="currentColor" stroke="none" />
            }
            else
            {
                <circle cx="12" cy="7" r="4" />
                <path d="M5.5 21a6.5 6.5 0 0 1 13 0" />
            }
            break;
        case CinemaIconName.UserPlus:
            <circle cx="10" cy="7" r="4" />
            <path d="M3.5 21a6.5 6.5 0 0 1 13 0" />
            <path d="M19 8v6" />
            <path d="M16 11h6" />
            break;
        case CinemaIconName.Dashboard:
            <rect x="4" y="4" width="6" height="6" rx="1" />
            <rect x="14" y="4" width="6" height="6" rx="1" />
            <rect x="4" y="14" width="6" height="6" rx="1" />
            <rect x="14" y="14" width="6" height="6" rx="1" />
            break;
        case CinemaIconName.Edit:
            <path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1" />
            <path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z" />
            <path d="M16 5l3 3" />
            break;
        case CinemaIconName.Eye:
            <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
            <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" />
            break;
        case CinemaIconName.Shield:
            <path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3" />
            break;
        case CinemaIconName.Bell:
            <path d="M10 5a2 2 0 0 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3h-16a4 4 0 0 0 2 -3v-3a7 7 0 0 1 4 -6" />
            <path d="M9 17v1a3 3 0 0 0 6 0v-1" />
            break;
        case CinemaIconName.Flame:
            <path d="M12 12c2 -2.96 0 -7 -1 -8c0 3.038 -1.773 4.741 -3 6c-1.226 1.26 -2 3.24 -2 5a6 6 0 1 0 12 0c0 -1.532 -.632 -3.4 -1.5 -4.5c-1.5 2 -2.5 3.5 -4.5 1.5z" />
            break;
        case CinemaIconName.TrendingUp:
            <path d="M3 17l6 -6l4 4l8 -8" />
            <path d="M14 7h7v7" />
            break;
        case CinemaIconName.Compass:
            <circle cx="12" cy="12" r="9" />
            <path d="M16.24 7.76l-2.12 6.36l-6.36 2.12l2.12 -6.36z" />
            break;
        case CinemaIconName.Clock:
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 3" />
            break;
        case CinemaIconName.Sparkles:
            <path d="M12 3l1.5 4.5l4.5 1.5l-4.5 1.5l-1.5 4.5l-1.5 -4.5l-4.5 -1.5l4.5 -1.5z" />
            <path d="M19 16l1 2l2 1l-2 1l-1 2l-1 -2l-2 -1l2 -1z" />
            break;
        case CinemaIconName.Smile:
            <circle cx="12" cy="12" r="9" />
            <path d="M9 10h.01" />
            <path d="M15 10h.01" />
            <path d="M9.5 15a3.5 3.5 0 0 0 5 0" />
            break;
        case CinemaIconName.MessageSquare:
            <path d="M21 15a2 2 0 0 1 -2 2h-11l-4 4v-16a2 2 0 0 1 2 -2h13a2 2 0 0 1 2 2z" />
            break;
        case CinemaIconName.ArrowUp:
            <path d="M12 19v-14" />
            <path d="M5 12l7 -7l7 7" />
            break;
        case CinemaIconName.Filter:
            <path d="M4 4h16v2.172a2 2 0 0 1 -.586 1.414l-4.828 4.828a2 2 0 0 0 -.586 1.414v4.172l-4 2v-6.172a2 2 0 0 0 -.586 -1.414l-4.828 -4.828a2 2 0 0 1 -.586 -1.414z" />
            break;
        case CinemaIconName.Shuffle:
            <path d="M18 4l3 3l-3 3" />
            <path d="M18 20l3 -3l-3 -3" />
            <path d="M3 7h3a5 5 0 0 1 5 5a5 5 0 0 0 5 5h5" />
            <path d="M21 7h-5a4.978 4.978 0 0 0 -3 1m-4 8a4.984 4.984 0 0 1 -3 1h-3" />
            break;
        case CinemaIconName.Pause:
            <rect x="6" y="4" width="4" height="16" rx="1" fill="currentColor" />
            <rect x="14" y="4" width="4" height="16" rx="1" fill="currentColor" />
            break;
        case CinemaIconName.Volume:
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor" />
            <path d="M15.54 8.46a5 5 0 0 1 0 7.07" />
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14" />
            break;
        case CinemaIconName.VolumeMute:
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor" />
            <line x1="23" y1="9" x2="17" y2="15" />
            <line x1="17" y1="9" x2="23" y2="15" />
            break;
        case CinemaIconName.Maximize:
            <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" />
            break;
        case CinemaIconName.Minimize:
            <path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3" />
            break;
        case CinemaIconName.Rewind10:
            <path d="M1 4v6h6" />
            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" />
            @((MarkupString)"<text x=\"12\" y=\"15\" text-anchor=\"middle\" font-size=\"7.2\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"800\" fill=\"currentColor\" stroke=\"none\">10</text>")
            break;
        case CinemaIconName.Forward10:
            <path d="M23 4v6h-6" />
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
            @((MarkupString)"<text x=\"12\" y=\"15\" text-anchor=\"middle\" font-size=\"7.2\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"800\" fill=\"currentColor\" stroke=\"none\">10</text>")
            break;
        case CinemaIconName.ChevronDown:
            <path d="M6 9l6 6l6 -6" />
            break;
        case CinemaIconName.Users:
            <circle cx="9" cy="7" r="4" />
            <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            <path d="M21 21v-2a4 4 0 0 0 -3 -3.85" />
            break;
        case CinemaIconName.Settings:
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
            break;
        case CinemaIconName.Moon:
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            break;
        case CinemaIconName.Sun:
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
            break;
        case CinemaIconName.AlertCircle:
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
            break;
        case CinemaIconName.Grid:
            <rect x="3" y="3" width="7" height="7" rx="1.5" />
            <rect x="14" y="3" width="7" height="7" rx="1.5" />
            <rect x="14" y="14" width="7" height="7" rx="1.5" />
            <rect x="3" y="14" width="7" height="7" rx="1.5" />
            break;
        case CinemaIconName.MoreHorizontal:
            <circle cx="12" cy="12" r="1" />
            <circle cx="19" cy="12" r="1" />
            <circle cx="5" cy="12" r="1" />
            break;
        case CinemaIconName.EyeOff:
            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
            <line x1="1" y1="1" x2="23" y2="23" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public CinemaIconName Name { get; set; }

    [Parameter]
    public int Size { get; set; } = 20;

    [Parameter]
    public double StrokeWidth { get; set; } = 1.75;

    [Parameter]
    public bool Filled { get; set; } = false;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool HasAccessibleName => !string.IsNullOrWhiteSpace(Title);
    private string CssClass => string.IsNullOrWhiteSpace(Class) ? "cinema-icon" : $"cinema-icon {Class}";
}
